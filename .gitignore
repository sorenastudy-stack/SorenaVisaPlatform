# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit real secrets).
# Broad coverage: bare .env, any .env.<suffix> (.local/.txt/.production/…),
# and *.env / *.env.* variants — but KEEP the committed example templates.
.env
.env.*
*.env
*.env.*
!**/.env.example
backend/.env.txt

# Cryptographic keys (NEVER commit — DocuSign JWT grant RSA private
# key, future signing keys, etc.). Files in backend/keys/ are
# operator-managed secrets pasted into a local file by hand.
backend/keys/

# Build outputs
dist/
.next/
out/
build/

# Prisma (migrations must be tracked — Railway runs prisma migrate deploy on start)

# Logs
*.log
npm-debug.log*

# PM2 (dev process manager — local metadata + log dir contents).
# The logs/ directory is kept via .gitkeep so PM2 has a place to
# write; the actual .log files inside are excluded by the *.log
# rule above. .pm2/ is the per-workspace metadata folder PM2
# sometimes creates when PM2_HOME is overridden.
.pm2/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude memory (local only)
.claude/

# User uploads (binary files — tracked via DB, not git). Ignore EVERYTHING
# under backend/uploads/ (admission docs, visa files, LIA licences, staff HR
# contracts, and any future subdir) EXCEPT the .gitkeep that keeps the dir.
backend/uploads/*
!backend/uploads/.gitkeep

# Database backups (NEVER commit)
backup_*.sql
backend/backup_*.sql
backend/backups/

# Local helper / debug scripts (NEVER commit)
backend/check-*.js
backend/reset-*.js

# Test fixtures (local only)
test_*.pdf
test_*.exe
backend/test_*.pdf
backend/test_*.exe

# Scoring engine source materials (NEVER commit — proprietary content,
# only the TypeScript port under backend/src/scorecard/ goes into git)
Sorena_Scoring_Reference/

# TypeScript incremental build cache — covers tsconfig.tsbuildinfo,
# tsconfig.build.tsbuildinfo, and anything similar produced by other
# tsconfig variants (Next.js, prod-build, etc.).
*.tsbuildinfo
**/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Throwaway test harnesses (smoke scripts + their compiled .js/.d.ts/.map
# artifacts). Named _<name>_smoke.ts and run via ts-node; never commit.
_*_smoke.*

# Nightly mirror run logs (scripts/mirror-local-run.sh writes here).
scripts/logs/

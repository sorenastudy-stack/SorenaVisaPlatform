{
  "name": "sorena-visa-backend",
  "version": "1.0.0",
  "description": "Sorena Visa Acquisition Domain Backend",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "prestart:dev": "node scripts/kill-port.js 3001",
    "start:dev": "nest start --watch -b swc",
    "start:dev:tsc": "nest start --watch",
    "start:prod": "node dist/main",
    "kill-backend": "node scripts/kill-port.js 3001",
    "postinstall": "prisma generate",
    "backup:pre-migrate": "node dist/scripts/pre-migrate-backup.js",
    "migrate:deploy": "npm run backup:pre-migrate && prisma migrate deploy",
    "migrate:deploy:no-backup": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "backfill:gate-labels": "ts-node scripts/backfill-gate-labels.ts",
    "seed:test-ticket": "ts-node scripts/seed-test-ticket.ts",
    "test:mail": "ts-node scripts/test-mail.ts",
    "reset:user-password": "ts-node scripts/reset-user-password.ts",
    "seed:study-fields": "ts-node scripts/seed-study-fields.ts",
    "gen:fees": "ts-node scripts/generate-fee-constants.ts",
    "gen:fees:check": "ts-node scripts/generate-fee-constants.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-s3": "^3.1070.0",
    "@aws-sdk/s3-request-presigner": "^3.1070.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.0.0",
    "@types/multer": "^2.1.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "docusign-esign": "^8.7.0",
    "dotenv": "^17.4.1",
    "helmet": "^7.1.0",
    "i18n-iso-countries": "^7.14.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "0.18.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pdfjs-dist": "^3.11.174",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "multer": "$multer",
    "deepmerge-ts": "^8.0.0"
  }
}

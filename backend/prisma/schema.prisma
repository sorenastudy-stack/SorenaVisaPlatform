// ─── LEADS ───────────────────────────────────────────────────────────────────

// Destination country the visitor picked on /start. One assessment serves
// both. Two stable values — a fresh enum (all values created up front, so the
// migration is a guarded CREATE TYPE with no ALTER TYPE ADD VALUE).
enum TargetCountry {
  NEW_ZEALAND
  MALAYSIA
}

model Lead {
  id               String  @id @default(cuid())
  // PR-CLIENT-ID — permanent, human-readable identifier assigned at lead
  // creation. Format {COUNTRY}-{YEAR}-{NNNNNN}, e.g. NZ-2026-000001. The NUMBER
  // is a SINGLE global counter per year (shared across countries), resets to 1
  // on 1 Jan. Additive + separate from `id` — the cuid stays the relational key.
  clientId         String? @unique
  contactId        String
  sourceChannel    String?
  campaignId       String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  firstTouchSource String?
  lastTouchSource  String?

  leadStatus             LeadStatus @default(NEW)
  disqualificationReason String?
  isNurtureCandidate     Boolean    @default(false)

  // PR-NURTURE — post-FREE_15 nurture sequence (7 touches / 21 days) then an
  // ongoing monthly newsletter. Set by the staff "mark not ready" action; driven
  // by the daily cron sweep (NurtureService). `nurtureStage` is the lifecycle
  // anchor; `nurtureUnsubscribedAt` is the master kill-switch checked before
  // every send; `nurtureUnsubToken` is the durable per-lead token in each email's
  // unsubscribe link. `nurtureLastNewsletterAt` paces the monthly cadence.
  nurtureStage            NurtureStage @default(NONE)
  nurtureStartedAt        DateTime?
  nurtureReason           String?
  nurtureUnsubscribedAt   DateTime?
  nurtureUnsubToken       String?      @unique
  nurtureLastNewsletterAt DateTime?
  // PR-CO-KANBAN — CO manual POSTPONE: pause the nurture cron for this lead until
  // this instant (the daily sweep skips held leads). Set with a short mandatory
  // reason via POST /staff/nurture/:leadId/override; both advance + postpone are
  // audited. NULL = not held.
  nurtureHeldUntil        DateTime?
  nurtureHoldReason       String?

  readinessScore        Int?
  academicScore         Int?
  financialScore        Int?
  englishScore          Int?
  intentScore           Int?
  engagementScore       Int?
  scoreBand             ScoreBand?
  riskLevel             RiskLevel?
  riskFlags             String[]
  hardStopFlag          Boolean           @default(false)
  hardStopReason        String?
  liaEscalationRequired Boolean           @default(false)
  executionAllowed      Boolean           @default(false)
  recommendedRoute      RecommendedRoute?
  monetisationModel     String?
  countryConfigId       String?

  aiSummary    String?
  managerNotes String?

  ownerId    String?
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // PR-WIX-1: lead-stage signal captured by the Wix lead-capture
  // webhook. `currentEducationLevel` is free-text per the Wix form.
  // `externalSubmissionId` is the dedupe key (sha256 of email +
  // submittedAt + secret, first 32 chars) — unique so two retries
  // for the same submission can't double-create.
  // `countryRaw` holds the un-resolved country string when the
  // alpha-2 normaliser can't map a free-form name like "Aotearoa".
  // `webhookMetadata` keeps the original page URL / form id so we
  // can debug submissions without log archaeology.
  currentEducationLevel String?
  externalSubmissionId  String? @unique
  countryRaw            String?
  webhookMetadata       Json?

  // PR-SCORECARD-2: marketing attribution. Captured at scorecard
  // submission time from the sv_attribution cookie or query-string
  // fallback (ch/agent/campaign). FIRST attribution wins — once set
  // we never overwrite, so the channel that originally brought the
  // lead in keeps the credit. Both columns nullable so legacy /
  // direct-traffic leads remain valid.
  trackingLinkId    String?
  attributedAgentId String?

  // Country the visitor picked on /start (NEW_ZEALAND | MALAYSIA). One
  // assessment covers both countries; the picker records the choice to
  // sessionStorage (sv_target_country) and it's forwarded with the submit.
  // Nullable — legacy leads, Wix leads, and deep-links straight to the
  // assessment have no picked country.
  targetCountry TargetCountry?

  contact             Contact              @relation(fields: [contactId], references: [id])
  owner               User?                @relation("LeadOwner", fields: [ownerId], references: [id])
  intakeForm          IntakeForm?
  subscriptions       Subscription[]
  consultations       Consultation[]
  cases               Case[]
  // PR-CONTRACT-LEAD (Phase B) — contracts raised lead-based (before a case).
  contracts           Contract[]
  // PR-NURTURE — the lead's nurture call tasks + email/newsletter send ledger.
  nurtureCallTasks    NurtureCallTask[]
  nurtureSent         LeadNurtureSent[]
  events              CrmEvent[]
  managerNotesLogs    ManagerNotesLog[]
  statusHistory       LeadStatusHistory[]
  // Scorecard submissions linked to this Lead. Legacy Leads can have none;
  // returning applicants can complete the assessment multiple times while
  // retaining one canonical CRM Lead and a full attempt history.
  scorecardSubmissions ScorecardSubmission[] @relation("ScorecardLead")

  // PR-SCORECARD-2: attribution relations.
  trackingLink    TrackingLink?   @relation("LeadAttributedLink", fields: [trackingLinkId], references: [id])
  attributedAgent AffiliateAgent? @relation("LeadAttributedAgent", fields: [attributedAgentId], references: [id])

  // PR-SCORECARD-4: Wix payments matched to this lead by email at
  // webhook-receive time. Match is best-effort and informational only —
  // we never auto-update lead status from a payment.
  wixPayments WixPayment[] @relation("WixPaymentLead")

  // PR-LIA-AUTO-ASSIGN: Stripe-webhook-event payments tied to this lead
  // (consultation, ACCOUNT_OPENING, subscription). One row per Stripe
  // paymentIntent.id; written by the /payments/webhook handler with
  // @unique idempotency on stripePaymentIntentId.
  payments Payment[]

  // PR-WEBINAR-1: webinar registrations submitted by the public website
  // (sorenavisa.com), linked to this Lead via Lead.clientId as the shared
  // reference — see WebinarRegistration below.
  webinarRegistrations WebinarRegistration[]

  @@index([contactId])
  @@index([leadStatus])
  @@index([scoreBand])
  @@index([ownerId])
  @@index([attributedAgentId])
  @@index([trackingLinkId])
  @@map("leads")
}

// PR-CLIENT-ID — the atomic, per-year global counter behind Lead.clientId.
// One row per YEAR (not per country); the NUMBER portion is shared across all
// countries and resets when a new year gets its first row. Incremented via an
// atomic `INSERT ... ON CONFLICT (year) DO UPDATE ... RETURNING`, which is
// race-safe under concurrent lead creation (no COUNT(*)).
model ClientIdCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("client_id_counters")
}

model ManagerNotesLog {
  id            String   @id @default(cuid())
  leadId        String
  previousValue String?
  newValue      String?
  changedById   String
  changedAt     DateTime @default(now())

  lead      Lead @relation(fields: [leadId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([leadId])
  @@map("manager_notes_logs")
}

model LeadStatusHistory {
  id          String      @id @default(cuid())
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String
  reason      String?
  isOverride  Boolean     @default(false)
  isUndo      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

// ─── INTAKE FORM ─────────────────────────────────────────────────────────────

model IntakeForm {
  id                     String   @id @default(cuid())
  leadId                 String   @unique
  highestQualification   String?
  fieldOfStudy           String?
  gpa                    Float?
  englishTestType        String?
  englishOverallScore    Float?
  englishComponentScores Json?
  financialLevel         String?
  estimatedBudgetNZD     Float?
  visaHistory            String?
  visaRejectionCount     Int      @default(0)
  visaRejectionReason    String?
  workExperienceYears    Int?
  studyIntent            String?
  preferredStartDate     String?
  preferredCountry       String   @default("NZ")
  preferredLevel         String?
  preferredField         String?
  completionPercent      Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

// ─── SUBSCRIPTIONS ───────────────────────────────────────────────────────────

model Subscription {
  id                       String             @id @default(cuid())
  leadId                   String
  plan                     SubscriptionPlan   @default(FREE)
  stage                    SubscriptionStage  @default(STAGE_1)
  status                   SubscriptionStatus @default(ACTIVE)
  amountPaidNZD            Float?
  currency                 String             @default("NZD")
  stripeSubscriptionId     String?
  stripeCustomerId         String?
  freeResubmissionEligible Boolean            @default(false)
  startDate                DateTime?
  endDate                  DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([status])
  @@map("subscriptions")
}

// ─── CONSULTATIONS ───────────────────────────────────────────────────────────

model Consultation {
  id              String             @id @default(cuid())
  leadId          String
  type            ConsultationType
  assignedToId    String?
  amountNZD       Float
  currency        String             @default("NZD")
  paymentStatus   PaymentStatus      @default(PENDING)
  stripePaymentId String?
  // PR-WALLET slice 3: settlement method, set at confirm. NULL until paid
  // (and for free bookings). CARD via Stripe; WALLET via store credit.
  paidWith        PaymentMethod?
  status          ConsultationStatus @default(PENDING)
  outcomeNotes    String?
  // PR-CONTRACT-GATE (Phase A) — LIA verdict on an LIA-type consultation, used
  // to unlock contract-send for a red-flagged (HS4 / liaEscalationRequired)
  // lead. Reuses the LegalDecision vocabulary (APPROVED / REJECTED /
  // NEEDS_MORE_INFO / WITHDRAWN). All nullable + additive; only set when an LIA
  // records a decision after their session. decidedById is a plain snapshot of
  // the deciding LIA's user id (no FK, mirrors the actor-snapshot pattern).
  decision        LegalDecision?
  decisionNotes   String?
  decidedAt       DateTime?
  decidedById     String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  // PR-BOOKING-1: native in-portal scheduling fields. All nullable so
  // existing rows backfill as NULL with no breakage.
  //   durationMinutes — session length (15/30/45), from the config map.
  //   scheduledEndAt  — denormalised scheduledAt + duration; powers the
  //                     overlap test and the partial-unique double-book
  //                     guard without recomputing on every query.
  //   bookingTimezone — IANA tz shown to the client at booking time
  //                     (for display / confirmation emails).
  //   holdExpiresAt   — optional soft-hold window for PENDING rows; the
  //                     slot engine treats a PENDING row as busy only
  //                     while holdExpiresAt > now.
  durationMinutes Int?
  scheduledEndAt  DateTime?
  bookingTimezone String?
  holdExpiresAt   DateTime?
  // PR-BOOKING-5: per-booking Jitsi meeting URL, generated once at confirm
  // (free + paid). Unguessable room. Presence also acts as the
  // "confirmation finalized" idempotency guard so retries don't re-email.
  meetingLink     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id])
  assignedTo User? @relation("ConsultationStaff", fields: [assignedToId], references: [id])

  @@index([leadId])
  @@index([type])
  // PR-BOOKING-1: busy-interval lookup for the slot engine (all booked
  // sessions for a staff member within a date range).
  @@index([assignedToId, scheduledAt])
  @@map("consultations")
}

// ─── BOOKING: STAFF AVAILABILITY (PR-BOOKING-1) ───────────────────────────────
//
// OWNER-set recurring weekly working hours for a bookable staff member. One
// row per staff member per weekday-window, so they can have multiple
// windows in a day (e.g. 09:00-12:00 and 13:00-17:00 = two rows).
//
// Times are stored as minutes-from-midnight (Int) in the row's `timezone`
// (wall-clock, NOT absolute instants). The slot engine converts these to
// absolute UTC per date using the IANA `timezone`, which is what makes
// DST handling correct. `active` soft-disables a window without deleting.
//
// Date-specific overrides (days off / one-off hours) are deferred to
// Phase 2 (StaffAvailabilityException) — the slot engine is written so
// they can layer on top of this weekly grid without rework.
model StaffAvailability {
  id          String   @id @default(cuid())
  staffId     String
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes from midnight, in `timezone`
  endMinute   Int // minutes from midnight, in `timezone`; must be > startMinute
  timezone    String   @default("Pacific/Auckland")
  active      Boolean  @default(true)
  // Who set this window (OWNER/ADMIN). Plain nullable String with no
  // relation, mirroring the Payment.verifiedById convention.
  setById     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff User @relation("StaffAvailabilityStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
  @@index([staffId, active])
  @@map("staff_availability")
}

// ─── BOOKING: STAFF LEAVE / TIME-OFF (PR-BOOKING-ADMIN-B) ─────────────────────
//
// Full-day leave for a bookable staff member. APPROVED leave is removed from
// booking availability by the slot engine (via its `excludedDates` hook):
// each leave's [startDate, endDate] inclusive range expands to YYYY-MM-DD
// calendar keys in the staff member's timezone, and those days are skipped.
//
// Dates are stored as "YYYY-MM-DD" STRINGS (wall-clock in the staff member's
// timezone) — that is exactly the key format the slot engine consumes, so
// there is no DateTime/UTC round-trip to introduce off-by-one drift.
//
// Two paths share this one model:
//   • admin sets leave directly → created with status APPROVED (slice 1).
//   • staff requests → APPROVED by an admin (REQUESTED→APPROVED) — the
//     lifecycle is modelled here but its UI is deferred to slice 2.
// Only APPROVED blocks slots; REQUESTED/REJECTED/CANCELLED never do.
enum StaffLeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum StaffLeaveKind {
  DAY_OFF // full day(s); CUSTOM_HOURS (partial-day) reserved for later
}

model StaffLeave {
  id            String           @id @default(cuid())
  staffId       String
  startDate     String // "YYYY-MM-DD" in the staff member's tz (inclusive)
  endDate       String // "YYYY-MM-DD" (inclusive); == startDate for one day
  kind          StaffLeaveKind   @default(DAY_OFF)
  status        StaffLeaveStatus @default(REQUESTED)
  reason        String?
  // Who raised it / who approved-or-rejected it. Plain nullable Strings
  // (no relation), mirroring StaffAvailability.setById.
  requestedById String?
  approvedById  String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  staff User @relation("StaffLeaveStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
  @@index([status])
  @@map("staff_leave")
}

// ─── STAFF HR: EMPLOYMENT CONTRACT (PR-STAFF-HR, Phase 3) ─────────────────────
//
// One current employment-contract PDF per staff member (userId @unique →
// re-upload replaces the row + deletes the old file). Bytes live on local
// disk under ./uploads/staff-contracts/{userId}/ — the SAME mechanism the
// student document uploaders use — and are served privately via a 5-minute
// signed-JWT token (/files/signed/:token). Never public. Uploaded only by
// ADMIN/OWNER; read only by the owning staff member (or an admin).
model StaffContract {
  id           String   @id @default(cuid())
  userId       String   @unique
  fileUrl      String // absolute disk path (matches AdmissionDocument.fileUrl convention)
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String // the ADMIN/OWNER who uploaded it
  uploadedAt   DateTime @default(now())

  staff User @relation("StaffContractStaff", fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_contract")
}

// ─── WALLET + STORE CREDIT (PR-WALLET, slice 1) ──────────────────────────────
//
// Client store-credit wallet. NOT cash: tiered cancellation/no-show refunds
// post CREDIT here (later slices); it is spent on future bookings; it is never
// a Stripe card refund (the captured Stripe money is kept). One wallet per
// client User. `balanceCents` is a DENORMALISED cache — the append-only
// WalletTransaction ledger is the source of truth. ALL money is Int cents.
model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  // Phase E: sessions are priced in USD; wallets follow. Existing empty NZD
  // wallets are migrated to USD (0 funded at migration time — verified). The
  // payWithWallet currency guard refuses any wallet.currency ≠ session currency.
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation("WalletUser", fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[] @relation("WalletTransactionWallet")

  @@map("wallet")
}

// Immutable, append-only ledger. Rows are NEVER updated or deleted. Each row
// snapshots `balanceAfterCents` for audit. `amountCents` is SIGNED: positive =
// credit in, negative = spend out. A partial-unique index on
// relatedConsultationId (WHERE type is a REFUND_* kind), added in the
// migration SQL, guarantees a consultation can be credited at most once.
enum WalletTransactionType {
  REFUND_CANCEL_FULL // cancel >24h before → 100% credited
  REFUND_CANCEL_LATE // cancel <24h before → 80% credited (20% retained)
  REFUND_NO_SHOW // human-marked no-show → 75% credited (25% retained)
  SPEND_BOOKING // credit spent on a future booking (negative amount)
  CASH_REDEMPTION // exceptional cash-out (later PR; negative amount)
  ADJUSTMENT // manual admin correction
}

model WalletTransaction {
  id                    String                @id @default(cuid())
  walletId              String
  amountCents           Int // signed: + credit / − spend
  type                  WalletTransactionType
  balanceAfterCents     Int // running balance snapshot (audit)
  reason                String?
  relatedConsultationId String?
  relatedPaymentId      String?
  createdById           String // system, admin, or the client
  createdAt             DateTime              @default(now())

  wallet Wallet @relation("WalletTransactionWallet", fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([relatedConsultationId])
  @@map("wallet_transaction")
}

// Which declaration a PolicyAcceptance row records.
//
// NULL means the wallet cancellation/refund policy — the original and only use
// until PR-PHASE39. Left null rather than backfilled so the wallet path is
// untouched and its existing rows keep meaning exactly what they meant.
enum DeclarationType {
  AGENT_DECLARATION
  ADMISSION_ACCEPTANCE
  VISA_SUBMIT_DECLARATION
}

// Proof-of-acceptance, captured server-side. Stores who/when + IP, device
// (user-agent), and the policy version they accepted.
//
// Originally the cancellation/refund policy before a paid booking's Stripe
// session. PR-PHASE39 extends it to the three in-form declarations (agent,
// admission acceptance, visa submit), which until now wrote only a Boolean or
// timestamp onto the application row — a value the client could clear by
// unticking, leaving no proof of what was agreed or when.
//
// APPEND-ONLY. Nothing updates or deletes a row here. Unticking and re-ticking
// a box writes a NEW row; the application's own field remains the fast
// "current status" check and may still be overwritten.
model PolicyAcceptance {
  id             String   @id @default(cuid())
  userId         String
  consultationId String?
  policyVersion  String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // PR-PHASE39 — all nullable so existing wallet rows stay valid unchanged.
  declarationType DeclarationType?
  /// The literal text shown to the client, snapshotted at the moment of
  /// agreement. `policyVersion` alone would not survive a wording change: the
  /// version tells you WHICH text, this tells you WHAT text, so the row is
  /// self-contained years later without a lookup into code history.
  declarationText String?
  /// The AdmissionApplication or VisaApplication this belongs to. Deliberately
  /// NOT a foreign key: an audit row must outlive the record it describes, and
  /// a cascade delete on the application would erase the very proof this table
  /// exists to keep.
  applicationId   String?

  user User @relation("PolicyAcceptanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consultationId])
  @@index([applicationId])
  @@index([declarationType])
  @@map("policy_acceptance")
}

// ─── CASES ───────────────────────────────────────────────────────────────────

model Case {
  id                    String    @id @default(cuid())
  leadId                String
  stage                 CaseStage @default(ADMISSION)
  // PR-SLA — when the case entered its CURRENT stage (stamped at every stage
  // write). Drives the per-stage deadline; NULL falls back to createdAt.
  stageEnteredAt        DateTime?
  // PR-SLA — optional manual per-case deadline that overrides the computed SLA
  // (e.g. a granted extension). NULL = use the institution-type × stage SLA.
  stageDeadlineOverride DateTime?
  status                String    @default("active")
  // PR-CONTRACT-CAPTURE — the visa type the LIA selected in the engagement
  // contract's `visaType` checkbox group, captured from DocuSign on envelope
  // completion (the webhook reads the LIA's selected tab). NULL until a contract
  // is fully signed. Free-text (the selected checkbox's label), not an enum, so
  // it survives template wording changes without a migration.
  visaType              String?
  ownerId               String?
  // PR-LIA-2: the LIA (Legal & Immigration Adviser) currently
  // responsible for this case. Set automatically when the client
  // signs the contract (load-balanced auto-pick), reassignable by
  // OWNER / ADMIN / SUPER_ADMIN via PATCH /cases/:id/lia. NULL
  // until contract sign (or if no active LIA was available at sign
  // time — the case sits unassigned and an audit row records why).
  liaId                 String?
  // PR-LIA-3: timestamp the LIA was attached to this case (or
  // reassigned to a different LIA). Set by both auto-assignment and
  // manual reassignment paths inside the same transaction that
  // touches `liaId`. NULL when no LIA is assigned. Used by the
  // productivity report for time-to-action / time-to-resolution
  // calculations and by the case-detail "Assigned N days ago" line.
  liaAssignedAt         DateTime?
  // Option 1 step 4: Support and Finance slot assignees on this case.
  // Reassignable via PATCH /cases/:id/support and /cases/:id/finance.
  // Both nullable + SetNull on user delete, mirroring liaId.
  supportId             String?
  financeId             String?
  // Phase 1 (auto-assignment): the real client Consultant — owns the client
  // from eligibility through to the visa result. DISTINCT from ownerId (whose
  // auth role is CONSULTANT but semantically = "Admission Specialist"). Holds a
  // user with the CLIENT_CONSULTANT role. Nullable + SetNull, mirroring lia/
  // support/finance so the case survives a consultant hard-delete.
  consultantId          String?
  // PR-LIA-7: INZ submission lifecycle. All five fields are co-managed
  // by the InzSubmissionService — they populate together when the LIA
  // submits, clear together on revert. The receipt file metadata is
  // denormalised onto Case (rather than a separate InzSubmissionReceipt
  // model) because there's only ever one receipt per case and its
  // lifecycle is tightly bound to the submission. The actual file lives
  // at `inzReceiptFileUrl` (a filesystem path under ./uploads/inz-receipts/);
  // we use the existing /files/signed/:token route to serve it.
  // The handover (§3 / §file-storage) explains the rationale.
  inzApplicationNumber  String?   @db.VarChar(128)
  inzSubmittedAt        DateTime?
  inzSubmissionNotes    String?   @db.Text
  inzReceiptFileUrl     String?
  inzReceiptFileName    String?
  inzReceiptMimeType    String?
  inzReceiptSizeBytes   Int?
  riskLevel             RiskLevel @default(LOW)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lead                  Lead                   @relation(fields: [leadId], references: [id])
  owner                 User?                  @relation("CaseOwner", fields: [ownerId], references: [id])
  // PR-LIA-2: assigned LIA. SetNull on user delete so the case
  // survives an LIA being hard-deleted (PR-CONSULT-4 audit-snapshot
  // pattern handles attribution).
  lia                   User?                  @relation("CaseLia", fields: [liaId], references: [id], onDelete: SetNull)
  // Option 1 step 4: Support and Finance slot assignees. SetNull on
  // user delete so the case survives a hard-delete of either staff
  // role, matching the lia relation's behaviour.
  support               User?                  @relation("CaseSupport", fields: [supportId], references: [id], onDelete: SetNull)
  finance               User?                  @relation("CaseFinance", fields: [financeId], references: [id], onDelete: SetNull)
  // Phase 1 (auto-assignment): the real client Consultant slot.
  consultant            User?                  @relation("CaseConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  applications          Application[]
  cvDocuments           CvDocument[]
  sopDocuments          SopDocument[]
  submissionRecords     SubmissionRecord[]
  offerRecords          OfferRecord[]
  contract              Contract?
  tickets               Ticket[]
  invoices              Invoice[]
  admissionApplications AdmissionApplication[]
  // PR-LIA-1: free-form legal notes + formal decisions on this case.
  legalNotes            LegalNote[]
  // PR-LIA-CONVO-NOTES: LIA conversation notes on this case (LIA/OWNER/SUPER_ADMIN only).
  conversationNotes     CaseConversationNote[]
  // PR-LIA-4: direct LIA ↔ client thread for this case.
  caseMessages          CaseMessage[]
  // PR-LIA-5: LIA's internal-only review verdicts on this case's
  // client-uploaded documents.
  documentReviews       CaseDocumentReview[]
  // Documents step 2: R2-backed case attachments. Sibling to the
  // existing review-verdict surface above; uploads land here.
  documents             Document[]             @relation("CaseDocuments")
  // PR-LIA-8: visa outcome (1:0..1). One row per case ever — issued
  // by the LIA after INZ decides on the submitted application. NULL
  // until the LIA records the outcome via POST /cases/:id/visa/issue
  // (APPROVED) or POST /cases/:id/visa/decline (DECLINED). Reverting
  // un-issues, returning the case to INZ_SUBMITTED.
  visa                  Visa?
  // PR-LIA-10: reviewing INZ officer for this case (1:0..1). At most
  // one officer per case — the unique constraint on (caseId, officerId)
  // means re-linking the same officer is an upsert. Re-linking a
  // DIFFERENT officer would 409; LIA must unlink first.
  officerLinkage        CaseOfficerLinkage?
  // PR-LIA-AUTO-ASSIGN: Stripe-webhook-event payments tied to this case
  // (e.g. the $200 ACCOUNT_OPENING charge). The payment row is what the
  // ACCOUNT_OPENING webhook branch consults before firing the LIA
  // auto-assign — it's the durable record of the trigger event.
  payments              Payment[]
  // PR-RECS-1 — generated programme recommendation lists for this case (1:many;
  // regeneration supersedes the prior list). Virtual back-relation — the FK lives
  // on recommendation_lists.caseId, so this adds no column to `cases`.
  recommendationLists   RecommendationList[]
  // PR-INTAKE-1 (Slice 3) — auto-reassignment / manual-review tasks for this case.
  admissionTasks        AdmissionTask[]
  // PR-HANDOFF — explicit stage-to-stage handoffs on this case.
  handoffs              CaseHandoff[]

  @@index([leadId])
  @@index([stage])
  @@index([liaId])
  // Option 1 step 4: support / finance slot lookups.
  @@index([supportId])
  @@index([financeId])
  @@index([consultantId])
  // PR-LIA-7: fast lookup by INZ reference number (e.g. "find the case
  // that owns VRC-2026-NZL-12345"). Unique constraint deliberately
  // NOT enforced — duplicate references are LIA-error territory but
  // not data-corrupting, and we don't want a UNIQUE clash to crash a
  // submit transaction.
  @@index([inzApplicationNumber])
  @@map("cases")
}

/// The four staff stages a case moves through, in order. These are the existing
/// Case ownership slots named as stages — no new assignment concept, so a
/// handoff moves the case along the same slots auto-assignment already fills.
///   ADMISSION → Case.ownerId    SUPPORT → Case.supportId
///   FINANCE   → Case.financeId  LIA     → Case.liaId
enum CaseSlot {
  ADMISSION
  SUPPORT
  FINANCE
  LIA
}

enum HandoffState {
  PENDING
  ACCEPTED
  CANCELLED
}

/// PR-HANDOFF — a case being handed from one stage to the next.
///
/// The stuck-case detection on /staff/handoffs infers trouble from state; this
/// records the event itself, so "who passed this to whom, when, and did they
/// pick it up" is answerable rather than reconstructed.
///
/// Deliberately NOT AuditLog: a work queue is read as "open items addressed to
/// me", which needs a status column and an index on the recipient. Expressing
/// that over AuditLog's JSON payload would mean scanning the audit table on
/// every queue load.
model CaseHandoff {
  id            String       @id @default(cuid())
  caseId        String
  fromSlot      CaseSlot
  toSlot        CaseSlot
  /// Nullable + name snapshots, so deleting a staff account leaves the history
  /// readable rather than taking a record of who did what with it.
  fromUserId    String?
  toUserId      String?
  fromUserName  String?
  toUserName    String?
  note          String?
  /// Currently single-valued: handoffs are created ACCEPTED and nothing sets
  /// CANCELLED. Kept because dropping it would be a destructive migration and
  /// the enum is referenced elsewhere — and because cancelling a handoff is a
  /// plausible future feature, at which point this column is already here.
  status        HandoffState @default(PENDING)
  /// Equal to createdAt: acceptance is automatic, so the two are the same
  /// instant by construction rather than by coincidence.
  acceptedAt    DateTime?
  /// The first time the RECEIVING user of this handoff opened the case.
  ///
  /// NOT "the first time anyone viewed this case" — it is only ever set for the
  /// person the handoff was addressed to. A case opened by someone else, or a
  /// case with no handoff at all, leaves this null forever. Read it as "how
  /// long until the recipient looked at what they were given", which is what a
  /// KPI layer would want, and do not read it as case-view telemetry.
  ///
  /// Set once and never overwritten (the update is conditional on it being
  /// null). Passive: nothing is gated on it.
  firstViewedAt DateTime?
  createdAt     DateTime     @default(now())

  case Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  from User? @relation("HandoffFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  to   User? @relation("HandoffTo", fields: [toUserId], references: [id], onDelete: SetNull)

  /// The queue read: open items addressed to one person.
  @@index([toUserId, status])
  /// The case-history read: this case's handoffs, newest first.
  @@index([caseId, createdAt])
  @@map("case_handoffs")
}

/// PR-HANDOFF — in-app notifications.
///
/// Kept to the minimum that makes an unread badge and a list work. `link` is a
/// path the frontend routes to, and `type` exists so a future sender can be
/// added without another migration — not a general notification framework.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The badge read: unread count for one user.
  @@index([userId, read])
  @@map("notifications")
}

// ─── VISA OUTCOME (PR-LIA-8) ──────────────────────────────────────────
//
// One row per Case ever — set by the LIA when INZ decides on the
// submitted application. Two outcomes:
//
//   * APPROVED — visaStartDate / visaEndDate populated; visa document
//                file metadata (URL, name, mime, size) populated.
//                declineReasonEncrypted is NULL.
//   * DECLINED — declineReasonEncrypted populated (AES-256-GCM via
//                CryptoService, same envelope as LegalNote.bodyEncrypted).
//                Date and file fields are NULL.
//
// Either outcome moves the parent Case to COMPLETED. Revert un-issues:
// deletes the Visa row, sets Case.stage back to INZ_SUBMITTED, leaves
// the visa file on disk (recoverable; orphan cleanup is a future
// concern — same pattern as PR-LIA-7's revert).
//
// The visaEndDate index is a forward hook for PR-LIA-9's expiry-reminder
// query (find approved visas whose end date is within N days of now).
enum VisaIssueOutcome {
  APPROVED
  DECLINED
}

model Visa {
  id                     String           @id @default(uuid())
  caseId                 String           @unique
  outcome                VisaIssueOutcome
  // Approval fields (populated when outcome=APPROVED)
  visaStartDate          DateTime?
  visaEndDate            DateTime?
  visaDocumentUrl        String?          @db.Text
  visaDocumentName       String?          @db.Text
  visaDocumentMime       String?          @db.Text
  visaDocumentSize       Int?
  // Decline fields (populated when outcome=DECLINED)
  declineReasonEncrypted Bytes?
  // Common metadata
  issuedById             String
  issuedAt               DateTime         @default(now())
  notes                  String?          @db.Text
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issuedBy User @relation("VisaIssuer", fields: [issuedById], references: [id])

  // PR-LIA-9: dispatched expiry-reminder ledger. One row per
  // (visa, threshold, recipient) — the unique constraint keeps the
  // sweep idempotent.
  expiryReminders VisaExpiryReminderSent[]

  @@index([issuedById, issuedAt])
  @@index([visaEndDate])
  @@map("visas")
}

// ─── VISA EXPIRY REMINDERS (PR-LIA-9) ─────────────────────────────────
//
// One row per dispatched (or attempted) expiry-reminder email. Created
// by the daily 09:00 NZ cron in VisaExpiryService.runDailySweep. The
// unique composite (visaId, thresholdDays, recipient) makes re-running
// the sweep safe — a second pass through the same threshold for the
// same visa skips reminders that have already been recorded.
//
// emailDeliveryStatus tracks the actual SMTP outcome (PENDING / SENT
// / FAILED) so OWNER eyes-on can spot delivery problems without
// having to crawl the audit log. emailErrorMessage carries the
// nodemailer error string when status=FAILED. The audit row is
// always written regardless of delivery — the audit captures intent,
// this table captures outcome.
//
// Reminder rows are NOT deleted when a visa record is reverted (per
// the PR-LIA-9 spec — keep the historical trail). They cascade with
// the parent visa only if the visa itself is hard-deleted.
enum VisaExpiryReminderRecipient {
  LIA
  CLIENT
  OWNER
}

// ─── IMMIGRATION OFFICER MODULE (PR-LIA-10) ──────────────────────────
//
// Shared knowledge base of INZ officers. Three tables in one cluster:
//
//   * ImmigrationOfficer            — collaborative profile
//                                     (any LIA can edit per Decision 2C)
//   * ImmigrationOfficerObservation — append-only attributed notes
//                                     (authored, immutable, only the
//                                     author can delete their own)
//   * CaseOfficerLinkage            — case ↔ officer link with
//                                     snapshotted outcome at link time
//                                     (Decision 3A: outcome at the
//                                     moment of linkage, not auto-
//                                     refreshed if visa state later
//                                     changes — LIA re-links to refresh)
//
// Encryption (Decision 1A — non-negotiable):
//   * profileDescriptionEncrypted   — Bytes, AES-256-GCM via CryptoService
//   * bodyEncrypted (observations)  — Bytes, same envelope
//   * noteEncrypted (linkages)      — Bytes, same envelope
//
// Aggregates (Decision 3A — non-negotiable):
//   * No maintained counters on ImmigrationOfficer for totalCases /
//     approvedCases / declinedCases — read-time aggregation only.
//     The (officerId, linkedAt) index keeps these queries cheap.
model ImmigrationOfficer {
  id               String  @id @default(uuid())
  // Identity (plaintext — needed for ILIKE search + ORDER BY).
  fullName         String  @db.VarChar(200)
  officerCode      String? @db.VarChar(64)
  branch           String? @db.VarChar(200)
  countryOfPosting String? @db.VarChar(120)

  // Encrypted profile description.
  profileDescriptionEncrypted Bytes?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                            @relation("OfficerCreator", fields: [createdById], references: [id])
  observations ImmigrationOfficerObservation[]
  caseLinkages CaseOfficerLinkage[]

  @@index([fullName])
  @@index([branch])
  @@index([countryOfPosting])
  @@map("immigration_officers")
}

model ImmigrationOfficerObservation {
  id            String   @id @default(uuid())
  officerId     String
  authorId      String
  bodyEncrypted Bytes
  // Free-form analyst tags (e.g. ["financial-scrutiny", "fast-decision"]).
  // Plaintext on purpose — these are categorical labels for future
  // analytics, not sensitive prose.
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  // No updatedAt — Decision 2C: observations are append-only. The
  // author can delete their own row, but cannot edit (delete + repost).

  officer ImmigrationOfficer @relation(fields: [officerId], references: [id], onDelete: Cascade)
  author  User               @relation("OfficerObservationAuthor", fields: [authorId], references: [id])

  @@index([officerId, createdAt])
  @@index([authorId, createdAt])
  @@map("immigration_officer_observations")
}

model CaseOfficerLinkage {
  id            String            @id @default(uuid())
  caseId        String            @unique
  officerId     String
  // Snapshot of visa.outcome at the moment of linkage (null if the
  // case hasn't reached a decision yet). NOT auto-updated if the
  // visa outcome later changes — the LIA re-links to refresh.
  linkedOutcome VisaIssueOutcome?
  // Optional encrypted note about this specific officer-case interaction.
  noteEncrypted Bytes?
  linkedById    String
  linkedAt      DateTime          @default(now())

  case     Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // Restrict on officer delete — can't drop an officer that still
  // has cases attached. LIA must unlink first (a deliberate friction
  // step so institutional knowledge isn't lost by accident).
  officer  ImmigrationOfficer @relation(fields: [officerId], references: [id], onDelete: Restrict)
  linkedBy User               @relation("CaseOfficerLinker", fields: [linkedById], references: [id])

  // caseId is already UNIQUE above (one officer per case max), but
  // the spec asks for the composite too — kept for documentation
  // purposes + a defensive guard if caseId UNIQUE is ever relaxed.
  @@unique([caseId, officerId])
  @@index([officerId, linkedAt])
  @@index([linkedAt])
  @@map("case_officer_linkages")
}

model VisaExpiryReminderSent {
  id                  String                      @id @default(uuid())
  visaId              String
  thresholdDays       Int
  recipient           VisaExpiryReminderRecipient
  // FK target: User. NULL for OWNER reminders that fan out to every
  // user with role=OWNER (the loop dispatches one email per OWNER but
  // we record a single ledger row to keep the unique constraint
  // useful — re-running the sweep skips the whole OWNER fan-out).
  recipientUserId     String?
  sentAt              DateTime                    @default(now())
  emailDeliveryStatus String                      @default("PENDING")
  emailErrorMessage   String?                     @db.Text

  visa Visa @relation(fields: [visaId], references: [id], onDelete: Cascade)

  @@unique([visaId, thresholdDays, recipient], name: "uniq_visa_threshold_recipient")
  @@index([visaId, sentAt])
  @@index([sentAt])
  @@map("visa_expiry_reminders_sent")
}

// ─── SLA ──────────────────────────────────────────────────────────────────────

// PR-SLA — Owner-manageable stage deadlines. One row per (institutionType, stage);
// slaDays is editable via /staff/settings/sla with no code deploy. ADMISSION is
// working-days-based; VISA / INZ_SUBMITTED are calendar-days (isWorkingDays). The
// deadline for a case = stageEnteredAt + slaDays (working or calendar), unless a
// per-case stageDeadlineOverride is set. Terminal stages (COMPLETED/WITHDRAWN) have
// no row. A case's institutionType is its accepted/most-recent application's
// provider.providerType, falling back to a default when unknown.
model SlaConfig {
  id              String       @id @default(cuid())
  institutionType ProviderType
  stage           CaseStage
  slaDays         Int
  isWorkingDays   Boolean      @default(false)
  updatedAt       DateTime     @updatedAt
  updatedById     String?

  @@unique([institutionType, stage], name: "uniq_institution_stage")
  @@map("sla_configs")
}

// ─── NURTURE ──────────────────────────────────────────────────────────────────

// PR-NURTURE — the lifecycle stage of a lead's nurture engagement.
//   NONE       — never enrolled.
//   SEQUENCE   — inside the 7-touch / 21-day post-FREE_15 sequence.
//   NEWSLETTER — sequence completed with no exit; now on the indefinite monthly
//                newsletter cadence.
//   ENDED      — an exit condition fired or staff manually stopped it. Terminal.
// (Unsubscribe is a SEPARATE master kill-switch: Lead.nurtureUnsubscribedAt.)
enum NurtureStage {
  NONE
  SEQUENCE
  NEWSLETTER
  ENDED
}

// PR-NURTURE — a phone-call touch in the sequence (steps 2/4/9/21 → the CALL
// steps). Lead-attached (a nurture-stage lead has no Case yet) and assigned to
// the Client Officer who ran the FREE_15 (Consultation.assignedToId). Carries its
// own outcome capture since there's no Case to attach a conversation note to.
model NurtureCallTask {
  id            String            @id @default(cuid())
  leadId        String
  // The Client Officer who ran the FREE_15. Nullable + SetNull so the task
  // survives a staff hard-delete (mirrors the case-slot relations).
  assignedToId  String?
  step          Int // 2, 4, or 7 (the CALL steps)
  dueDate       DateTime
  status        NurtureCallStatus @default(PENDING)
  outcomeNotes  String?
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo  User? @relation("NurtureCallAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy User? @relation("NurtureCallCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  // One task per (lead, step) — makes the cron's create idempotent under re-runs.
  @@unique([leadId, step], name: "uniq_lead_call_step")
  // "my open tasks, oldest-due first" — the staff Follow-ups list query.
  @@index([assignedToId, dueDate])
  @@index([leadId])
  @@map("nurture_call_tasks")
}

enum NurtureCallStatus {
  PENDING
  DONE
  SKIPPED
  AUTO_CLOSED
}

// PR-NURTURE — email/newsletter send ledger. Mirrors VisaExpiryReminderSent: one
// row per (lead, step) makes the daily sweep idempotent across re-runs. `step`
// is a string so it holds both the sequence email steps ("1","3","5","6") and the
// monthly newsletter keys ("NL-YYYY-MM").
model LeadNurtureSent {
  id                  String   @id @default(uuid())
  leadId              String
  step                String
  sentAt              DateTime @default(now())
  emailDeliveryStatus String   @default("PENDING")
  emailErrorMessage   String?  @db.Text

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, step], name: "uniq_lead_nurture_step")
  @@index([leadId, sentAt])
  @@map("lead_nurture_sent")
}

// ─── APPLICATIONS ────────────────────────────────────────────────────────────

model Application {
  id              String            @id @default(cuid())
  caseId          String
  providerId      String
  programmeId     String
  intakeId        String?
  status          ApplicationStatus @default(PREPARATION)
  executionMode   String?
  liaRequired     Boolean           @default(false)
  submittedAt     DateTime?
  offerReceivedAt DateTime?
  offerAcceptedAt DateTime?
  visaSubmittedAt DateTime?
  visaDecisionAt  DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  case      Case                  @relation(fields: [caseId], references: [id])
  provider  EducationProvider     @relation(fields: [providerId], references: [id])
  programme EducationProgramme    @relation(fields: [programmeId], references: [id])
  documents ApplicationDocument[]

  @@index([caseId])
  @@index([status])
  @@map("applications")
}

// ─── DOCUMENTS ───────────────────────────────────────────────────────────────

model ApplicationDocument {
  id            String         @id @default(cuid())
  applicationId String
  type          String
  fileName      String?
  fileUrl       String?
  status        DocumentStatus @default(MISSING)
  verifiedAt    DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}

// ─── CONTRACTS ───────────────────────────────────────────────────────────────

model Contract {
  id                   String         @id @default(cuid())
  // PR-CONTRACT-LEAD (Phase B) — a contract can now be sent Lead-based, BEFORE a
  // Case exists. caseId is nullable and backfilled the moment the CLIENT (first
  // signer) completes their signature (the webhook auto-creates the Case then).
  // Still @unique so a Case can only ever have one contract; Postgres lets many
  // rows share a NULL caseId (the lead-based window), and a partial unique index
  // (contracts_leadId_active_key, WHERE "caseId" IS NULL — see the migration)
  // prevents more than one LIVE lead-based contract per lead.
  caseId               String?        @unique
  // The lead this contract was raised for. Always set on a lead-based send;
  // legacy case-based rows leave it NULL (they resolve the lead via the case).
  leadId               String?
  templateId           String?
  docusignEnvelopeId   String?
  // PR-DOCUSEAL — external submission id when the contract is sent via DocuSeal
  // (the active provider). Distinct from docusignEnvelopeId so the DocuSign path
  // stays intact for rollback. The DocuSeal webhook looks the contract up by it.
  docusealSubmissionId String?        @unique
  status               ContractStatus @default(DRAFT)
  signedAt             DateTime?
  declinedAt           DateTime?
  expiredAt            DateTime?
  signedFileUrl        String?
  auditTrailUrl        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  case Case? @relation(fields: [caseId], references: [id])
  // PR-CONTRACT-LEAD (Phase B) — the lead-based link, present until the case exists.
  lead Lead? @relation(fields: [leadId], references: [id])

  // PR-DOCUSIGN-1 step 2: per-party signer rows. Sequential routing —
  // one row per signer slot; "fully signed" is derived from all rows
  // having signedAt non-null (no PARTIALLY_SIGNED enum value).
  signers ContractSigner[]

  @@index([leadId])
  @@map("contracts")
}

// ─── CONTRACT SIGNERS (PR-DOCUSIGN-1 step 2) ─────────────────────────────────
// One row per party on a contract envelope. Sequential routing — lowest
// routingOrder signs first, then envelope advances to the next slot.
//
// Launch flows (the only two wired at soft-launch):
//   • Adult student:    CLIENT (1)   → LIA (2) → DIRECTOR (3)
//   • Under-18 student: GUARDIAN (1) → LIA (2) → DIRECTOR (3)
//     (the minor does NOT sign; the guardian signs on their behalf, with
//     the minor's name captured in signingOnBehalfOf)
//
// PARTNER and FAMILY_MEMBER values exist in the role enum so the post-
// launch family-visa flow can add them without an enum migration — but
// no flow constructs envelopes with those roles yet.
//
// Identity is SNAPSHOTTED at envelope-creation time (signerName +
// signerEmail). If a User's email later changes, this row keeps what
// was actually sent. userId FK is optional and SetNull on hard-delete:
// the row survives with the snapshotted identity as audit evidence —
// mirrors actorNameSnapshot in audit_logs.
//
// Why @@unique([contractId, role]) is intentionally NOT here: a family-
// visa envelope can carry multiple family-type signers (partner +
// family member) on the same contract. routingOrder is the slot-
// uniqueness guarantee; role is descriptive, not constraint-bearing.
model ContractSigner {
  id         String @id @default(cuid())
  contractId String

  role         ContractSignerRole
  routingOrder Int // 1, 2, 3, … — matches DocuSign routingOrder

  // Identity snapshot — durable truth, what the envelope was actually
  // addressed to at send time. NOT updated when the underlying User /
  // Contact later changes their name or email.
  signerName  String
  signerEmail String

  // GUARDIAN only — the name of the minor student this guardian is
  // authorized to sign on behalf of. Null for every other role.
  // Provides the legal record of the guardian-to-minor relationship
  // that backed this signature. Stored as a plain name snapshot (the
  // minor is not a signer; no FK or status of their own). App-layer
  // invariant: role === 'GUARDIAN' ⇒ signingOnBehalfOf IS NOT NULL.
  signingOnBehalfOf String?

  // Optional FK to User. Populated for LIA + DIRECTOR rows (always
  // staff). Populated for CLIENT / GUARDIAN / PARTNER / FAMILY_MEMBER
  // rows when that person has a User account at envelope-creation
  // time. SetNull on user hard-delete — the snapshotted identity
  // above survives.
  userId String?

  // Per-signer state — independent of the parent Contract.status,
  // which mirrors the envelope-level state DocuSign reports back.
  // "Fully signed" is derived from child rows (all signedAt non-null),
  // not stored as a dedicated ContractStatus value.
  status        ContractSignerStatus @default(PENDING)
  viewedAt      DateTime?
  signedAt      DateTime?
  declinedAt    DateTime?
  declineReason String? // DocuSign returns a free-text reason

  // DocuSign-side recipient id (string "1"/"2"/"3"/… within an envelope).
  // Webhook payloads reference recipients by this id; we look up the
  // ContractSigner row by (contractId, docusignRecipientId).
  docusignRecipientId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([contractId, routingOrder]) // slot uniqueness — no two signers share a position
  @@index([contractId])
  @@index([userId])
  @@map("contract_signers")
}

// ─── LEGAL NOTES (PR-LIA-1) ──────────────────────────────────────────────────
//
// Free-form notes and formal decisions attached to a CRM-side Case by
// the LIA (Legal & Immigration Adviser) team. Two row variants:
//   * Note      — decision IS NULL, decisionReasonEncrypted IS NULL.
//                 `bodyEncrypted` holds the LIA's free-form note.
//   * Decision  — decision IS NOT NULL. Both encrypted body and
//                 decisionReasonEncrypted are populated (the body is
//                 a one-line system summary of the decision; the
//                 reason carries the LIA's written justification).
//
// Both encrypted columns hold AES-256-GCM ciphertext via CryptoService
// (same envelope as every other PII column in the project).
model LegalNote {
  id                      String         @id @default(uuid())
  caseId                  String
  authorId                String
  bodyEncrypted           Bytes
  decision                LegalDecision?
  decisionReasonEncrypted Bytes?
  createdAt               DateTime       @default(now())

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("LegalNoteAuthor", fields: [authorId], references: [id])

  @@index([caseId, createdAt])
  @@map("legal_notes")
}

// ─── CASE CONVERSATION NOTES (PR-LIA-CONVO-NOTES) ─────────────────────────────
//
// Free-form notes an LIA adviser records after speaking with a client, attached
// to a Case. STRICT visibility: readable/writable ONLY by LIA, OWNER, and
// SUPER_ADMIN — NOT the consultant/support assigned to the same case, and NEVER
// the client. Enforced server-side in CaseConversationNotesService, not just the
// UI. Distinct from LegalNote (which carries formal legal decisions, is encrypted
// at rest, and is create-only). These are:
//   * plain sanitized HTML (rich text: bold/italic/lists/links) — NOT encrypted,
//   * editable + deletable by the author and by OWNER/SUPER_ADMIN,
//   * always sanitized server-side before persistence (never trust client HTML).
model CaseConversationNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  bodyHtml  String // sanitized HTML — server-side allowlist, see html-sanitizer.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("ConvNoteAuthor", fields: [authorId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_conversation_notes")
}

// ─── CASE MESSAGES (PR-LIA-4) ────────────────────────────────────────────────
//
// Direct messaging thread between the LIA and the case's client.
// Both encrypted body and (optional) document-request type live on
// the same row — the shape variant is determined by `kind`.
//
// Read-tracking is per-thread per-viewer (readByLia / readByClient),
// not per-message: when the LIA fetches the thread, every unread
// CLIENT-authored row flips to readByLia=true in one update. Same on
// the client side with the directions reversed. A single
// CASE_MESSAGE_READ audit row captures the flip (count, not row-by-row).
//
// fulfilledByFileId is the optional link to the VisaSupportingDocument
// the client used to fulfil a DOCUMENT_REQUEST. See the PR-LIA-4
// handover for why VisaSupportingDocument (and not e.g. ApplicationDocument)
// is the chosen FK target.
model CaseMessage {
  id                String                @id @default(uuid())
  caseId            String
  authorId          String
  authorRole        CaseMessageAuthorRole
  kind              CaseMessageKind       @default(MESSAGE)
  bodyEncrypted     Bytes
  requestedDocType  String?
  fulfilledByFileId String?
  fulfilledAt       DateTime?
  readByClient      Boolean               @default(false)
  readByLia         Boolean               @default(false)
  createdAt         DateTime              @default(now())

  case            Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author          User                    @relation("CaseMessageAuthor", fields: [authorId], references: [id])
  fulfilledByFile VisaSupportingDocument? @relation("CaseMessageFulfilment", fields: [fulfilledByFileId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([caseId, readByClient])
  @@index([caseId, readByLia])
  @@map("case_messages")
}

// ─── CASE DOCUMENT REVIEWS (PR-LIA-5) ────────────────────────────────────────
//
// LIA's internal-only verdict on a client-uploaded document. The
// source document lives in one of three tables (AdmissionDocument,
// ApplicationDocument, VisaSupportingDocument) — we identify it by
// `(source, sourceRowId)` rather than a typed FK so we don't have to
// modify any of the source upload models. UNREVIEWED is the implicit
// default (no row exists); only APPROVED / REJECTED rows are stored.
//
// `reasonEncrypted` carries the LIA's free-form justification in the
// same AES-256-GCM envelope as LegalNote.bodyEncrypted. Required for
// both APPROVED and REJECTED. Re-reviewing a document upserts the
// existing row (UNIQUE on (source, sourceRowId)).
//
// Client-visible: NO. The PR-LIA-5 design is internal-only — if a
// re-upload is needed, the LIA messages the client via PR-LIA-4.
// Forward-compat would be a "publishToClient: Boolean" flag.
model CaseDocumentReview {
  id              String                   @id @default(uuid())
  caseId          String
  source          CaseDocumentReviewSource
  sourceRowId     String
  status          CaseDocumentReviewStatus
  reasonEncrypted Bytes
  reviewedById    String
  reviewedAt      DateTime                 @default(now())

  case       Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewedBy User @relation("CaseDocumentReviewer", fields: [reviewedById], references: [id])

  @@unique([source, sourceRowId])
  @@index([caseId, reviewedAt])
  @@map("case_document_reviews")
}

// ─── COMMISSIONS ─────────────────────────────────────────────────────────────

model Commission {
  id                  String           @id @default(cuid())
  /// The programme this commission is earned on.
  ///
  /// PR-COMMISSION-ANCHOR — was `applicationId`, pointing at `Application`.
  /// That model has never held a row and nothing in the admission flow writes
  /// to it: the live pipeline is AdmissionApplication → AdmissionProgrammeChoice
  /// → SubmissionRecord / OfferRecord. A commission is earned on one programme
  /// at one institution, which is exactly what a programme choice is.
  ///
  /// Still @unique — one commission per programme choice, the same rule the
  /// Application anchor enforced.
  programmeChoiceId   String           @unique
  providerId          String
  programmeId         String
  commissionYear      Int              @default(1)
  commissionType      CommissionType   @default(PERCENTAGE)
  commissionValue     Float
  estimatedAmountNZD  Float?
  actualAmountNZD     Float?
  currency            String           @default("NZD")
  status              CommissionStatus @default(ESTIMATED)
  confirmedAt         DateTime?
  invoiceSentAt       DateTime?
  paidAt              DateTime?
  renewalReminderDate DateTime?
  reminderSent        Boolean          @default(false)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  programmeChoice AdmissionProgrammeChoice @relation(fields: [programmeChoiceId], references: [id])
  provider        EducationProvider        @relation(fields: [providerId], references: [id])
  programme       EducationProgramme       @relation(fields: [programmeId], references: [id])
  // A list, not a single row, because a REJECTED payable stays on record while
  // a fresh one may be derived for the same commission. At most ONE non-rejected
  // payable can exist at a time — enforced by a partial unique index that Prisma
  // cannot express (see the agent_payable_rejection migration).
  agentPayables   AgentPayable[]

  @@index([status])
  @@index([providerId])
  @@map("commissions")
}

/// PR-COMMISSION-TRIGGER — the Admission Officer's claim that a commission is
/// now owed, and Finance's decision on it.
///
/// Separate from `Commission` rather than a state in front of ESTIMATED: the two
/// answer different questions. A trigger asks "has this been claimed, and did
/// Finance agree?"; a commission tracks "is the money estimated, invoiced, in?".
/// Folding them together would have made CommissionStatus mean two lifecycles.
///
/// Approving a trigger is what CREATES the commission — so a commission row now
/// implies someone claimed it and someone else agreed, which the free-form
/// modal never did.
///
/// NOT unique on programmeChoiceId. A rejected claim must be re-submittable if
/// circumstances change, and a plain unique constraint would make the first
/// rejection permanent. Instead a PARTIAL unique index (see the migration)
/// allows at most one trigger that is not REJECTED, so the rejection history is
/// kept and only one live claim can exist at a time.
///
/// Actor fields are plain id snapshots with no relation, matching
/// SubmissionRecord.submittedById and OfferRecord.createdById in this same
/// admission cluster.
model CommissionTrigger {
  id                String                  @id @default(cuid())
  programmeChoiceId String
  submittedById     String
  submittedAt       DateTime                @default(now())
  status            CommissionTriggerStatus @default(PENDING)
  decidedById       String?
  decidedAt         DateTime?
  /// Required when REJECTED — a refusal the Admission Officer cannot read is
  /// one they cannot act on.
  rejectionReason   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  programmeChoice AdmissionProgrammeChoice @relation(fields: [programmeChoiceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([programmeChoiceId])
  @@map("commission_triggers")
}

/// PR-AGENT-PAYABLES — what Sorena owes an introducing agent.
///
/// Derived, never asserted. A payable exists only where a Commission Sorena has
/// actually earned traces back to a Lead an agent introduced:
///
///   AgentPayable → Commission → AdmissionProgrammeChoice → AdmissionApplication
///                → Case → Lead.attributedAgentId → AffiliateAgent
///
/// That shape is the whole risk model. Paying a share of money already earned
/// means Sorena cannot owe an agent for a lead that never enrolled or never
/// paid — there is no payable without a commission to take a share of.
///
/// `amount` and `ratePercent` are SNAPSHOTS taken when the payable is derived,
/// not recomputed on read. The same reasoning as an invoice's locked exchange
/// rate: changing the company rate must not silently restate what an agent was
/// already told they were owed, or what has already been paid.
///
/// One payable per commission, enforced by @unique — the same rule shape as one
/// commission per programme choice.
///
/// Actor fields are plain id + name snapshots with no relation, matching
/// CommissionTrigger and Payment.verifiedById in this codebase.
model AgentPayable {
  id           String             @id @default(cuid())
  agentId      String
  /// NOT unique outright: a rejected payable stays, and a replacement may be
  /// derived. The partial unique index in the migration allows at most one row
  /// per commission whose status is not REJECTED.
  commissionId String
  /// Share of the commission, in the commission's own currency.
  amount       Decimal            @db.Decimal(10, 2)
  currency     String
  /// The rate this row was calculated at, kept so an old payable stays
  /// explicable after the company rate changes.
  ratePercent  Float
  status       AgentPayableStatus @default(PENDING)

  /// Finance agreed the amount is owed.
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  /// The Owner released the money. Deliberately separate from approval — the
  /// person who confirms a debt is not the person who pays it.
  paidById        String?
  paidByName      String?
  paidAt          DateTime?
  /// Finance refused the share. The reason is REQUIRED at the service boundary
  /// — unlike the refund queue's optional decision note — because this is money
  /// owed to somebody outside the company and "why not" is what reconciliation
  /// needs months later.
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent      AffiliateAgent @relation(fields: [agentId], references: [id])
  commission Commission     @relation(fields: [commissionId], references: [id])

  @@index([status])
  @@index([agentId, status])
  @@map("agent_payables")
}

// ─── EDUCATION PROVIDERS ─────────────────────────────────────────────────────

model EducationProvider {
  id                       String           @id @default(cuid())
  name                     String
  providerType             ProviderType
  // PR-PHASE34 — NZ regulatory type (authoritative; providerType kept for now,
  // flagged for later consolidation). legalEntityName = source "Provider Entity"
  // (the legal body) vs `name` = the recognisable brand.
  institutionType          InstitutionType?
  legalEntityName          String?
  // PR-IMPORT — source "Brand": the short display name (e.g. "Ara" for "Ara
  // Institute of Canterbury"). ITP/PTE files only; universities publish one name.
  brand                    String?
  country                  String           @default("NZ")
  // PR-PROVIDER-PORTAL slice A — the institution's single login.
  //
  // Nullable because almost no provider has one (production: 96 providers, 0
  // logins), and @unique because the decision is ONE login per institution,
  // mirroring AffiliateAgent.userId exactly. SetNull on delete: removing a user
  // must never cascade into deleting an institution and its catalogue.
  //
  // Slice B resolves "which provider is this caller" from here, via the JWT —
  // never from a URL parameter. Nothing reads it yet.
  userId                   String?          @unique
  user                     User?            @relation("EducationProviderLogin", fields: [userId], references: [id], onDelete: SetNull)
  city                     String?
  // PR-EXPLORE — map coordinates for the student Explore map.
  //
  // Nullable on purpose and NEVER guessed: an institution that cannot be
  // geocoded confidently keeps null and is listed without a pin, rather than
  // being dropped from results or pinned at an invented location. geocodedAt
  // records when the lookup ran so a later pass can re-try only the misses.
  latitude                 Float?
  longitude                Float?
  geocodedAt               DateTime?
  geocodeSource            String? // e.g. "nominatim" — provenance for a re-check
  websiteUrl               String?
  // PR-CATALOG-2 — programme-listing/index entry point for the monthly discovery
  // crawl (Pass B). Owner-supplied; discovery skips the institution when unset.
  catalogueUrl             String?
  // PR-SLOTRULES (Decision 2) — Owner-pinned "Featured" institution. ADDITIVE display
  // signal ONLY: surfaced alongside the normal ranked options in Apply/Study Step 1. NEVER
  // read by matching, slot-rule validation, or any ranking/assignment logic.
  isFeatured               Boolean          @default(false)
  status                   ProviderStatus   @default(PENDING)
  agreementUrl             String?
  agreementStartDate       DateTime?
  agreementEndDate         DateTime?
  agreementRenewalDate     DateTime?
  commissionY1Type         CommissionType   @default(PERCENTAGE)
  commissionY1Value        Float            @default(0)
  commissionY2Type         CommissionType   @default(PERCENTAGE)
  commissionY2Value        Float            @default(0)
  // PR-ENGLISH-COMMISSION — the rate for ENGLISH-LANGUAGE courses at this
  // institution, when it differs from the rate above.
  //
  // NULLABLE on purpose, and that is load-bearing: null means "no English-
  // specific rate — use the normal one", which is NOT the same as an agreed rate
  // of 0%. A @default(0) here would have quietly asserted that all 96
  // institutions had negotiated a zero English commission.
  //
  // Held per PROVIDER rather than per programme because a commission agreement is
  // negotiated with an institution, not course by course. The programme flag says
  // WHICH courses it applies to; this says WHAT the rate is.
  commissionEnglishY1Type  CommissionType?
  commissionEnglishY1Value Float?
  commissionEnglishY2Type  CommissionType?
  commissionEnglishY2Value Float?
  volumeTarget             Float?
  bonusType                CommissionType?
  bonusValue               Float?
  notes                    String?
  // PR-PHASE32 — recommendation enrichment (v1 rich). Descriptions/aboutUrl are
  // AI-seeded → staff-approved; ranking* is STAFF-ENTERED ONLY (never AI-invented
  // — fabrication risk on a compliance-sensitive claim). Shown to applicants only
  // once the provider is APPROVED (status).
  descriptionEn            String?
  aboutUrl                 String?
  rankingTier              String?
  rankingScore             Float?
  rankingSource            String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  faculties         EducationFaculty[]
  programmes        EducationProgramme[]
  applications      Application[]
  commissions       Commission[]
  scholarships      ProviderScholarship[]
  tuitions          ProviderTuition[] // PR-EXPLORE — nationality-scoped tuition rates
  candidates        ProgrammeCandidate[] // PR-CATALOG-2 — new-programme discovery candidates
  nationalityGroups NationalityGroup[] // PR-PROVIDER-PORTAL slice E
  marketingAssets   ProviderMarketingAsset[] // PR-PROVIDER-PORTAL — brand/recruitment files

  @@map("education_providers")
}

model EducationFaculty {
  id         String   @id @default(cuid())
  providerId String
  name       String
  createdAt  DateTime @default(now())

  provider   EducationProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programmes EducationProgramme[]

  @@index([providerId])
  @@map("education_faculties")
}

model EducationProgramme {
  id                      String              @id @default(cuid())
  providerId              String
  facultyId               String?
  name                    String
  level                   QualificationLevel
  nzqfLevel               NZQFLevel
  durationMonths          Int?
  tuitionFeeNZD           Float?
  currency                String              @default("NZD")
  intakeMonths            Int[]
  aiPopulated             Boolean             @default(false)
  aiLastRunAt             DateTime?
  reviewStatus            ReviewStatus        @default(PENDING)
  isActive                Boolean             @default(false)
  // PR-CATALOG-1 — provenance. Excel import → MANUAL_EXCEL; hand-added via API →
  // MANUAL_ENTRY; a future automated web check → AUTOMATED_WEB_CHECK. sourceRef =
  // the import batch id or the source URL.
  source                  ProgrammeSource     @default(MANUAL_ENTRY)
  sourceRef               String?
  // PR-PHASE32 — recommendation enrichment (AI-seeded → staff-approved).
  descriptionEn           String?
  descriptionFa           String?
  careerOutcomes          String[]
  highlights              String[]
  // PR-PHASE34 — imported source fields (NZ ITP/University/PTE programme data).
  majorStrand             String?
  qualificationType       String? // raw source label, e.g. "New Zealand Certificate", "Bachelor's Degree"
  deliveryMode            String? // On-campus / Blended / Online
  studentVisaSuitable     Boolean?
  // PR-ENGLISH-COMMISSION — is this an English-language course (ELICOS / EAP)?
  //
  // Deliberately a separate flag and NOT a new QualificationLevel value.
  // QualificationLevel is an academic LADDER: qualLevel() maps NZQF levels onto
  // it, ProviderTuition rows match on it, and the Q30 progression rule reasons
  // about moving up it. An English course is not a rung on that ladder — adding
  // one would silently change level-based tuition matching and progression for
  // every caller, to express something that is a course TYPE.
  //
  // Default false: every existing row keeps exactly its current behaviour.
  isEnglishLanguageCourse Boolean             @default(false)
  campusCity              String? // per-programme campus (may differ from provider.city)
  durationText            String? // raw source, e.g. "1 year", "18 weeks"
  feeBasis                String? // per year / whole programme / per credit
  feeYear                 Int? // the year the fee applies to (tracked separately from intake year)
  fee2027Status           String? // confirmed / projected
  scholarshipNote         String? // free-text (NOT the nationality-scoped ProviderScholarship)
  // PR-EXPLORE — Owner-uploaded cover image shown on the Explore map result cards
  // and the programme detail page. Stores the object key/URL produced by the normal
  // signed-upload path (image mime-types only, size-capped); never a raw client URL.
  coverImageUrl           String?
  // PR-IMPORT — verbatim source text. Kept ALONGSIDE the structured fields, never
  // instead of them: the source states fees conditionally often enough
  // ("$13,286 per 60 credits or $26,572 per 120 credits") that flattening to one
  // number would quote a price the institution never published. tuitionFeeNZD is
  // populated only when the source states one unambiguous, plausible figure;
  // tuitionParseNote records why it was left null otherwise.
  tuitionFeeRaw           String?
  tuitionParseNote        String?
  // Long free-text requirement columns. ProgrammeRequirement keeps the STRUCTURED
  // matching values (minGpa, englishOverallMin); these hold what the institution
  // actually published, which is richer than the matcher needs.
  academicPrerequisites   String?
  englishRequirementRaw   String?
  otherRequirements       String?
  // Intake columns as published. ProgrammeIntake holds the structured intakes.
  remaining2026Intakes    String?
  published2027Intakes    String?
  // ITP file only — extra 2027 planning columns absent from PTE/University.
  projected2027Intakes    String?
  intakeBasis2027         String?
  intakes2027Planning     String?
  // PR-IMPORT — the institution's OWN Subject Area label, verbatim from its source
  // workbook ("Subject Area" / "Subject Area (Faculty)"). Per-institution, NOT a
  // shared taxonomy: the curation tabs are simply the distinct values a given
  // institution's own rows contain. Blank in the source → grouped as "Unspecified".
  subjectAreaRaw          String?
  // PR-EXPLORE — Staff/Owner manual override for the "Related videos" block. When
  // NON-EMPTY these replace the ContentMatchingAgent's picks entirely (never merged),
  // so a corrected match cannot have the agent's choices reappear beside it. Stores
  // bare YouTube video ids; staff may paste full URLs and the API normalises them.
  manualVideoIds          String[]            @default([])
  programmeUrl            String? // official programme page — RAG monitoring source #1
  verificationSourceUrl   String? // secondary verification source — RAG monitoring source #2
  verifiedAt              DateTime?
  verificationStatus      VerificationStatus? // data-verification state (≠ reviewStatus)
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  provider            EducationProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  faculty             EducationFaculty?          @relation(fields: [facultyId], references: [id])
  requirements        ProgrammeRequirement?
  applications        Application[]
  commissions         Commission[]
  admissionChoices    AdmissionProgrammeChoice[]
  scholarships        ProviderScholarship[]
  tuitions            ProviderTuition[] // PR-EXPLORE — nationality-scoped tuition rates
  articles            ProgrammeArticle[] // PR-CURATION — title+URL reading list
  studyFields         ProgrammeStudyField[]
  intakes             ProgrammeIntake[]
  // PR-RECS-1 — persisted recommendation-list snapshots referencing this
  // programme. Virtual back-relation (FK on recommendation_items.programmeId).
  recommendationItems RecommendationItem[]
  // PR-CATALOG-1 — proposed changes awaiting Owner review (Piece 2 producer).
  changeProposals     ProgrammeChangeProposal[]

  @@index([providerId])
  @@index([level])
  @@index([reviewStatus])
  @@map("education_programmes")
}

// ─── PR-PHASE32 — StudyField taxonomy (matching + Q30 field-relatedness) ──────
// Canonical field-of-study vocabulary tagged on BOTH the questionnaire (Q13/Q32)
// and programmes. Anchors: (a) field→programme matching, (b) the Q30 progression
// constraint, (c) the deferred per-field YouTube feature (reserved columns).

model StudyFieldCategory {
  id               String   @id @default(cuid())
  key              String   @unique
  nameEn           String
  nameFa           String
  // TRUE only for "Management & Business" — its fields are always selectable at
  // Q32 regardless of the applicant's prior-qualification field (Q13).
  alwaysSelectable Boolean  @default(false)
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fields StudyField[]

  @@map("study_field_categories")
}

model StudyField {
  id                String   @id @default(cuid())
  key               String   @unique
  nameEn            String
  nameFa            String
  categoryId        String
  // Preserves q16's per-field scoring weight (0–4) so the scoring engine stays
  // byte-identical when Q13's field options are backed by this taxonomy.
  backgroundWeight  Int      @default(0)
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  // RESERVED — deferred YouTube per-field explainer + evergreen videos. Not built.
  explainerVideoId  String?
  evergreenVideoIds String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category      StudyFieldCategory    @relation(fields: [categoryId], references: [id])
  relationsFrom StudyFieldRelation[]  @relation("SourceField")
  relationsTo   StudyFieldRelation[]  @relation("TargetField")
  programmes    ProgrammeStudyField[]

  @@index([categoryId])
  @@map("study_fields")
}

// Directed edge: an applicant whose prior qualification is in `sourceField` MAY
// progress to `targetField` at Q32. AI-seeded → staff-approved (reviewStatus).
model StudyFieldRelation {
  id            String       @id @default(cuid())
  sourceFieldId String
  targetFieldId String
  reviewStatus  ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  updatedById   String?

  sourceField StudyField @relation("SourceField", fields: [sourceFieldId], references: [id], onDelete: Cascade)
  targetField StudyField @relation("TargetField", fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@unique([sourceFieldId, targetFieldId])
  @@index([sourceFieldId])
  @@map("study_field_relations")
}

// A programme may span more than one field; `isPrimary` marks the main one.
model ProgrammeStudyField {
  programmeId  String
  studyFieldId String
  isPrimary    Boolean @default(false)

  programme  EducationProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  studyField StudyField         @relation(fields: [studyFieldId], references: [id], onDelete: Cascade)

  @@id([programmeId, studyFieldId])
  @@index([studyFieldId])
  @@map("programme_study_fields")
}

// PR-UNIVERSITIES — a scholarship Sorena can offer for a provider, scoped by
// applicant NATIONALITY (ISO code) and optionally to a specific programme or a
// qualification level. Owner-managed institutional reference data that feeds the
// commissions context and (future) AI offer-generation / recommendation engine.
// Amount reuses CommissionType: PERCENTAGE (of tuition) or FIXED (in `currency`).
model ProviderScholarship {
  id                 String              @id @default(cuid())
  providerId         String
  /// PR-PROVIDER-PORTAL slice E — nullable since groups arrived. EXACTLY ONE of
  /// `nationality` and `nationalityGroupId` is set, enforced by a CHECK
  /// constraint in the migration (Prisma cannot express it) and re-checked in the
  /// service so the error a provider sees is a sentence rather than a constraint
  /// name. Neither set would be a row that applies to nobody; both set would be a
  /// row whose meaning depends on which field the reader looks at first.
  nationality        String? // ISO country code of the applicant nationality it applies to
  nationalityGroupId String?
  programmeId        String? // optional — scope to a single programme
  level              QualificationLevel? // optional — scope to a qualification level
  name               String
  amountType         CommissionType      @default(FIXED)
  amountValue        Float
  currency           String              @default("NZD")
  eligibilityNotes   String?
  isActive           Boolean             @default(true)
  /// PR-PROVIDER-PORTAL slice A — pricing must be reviewed before a student sees it.
  ///
  /// Programmes have had this gate since the catalogue import existed; tuition and
  /// scholarships had only `isActive`, which is an on/off switch an uploader
  /// controls, not a second pair of eyes. That was the commercially sensitive gap:
  /// a spreadsheet could put a price in front of a client in one step.
  ///
  /// Defaults to PENDING for EVERY new row regardless of who created it. One
  /// review standard, not two tiers of trust — a staff upload is gated exactly
  /// like a future provider submission. This is a deliberate workflow change:
  /// uploading no longer makes a price live.
  reviewStatus       ReviewStatus        @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  provider         EducationProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programme        EducationProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  /// Restrict, NOT SetNull: nulling the reference would leave a row with neither
  /// a nationality nor a group — a row that applies to nobody, and one the
  /// resolver would silently skip on its way to the flat fee. Blocking the delete
  /// makes the provider decide what those rates should say.
  nationalityGroup NationalityGroup?   @relation(fields: [nationalityGroupId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([nationality])
  @@index([nationalityGroupId])
  @@map("provider_scholarships")
}

/// PR-PROVIDER-PORTAL — marketing material an institution sends us.
///
/// Logos, brochures, prospectuses, photography — files for Sorena's marketing and
/// recruitment use, NOT student-facing catalogue data. Nothing here is read by
/// the matcher, the resolver or the Explore page.
///
/// STORAGE follows the programme-cover-image precedent exactly: the bytes go to
/// R2 under a key this service derives, and the KEY is what is stored. There is
/// no public URL column, and downloads are issued as short-lived presigned URLs,
/// so an asset cannot leak by someone guessing a path.
///
/// reviewStatus: PENDING by default. Every provider-submitted thing in this
/// portal is reviewed before it is used — prices, programmes, and now this. See
/// the phase doc for the precedent either way; the gate is one line to remove if
/// the Owner decides marketing assets do not need one.
model ProviderMarketingAsset {
  id           String       @id @default(cuid())
  providerId   String
  /// The R2 object key. Never a URL — see above.
  r2Key        String       @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  /// The institution's own note about what this is ("2027 prospectus").
  label        String?
  reviewStatus ReviewStatus @default(PENDING)
  /// Retired rather than deleted, like every other file-bearing row here.
  isActive     Boolean      @default(true)
  uploadedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  provider   EducationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  uploadedBy User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([reviewStatus])
  @@map("provider_marketing_assets")
}

/// PR-PROVIDER-PORTAL slice E — an institution's own shorthand for a set of
/// nationalities ("South Asia", "EU/EEA"), so one rate can cover twenty countries
/// without twenty rows.
///
/// A group carries NO money and therefore NO review gate: it is a name and a list
/// of country codes. The RATE attached to a group is a ProviderTuition or
/// ProviderScholarship row and is gated exactly like every other rate. That is the
/// same boundary as today — reviewing "these 20 countries are called South Asia"
/// would be reviewing a label.
///
/// Codes are a String[] of ISO 3166-1 alpha-2, matching how nationality is stored
/// on the pricing rows themselves; a join table would add a hop for a list that is
/// only ever read whole.
model NationalityGroup {
  id            String    @id @default(cuid())
  providerId    String
  name          String
  nationalities String[]
  /// PR-PROVIDER-PORTAL — ARCHIVED, not deleted.
  ///
  /// The rows that reference a group hold a RESTRICT foreign key, so a hard
  /// delete was refused whenever any price had ever pointed at it — including
  /// prices the institution had already cleared. Archiving retires the group
  /// without touching a single priced row: it leaves the active list, cannot be
  /// chosen for new pricing, and every rate it ever carried stays exactly where
  /// it is, still resolvable and still auditable.
  ///
  /// A timestamp rather than a boolean: "when was this retired" is the question
  /// asked afterwards, and a boolean cannot answer it.
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  provider     EducationProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tuitions     ProviderTuition[]
  scholarships ProviderScholarship[]

  /// One institution cannot have two ACTIVE groups called the same thing — the
  /// name is how their own staff tell them apart on the rate screen. The
  /// constraint stays on (providerId, name) because Postgres cannot express a
  /// partial unique index through Prisma; the service therefore checks the clash
  /// against ACTIVE groups only and renames an archived namesake out of the way,
  /// so retiring "South Asia" does not permanently burn the name.
  @@unique([providerId, name])
  @@index([providerId])
  @@map("nationality_groups")
}

// PR-EXPLORE (Round 3) — nationality-scoped tuition. Deliberately shaped like
// ProviderScholarship so the two Excel uploads, the two parsers and the two
// resolvers stay structurally identical.
//
// EducationProgramme.tuitionFeeNZD is NOT replaced — it remains the explicit
// DEFAULT/fallback used when no row here matches the student's nationality.
// resolveStudentTuition() reports which of the two it used, so a fallback is
// never silent.
//
// Unlike scholarships, tuition is a single applicable figure, not a sum: when
// several rows match, the most SPECIFIC one wins (programme+level > programme >
// level > provider-wide), and ties break on the most recent feeYear.
model ProviderTuition {
  id                 String              @id @default(cuid())
  providerId         String
  programmeId        String? // null = applies to any programme of the provider
  level              QualificationLevel? // null = applies to any level
  /// PR-PROVIDER-PORTAL slice E — see ProviderScholarship.nationality. Exactly one
  /// of this and `nationalityGroupId` is set; the CHECK constraint lives in the
  /// migration.
  nationality        String? // ISO 3166-1 alpha-2 of the applicant nationality
  nationalityGroupId String?
  amountValue        Float
  currency           String              @default("NZD")
  // Same per-year/term granularity as the scholarship sheets — Yashua uploads
  // both for an institution in one sitting.
  feeYear            Int?
  term               String?
  notes              String?
  isActive           Boolean             @default(true)
  /// PR-PROVIDER-PORTAL slice A — pricing must be reviewed before a student sees it.
  ///
  /// Programmes have had this gate since the catalogue import existed; tuition and
  /// scholarships had only `isActive`, which is an on/off switch an uploader
  /// controls, not a second pair of eyes. That was the commercially sensitive gap:
  /// a spreadsheet could put a price in front of a client in one step.
  ///
  /// Defaults to PENDING for EVERY new row regardless of who created it. One
  /// review standard, not two tiers of trust — a staff upload is gated exactly
  /// like a future provider submission. This is a deliberate workflow change:
  /// uploading no longer makes a price live.
  reviewStatus       ReviewStatus        @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  provider         EducationProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programme        EducationProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  /// Restrict — see the note on ProviderScholarship.nationalityGroup.
  nationalityGroup NationalityGroup?   @relation(fields: [nationalityGroupId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([nationality])
  @@index([nationalityGroupId])
  @@index([programmeId])
  @@map("provider_tuitions")
}

// PR-CURATION — related reading for a programme, shown on the student detail page.
// Owner decision: a simple ordered list of title + URL pairs. No rich text.
model ProgrammeArticle {
  id          String   @id @default(cuid())
  programmeId String
  title       String
  url         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  programme EducationProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId])
  @@map("programme_articles")
}

model ProgrammeRequirement {
  id                     String       @id @default(cuid())
  programmeId            String       @unique
  minQualificationLevel  String?
  minGpa                 Float?
  englishTestType        String?
  englishOverallMin      Float?
  englishComponentMins   Json?
  workExperienceRequired Boolean      @default(false)
  portfolioRequired      Boolean      @default(false)
  interviewRequired      Boolean      @default(false)
  documentsRequired      String[]
  additionalNotes        String?
  // PR-PHASE34 — raw source requirement text (kept verbatim; englishOverallMin is
  // parsed from englishRequirementText where it's cleanly extractable).
  englishRequirementText String?
  academicPrerequisites  String?
  otherRequirements      String?
  aiPopulated            Boolean      @default(false)
  reviewStatus           ReviewStatus @default(PENDING)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  programme EducationProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@map("programme_requirements")
}

// PR-PHASE34 — one intake occurrence for a programme. Distinct rows for remaining
// 2026, published 2027, and projected 2027 dates; `needsReconfirmation` is set for
// PROJECTED intakes (source Data Rules require reconfirmation before application).
model ProgrammeIntake {
  id                  String      @id @default(cuid())
  programmeId         String
  year                Int
  label               String // date or month text, e.g. "Feb 2027", "17 Feb 2026"
  basis               IntakeBasis
  needsReconfirmation Boolean     @default(false)
  createdAt           DateTime    @default(now())

  programme EducationProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId])
  @@index([year, basis])
  @@map("programme_intakes")
}

// ─── CRM EVENTS ──────────────────────────────────────────────────────────────

model CrmEvent {
  id               String                @id @default(cuid())
  eventType        String
  entityType       String?
  entityId         String?
  leadId           String?
  triggerSource    EventSource           @default(SYSTEM)
  actorType        String?
  actorId          String?
  payloadJson      Json?
  processingStatus EventProcessingStatus @default(PENDING)
  occurredAt       DateTime              @default(now())

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([eventType])
  @@index([leadId])
  @@index([occurredAt])
  @@map("crm_events")
}

// ─── WHATSAPP ────────────────────────────────────────────────────────────────

model WhatsAppConversation {
  id            String                     @id @default(cuid())
  contactId     String?
  phoneNumber   String
  status        WhatsAppConversationStatus @default(NEW)
  assignedToId  String?
  lastMessageAt DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  contact  Contact?          @relation(fields: [contactId], references: [id])
  messages WhatsAppMessage[]

  @@index([phoneNumber])
  @@index([status])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  content        String?
  messageType    String           @default("text")
  status         String?
  waMessageId    String?          @unique
  timestamp      DateTime         @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("whatsapp_messages")
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  // PR-DASH-1: structured event type that maps to a client-dashboard
  // activity-feed i18n key (STEP_STARTED / STEP_SAVED / DOCUMENT_RECORDED
  // / DOCUMENT_REMOVED / STATUS_CHANGED). Nullable on existing rows —
  // the dashboard read endpoint falls back to deriving the event type
  // from the `action` string for rows written before this PR. Future
  // mutation paths should populate this directly.
  eventType  String?
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // PR-CONSULT-4: actor name + role snapshot. Populated either at
  // write-time (new audit paths under this PR) or at delete-time
  // by the hard-delete service, so audit history attributes the
  // action correctly even after the actor row is gone. Older audit
  // rows leave both null; the summary helper falls back to
  // "(Removed user)" when the User join returns null AND the
  // snapshot is null.
  actorNameSnapshot String?
  actorRoleSnapshot String?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  // Phase 8 — weekly client digest. The digest gather query filters
  // by `entityId = ? AND createdAt >= ? AND createdAt < ?` for Pass A
  // (case-scoped events keyed on caseId) and `entityId IN (small list)
  // AND createdAt range` for Pass B (PAYMENT / DOCUMENT / VisaMeeting /
  // VisaSupportTicket events). entityId is highly selective per row
  // (vs entityType which has a handful of distinct values), so a
  // composite leading with entityId lets Postgres do an index seek per
  // id then range-scan createdAt — much narrower than a type-led index.
  @@index([entityId, createdAt])
  @@map("audit_logs")
}

// ─── KNOWLEDGE BASE (for RAG / pgvector) ─────────────────────────────────────

model KnowledgeChunk {
  id         String   @id @default(cuid())
  sourceType String
  sourceId   String?
  sourceUrl  String?
  content    String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sourceType])
  @@map("knowledge_chunks")
}

// ─── TICKETS / IN-PORTAL MESSAGES ─────────────────────────────────────────────

model Ticket {
  id           String                @id @default(cuid())
  caseId       String?
  contactId    String
  subject      String
  status       TicketStatus          @default(OPEN)
  priority     TicketPriority        @default(NORMAL)
  // PR-CO-KANBAN — department routing for a staff/CO-raised ticket. Reuses the
  // VisaTicketDepartment enum so routing matches the visa-support queue. Nullable:
  // existing (student admission) tickets predate it and don't set it.
  department   VisaTicketDepartment?
  assignedToId String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  closedAt     DateTime?

  case       Case?           @relation(fields: [caseId], references: [id])
  contact    Contact         @relation(fields: [contactId], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy  User            @relation("TicketCreator", fields: [createdById], references: [id])
  messages   TicketMessage[]

  @@index([contactId])
  @@index([caseId])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String
  body        String
  attachments String[]
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("TicketMessageSender", fields: [senderId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// PR-PHASE40 — the daily USD→NZD rate, fetched once a day and read from here
// by every invoice raised that day.
//
// Cached rather than fetched per invoice, deliberately: two invoices raised
// minutes apart must not carry different rates, and IRD wants "the rate at the
// time of supply", which in practice is a published daily rate — not whatever a
// live API happened to return mid-transaction. It also means an outage at the
// rate provider cannot block a client from paying.
//
// Append-only in practice: one row per (base, quote, rateDate), never updated,
// so the rate a historical invoice used stays exactly what it was.
model ExchangeRate {
  id            String   @id @default(cuid())
  /// ISO 4217, uppercase. USD for everything today.
  baseCurrency  String
  quoteCurrency String
  /// Units of quote per 1 base. 6 dp is well beyond FX quoting precision.
  rate          Decimal  @db.Decimal(12, 6)
  /// The DAY this rate represents, not the moment it was entered.
  rateDate      DateTime @db.Date
  /// Where the number came from: 'manual-entry' for everything a Finance Admin
  /// types, 'open.er-api.com' for the one seeded row that predates manual entry.
  source        String
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  /// Who typed it. Nullable because the seeded row has no author, and because a
  /// deleted staff account must not take an accounting record with it — hence a
  /// plain id + a name SNAPSHOT rather than a relation.
  enteredByUserId String?
  enteredByName   String?

  // Deliberately NOT unique on (base, quote, rateDate): this is an append-only
  // ledger. A Finance Admin correcting a rate twice in one morning must leave
  // two rows, both readable afterwards — an upsert would silently destroy the
  // number an already-issued invoice was stamped with.
  @@index([baseCurrency, quoteCurrency, rateDate])
  @@map("exchange_rates")
}

// ─── INVOICES & PAYMENTS ──────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  caseId        String?
  contactId     String
  invoiceNumber String        @unique
  description   String
  /// The BASE price, before GST and before any card fee. Unchanged in meaning
  /// by PR-PHASE40 — the new columns sit alongside it rather than folding into
  /// it, so `amount` is still what the service is worth.
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(DRAFT)

  // PR-PHASE40 — the parts of the total, stored separately because accounting
  // needs them apart: GST is tax collected for IRD, the card fee is a
  // pass-through of Stripe's charge, and neither is revenue.
  //
  // Decimal to match `amount` (the Payment model uses cents; this one has
  // always used Decimal dollars and changing that would rewrite every reader).
  //
  // Nullable: rows written before this migration have no breakdown, and
  // back-filling a GST figure that was never charged would be inventing a tax
  // record.
  gstAmount     Decimal? @db.Decimal(10, 2)
  /// NULL for bank transfer — an invoice paid by transfer must never carry a
  /// fee the client did not incur.
  cardFeeAmount Decimal? @db.Decimal(10, 2)

  // PR-PHASE40 — FX audit trail. NZ GST is assessed in NZD while these invoices
  // are denominated in USD, so the rate used to convert has to be recorded at
  // the moment of issue: reconstructing it later from a rate table is a guess,
  // and IRD wants the rate at the time of supply. Stamped at invoice creation.
  exchangeRateUsed      Decimal?  @db.Decimal(12, 6)
  exchangeRateSource    String?
  exchangeRateTimestamp DateTime?
  dueDate               DateTime?
  issuedAt              DateTime?
  paidAt                DateTime?
  stripeInvoiceId       String?   @unique
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Piece #2 — client payment-receipt upload (bank transfer / partner exchange).
  // Denormalised onto Invoice (mirrors Case.inzReceipt* — there's only ever one
  // engagement-fee receipt per invoice). `receiptUploadedAt IS NOT NULL` is the
  // "processing / awaiting accountant confirmation" state — NOT paid; no new
  // InvoiceStatus value, so the Stripe reconciliation (SENT/OVERDUE→PAID) is
  // untouched. File lives on local disk under ./uploads/receipts/, served via
  // the signed-token /files/signed/:token route (owner-gated at the mint step).
  receiptFileUrl      String?
  receiptOriginalName String?
  receiptMimeType     String?
  receiptSizeBytes    Int?
  receiptMethod       String?
  receiptUploadedAt   DateTime?

  case    Case?   @relation(fields: [caseId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@index([status])
  @@map("invoices")
}

// PR-LIA-AUTO-ASSIGN Phase 6 — Stripe-webhook-event payment log.
//
// One row per `paymentIntent.succeeded` event from Stripe. The unique
// constraint on `stripePaymentIntentId` is the idempotency key: when
// Stripe retries a webhook (it will, on any non-2xx response or just
// at random), the `prisma.payment.create` call hits a P2002 collision
// and the handler short-circuits the rest of the work (no double
// emails, no double `assignLiaToCase`, no double `activateSubscription`).
//
// `leadId` is always set — every Stripe link is created with the lead
// in metadata. `caseId` is optional: the ACCOUNT_OPENING charge sets it
// (since the contract was just signed and the case is known); the
// consultation and subscription flows don't.
//
// `paymentType` is the discriminator written into the Stripe link
// metadata at creation time. Today's known values: 'ACCOUNT_OPENING',
// 'consultation', 'subscription'. When the webhook receives metadata
// it doesn't recognise we record 'unknown' rather than silently drop —
// downstream queries can use that to flag suspect events for review.
//
// `metadata` snapshots the full Stripe-side metadata blob so we can
// reconstruct what link produced the charge without going to Stripe.
model Payment {
  id                    String  @id @default(cuid())
  stripePaymentIntentId String  @unique
  leadId                String
  caseId                String?
  paymentType           String
  amount                Int
  currency              String  @default("usd")
  status                String

  // PR-PHASE40 — the invoice arithmetic, stored in parts rather than as one
  // total. Accounting needs the GST separately (it is tax collected on behalf
  // of IRD, not revenue), and the card fee separately (it is a pass-through of
  // Stripe's charge, not income either). All INTEGER CENTS, matching `amount`.
  //
  // Nullable because every row written before this migration has no breakdown
  // to record, and inventing one retrospectively would be a fabricated tax
  // figure. `amount` keeps meaning exactly what it always meant.
  gstCents     Int?
  cardFeeCents Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Phase 6.5 — finance verification workflow.
  //
  // verifiedById is a plain nullable String with NO Prisma relation,
  // following the existing CrmEvent.actorId convention — a relation
  // would force a back-relation field on the User model, which Phase
  // 6.5 explicitly avoids.
  //
  // receiptDocumentId stays nullable at the DB level even though the
  // app REQUIRES a receipt for new manual payments: existing Stripe
  // rows have no receipt, so a NOT NULL column would break them. The
  // service layer enforces "receipt required when paymentType=manual".
  verificationStatus PaymentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNote   String?
  receiptDocumentId  String?

  lead Lead  @relation(fields: [leadId], references: [id])
  case Case? @relation(fields: [caseId], references: [id])

  @@index([leadId])
  @@index([caseId])
  @@map("payments")
}

// ─── ADMISSION FORM ───────────────────────────────────────────────────────────

enum AdmissionApplicationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AdmissionDocumentType {
  PASSPORT
  NZ_VISA_HISTORY
  VISA_REFUSAL_LETTER
  ENGLISH_TEST_EVIDENCE
  EDUCATION_TRANSCRIPTS
  SUPPORTING_DOCUMENT
  NOTARIZED_CERTIFICATE
  NOTARIZED_TRANSCRIPT
  VISA_PHOTO
  VISA_POLICE_CERTIFICATE
}

model AdmissionApplication {
  id                 String                     @id @default(cuid())
  caseId             String
  contactId          String
  agentId            String?
  status             AdmissionApplicationStatus @default(DRAFT)
  currentStep        Int                        @default(1)
  // PR-INTAKE-1 (Slice 3) — set true only in the no-valid-next-intake edge case at
  // submit: the auto-reassignment could not pick a term, so this needs manual
  // intervention (surfaced as an urgent AdmissionTask + this visible flag).
  intakeReviewNeeded Boolean                    @default(false)
  submittedAt        DateTime?
  lockedAt           DateTime?
  termsAgreedAt      DateTime?

  // Step 2 — Additional student info
  // dateOfBirth is plaintext for now; candidate for encryption in a future
  // SEC PR (same envelope as the PR-SEC3 fields). Marital status and
  // hasChildren are not PII-sensitive enough to warrant encryption.
  dateOfBirth                 DateTime?
  maritalStatus               String?
  hasChildren                 Boolean?
  phone                       String?
  phoneType                   String?
  countryOfBirth              String?
  citizenship                 String?
  ethnicity                   String?
  passportNumberEncrypted     Bytes?
  visaRefused                 Boolean?
  visaRefusalDetailsEncrypted Bytes?

  // Step 3A — English proficiency
  englishTestSat   Boolean?
  englishTestName  String?
  englishPreCourse Boolean?

  // Step 3B — Health
  hasDisability              Boolean?
  disabilityDetailsEncrypted Bytes?
  needsEvacAssistance        Boolean?
  evacDetailsEncrypted       Bytes?
  medicalNotesEncrypted      Bytes?
  otherStudyNotesEncrypted   Bytes?

  // Step 3C — Education background
  schoolCountry          String?
  schoolName             String?
  schoolQualification    String?
  qualificationCompleted Boolean?
  qualYearStart          Int?
  qualYearEnd            Int?
  lastYearOfSchool       Int?
  highestQualification   String?

  // Step 3D — Funding
  sponsorshipProgramme String?

  // Step 5 — Parent / guardian (emergency contact)
  guardianRelationship       String?
  guardianFirstNameEncrypted Bytes?
  guardianLastNameEncrypted  Bytes?
  guardianEmail              String?
  guardianMobileEncrypted    Bytes?
  guardianHomePhoneEncrypted Bytes?
  guardianAddressSameAs      Boolean?
  guardianStreetEncrypted    Bytes?
  guardianSuburbEncrypted    Bytes?
  guardianCity               String?
  guardianState              String?
  guardianCountry            String?
  guardianPostcodeEncrypted  Bytes?

  // Step 6 — Accommodation
  accommodationType String?

  // Step 7 — Agent / counsellor (only when agentId is set)
  counsellorFirstNameEncrypted Bytes?
  counsellorLastNameEncrypted  Bytes?
  counsellorEmail              String?
  anotherBranch                Boolean?
  branchAgentCode              String?
  branchName                   String?
  agentDeclarationAgreed       Boolean?
  agentCommentsEncrypted       Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case              Case                       @relation(fields: [caseId], references: [id])
  contact           Contact                    @relation(fields: [contactId], references: [id])
  agent             User?                      @relation("ApplicationAgent", fields: [agentId], references: [id])
  programmeChoices  AdmissionProgrammeChoice[]
  educationEntries  AdmissionEducationEntry[]
  employmentEntries AdmissionEmploymentEntry[]
  documents         AdmissionDocument[]
  visaApplication   VisaApplication?

  @@index([caseId])
  @@index([contactId])
  @@index([status])
  @@map("admission_applications")
}

model AdmissionEducationEntry {
  id                     String   @id @default(cuid())
  admissionApplicationId String
  qualificationLevel     String
  institutionName        String
  country                String
  // fieldOfStudy is required at the application layer (PR-C1) but stays
  // nullable in the DB to accept legacy rows that pre-date the requirement.
  fieldOfStudy           String?
  startYear              Int?
  endYear                Int?
  completed              Boolean  @default(false)
  // PR-C1: student indicates "I have not received the certificate yet".
  // Informational for now; the submit-gate that uses it ships in PR-C2.
  certificateNotReceived Boolean  @default(false)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  admissionApplication AdmissionApplication     @relation(fields: [admissionApplicationId], references: [id], onDelete: Cascade)
  documents            AdmissionDocument[]
  visaSupplement       VisaEducationSupplement?

  @@index([admissionApplicationId])
  @@map("admission_education_entries")
}

// PR-ADMISSION-CVDATA (Step 2a) — real, structured employment history captured at the
// ADMISSION stage (client-editable), so the AI CV's Experience section uses verified data
// (employer/title/dates) instead of coded scorecard buckets. Admission-primary, mirroring
// AdmissionEducationEntry: it holds year-level data the client provides; a future visa-stage
// supplement/pre-fill (like VisaEducationSupplement over education) REUSES these rows so
// nothing is asked twice. Field names mirror VisaEmploymentEntry for frictionless reuse.
// NOTE (fast-follow, NOT this slice): wire visa Step-7 employment to pre-fill from these rows.
model AdmissionEmploymentEntry {
  id                     String   @id @default(cuid())
  admissionApplicationId String
  employerName           String
  roleTitle              String
  // Year-level like education (the client may not know exact months yet; refine over time).
  startYear              Int?
  endYear                Int? // null when isCurrent
  isCurrent              Boolean  @default(false)
  countryOfWork          String?
  organisationField      String? // industry / sector
  dutiesText             String? // short client-provided description (optional)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  admissionApplication AdmissionApplication @relation(fields: [admissionApplicationId], references: [id], onDelete: Cascade)

  @@index([admissionApplicationId])
  @@map("admission_employment_entries")
}

// PR-ADMISSION-CV (step 2b) — an AI-generated CV, reviewed/edited/approved by the Admission
// Specialist. Versioned per case (mirrors RecommendationList's supersede-on-regenerate +
// AdmissionApplication's status-guard lock): regenerate supersedes the prior DRAFT and mints a
// new version; approve LOCKS that version (no further edits); a later regenerate makes v+1.
// contentJson holds the editable CV sections; the FACTUAL sections (header/education/experience)
// are assembled deterministically from verified rows — the AI only writes summary/skills — so a
// document sent to universities can never contain a fabricated employer or date.
// sourceSnapshotJson records what fed generation (audit/reproducibility).
enum CvStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model CvDocument {
  id                 String    @id @default(cuid())
  caseId             String
  version            Int
  status             CvStatus  @default(DRAFT)
  contentJson        Json
  sourceSnapshotJson Json
  model              String? // Claude model used for the narrative parts
  generatedById      String?
  generatedAt        DateTime  @default(now())
  editedAt           DateTime?
  approvedById       String?
  approvedAt         DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@map("cv_documents")
}

model AdmissionProgrammeChoice {
  id                     String    @id @default(cuid())
  admissionApplicationId String
  programmeId            String
  intakeMonth            Int
  intakeYear             Int
  priority               Int
  /// The day the student first attended class on THIS programme.
  ///
  /// PR-COMMISSION-TRIGGER — a student starts classes on a programme, not on a
  /// case, so it sits here beside the commission and the trigger rather than on
  /// the case. Null until someone confirms it happened; nothing infers it from
  /// an intake month, because an intake is when a term starts and this is
  /// whether a particular person turned up.
  ///
  /// Commission eligibility is computed from this on read — 14 days after this
  /// date — so there is no stored "eligible" flag to fall out of date and no
  /// job to keep it current.
  firstClassAttendedAt   DateTime?
  createdAt              DateTime  @default(now())

  admissionApplication AdmissionApplication @relation(fields: [admissionApplicationId], references: [id], onDelete: Cascade)
  programme            EducationProgramme   @relation(fields: [programmeId], references: [id])
  sopDocuments         SopDocument[]
  submissionRecords    SubmissionRecord[]
  offerRecords         OfferRecord[]
  commission           Commission?
  commissionTriggers   CommissionTrigger[]

  @@index([admissionApplicationId])
  @@map("admission_programme_choices")
}

// PR-ADMISSION-SOP (step 3) — an AI-generated Statement of Purpose, reviewed/edited/approved by
// the Admission Specialist. ONE SOP per (case, programme choice): each is localized to the
// specific institution/programme/intake the client submitted, so the reasoning is genuinely
// institution-specific. Versioned exactly like CvDocument (supersede-DRAFT-on-regenerate;
// approve LOCKS that version; a later regenerate mints v+1). Generation is GATED to submitted
// applications (shared finality point with Step 4), like the CV.
//
// Truthfulness: the SOP is a prose document, so it can't be assembled deterministically like the
// CV — but the FACTUAL FRAME (applicant name + the target institution/programme/intake + a
// verified profile line) is assembled from real rows and the AI narrative can never alter it; the
// target institution SHAPES the narrative body only. contentJson = the editable factual frame +
// labeled narrative sections; sourceSnapshotJson = what fed generation (audit).
//
// Quality gates (Owner decision 2026-08-03): three gates — career-plan specificity, NZ-specific
// reasoning, home ties — are AI-scored with an adversarial rubric and RE-EVALUATED against the
// current (possibly hand-edited) content at approve time. When the case's country
// CountryAIConfig.sopGateEnforcement is true, a failing gate HARD-BLOCKS approval; when false the
// gates are advisory (evaluated + shown, never block). gateResultsJson holds the last evaluation.
enum SopStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model SopDocument {
  id                         String    @id @default(cuid())
  caseId                     String
  admissionProgrammeChoiceId String
  version                    Int
  status                     SopStatus @default(DRAFT)
  contentJson                Json
  sourceSnapshotJson         Json
  // The three gates' last evaluation ({ careerPlan, nzReasoning, homeTies } → pass/reason),
  // plus whether enforcement was on. Refreshed on generate and on every approve attempt.
  gateResultsJson            Json?
  model                      String? // Claude model used for the narrative + gate evaluation
  generatedById              String?
  generatedAt                DateTime  @default(now())
  editedAt                   DateTime?
  approvedById               String?
  approvedAt                 DateTime?

  case            Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  programmeChoice AdmissionProgrammeChoice @relation(fields: [admissionProgrammeChoiceId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@index([admissionProgrammeChoiceId, status])
  @@map("sop_documents")
}

// PR-ADMISSION-SUBMIT (step 4) — the per-institution Submission Log. One row per submission ATTEMPT
// to an institution (the client's chosen programme). APPEND-ONLY (Owner decision 2026-08-03): a
// resubmission is a NEW row, never an overwrite, so the full trail of attempts is preserved. The
// submission facts (submittedAt/method/portalName/referenceNo) freeze at creation; only the
// institution's RESPONSE to that specific attempt (responseReceivedAt/responseNotes/outcome) is
// completed later. A choice's current status = its latest attempt row.
//
// Outcome is COARSE here — the formal offer (conditions/expiry/letter) is the Step-6 Offer record.
enum SubmissionMethod {
  PORTAL // the institution's own online application portal
  EMAIL // emailed to an admissions inbox
  // NOT the Sorena agent portal (PR-AGENT-PORTAL, /agent). This is how an
  // application was lodged WITH AN INSTITUTION — through a third-party
  // agent/aggregator portal such as an ITP's partner system. Grepping
  // AGENT_PORTAL finds both; they have nothing to do with each other.
  AGENT_PORTAL
  OTHER
}

enum SubmissionOutcome {
  PENDING // submitted, awaiting a response
  ACKNOWLEDGED // institution confirmed receipt / under assessment
  OFFER // offer of place received (detail lives in the Step-6 Offer record)
  DECLINED // application declined
  WITHDRAWN // application withdrawn by us / the client
}

model SubmissionRecord {
  id                         String            @id @default(cuid())
  caseId                     String
  admissionProgrammeChoiceId String
  // Submission facts — frozen after creation.
  submittedAt                DateTime          @db.Date
  method                     SubmissionMethod
  portalName                 String? // the specific portal/system used (free text)
  referenceNo                String? // the institution's application reference (free text)
  // Response to THIS attempt — completed as it arrives.
  outcome                    SubmissionOutcome @default(PENDING)
  responseReceivedAt         DateTime?         @db.Date
  responseNotes              String?
  submittedById              String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  case            Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  programmeChoice AdmissionProgrammeChoice @relation(fields: [admissionProgrammeChoiceId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([admissionProgrammeChoiceId])
  @@map("submission_records")
}

// PR-ADMISSION-OFFER (step 6) — the formal offer-of-place for one programme choice (institution).
// The Submission Log's coarse OFFER outcome (step 4) points here for the rich detail: conditional
// vs unconditional, conditions text, offered/expiry dates, the offer-letter file, and the client's
// decision (accept/decline). One current offer per choice (regenerating/re-offering supersedes via
// the latest row). A DECLINE of the APPLICATION stays a SubmissionRecord.outcome=DECLINED (+ reason
// in responseNotes) — this model is only for offers received.
enum OfferType {
  CONDITIONAL
  UNCONDITIONAL
}

enum OfferDecision {
  PENDING // offer received, client hasn't decided
  ACCEPTED
  DECLINED // client declined a received offer (distinct from the institution declining the application)
}

model OfferRecord {
  id                         String        @id @default(cuid())
  caseId                     String
  admissionProgrammeChoiceId String
  submissionRecordId         String? // the submission attempt that yielded the offer (audit link)
  offerType                  OfferType
  conditions                 String? // required conditions when CONDITIONAL (free text)
  offeredAt                  DateTime?     @db.Date
  expiresAt                  DateTime?     @db.Date
  letterFileName             String? // offer-letter file metadata (upload wiring is a later slice)
  letterFileUrl              String?
  notes                      String?
  decision                   OfferDecision @default(PENDING)
  createdById                String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  case            Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  programmeChoice AdmissionProgrammeChoice @relation(fields: [admissionProgrammeChoiceId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([admissionProgrammeChoiceId])
  @@map("offer_records")
}

model AdmissionDocument {
  id                     String                @id @default(cuid())
  admissionApplicationId String
  educationEntryId       String?
  documentType           AdmissionDocumentType
  fileName               String
  fileUrl                String
  mimeType               String
  fileSizeBytes          Int
  uploadedAt             DateTime              @default(now())

  admissionApplication AdmissionApplication     @relation(fields: [admissionApplicationId], references: [id], onDelete: Cascade)
  educationEntry       AdmissionEducationEntry? @relation(fields: [educationEntryId], references: [id], onDelete: Cascade)

  @@index([admissionApplicationId])
  @@index([educationEntryId])
  @@map("admission_documents")
}

// ─── LIA PROFILES (PR-DOCUSIGN-1) ─────────────────────────────────────────────
// LIA's IAA (Immigration Advisers Authority) credential record. 1:1 with a
// User of role=LIA. A 1:1 child table on User,
// snake_case @@map, cascade on user delete.
//
// Lifecycle: an LIA logs in for the first time after this migration ships,
// sees a "Complete your profile" banner, enters their iaaLicenceNumber +
// uploads a licence cert PDF (multer pending → ./uploads/lia-licences/<userId>/
// <filename>.pdf). At that point iaaLicenceNumber + iaaLicenceFileUrl +
// the three file-metadata columns are populated, but iaaLicenceVerifiedAt +
// iaaLicenceVerifiedById stay null. An OWNER/ADMIN then manually cross-checks
// the cert against the IAA register and marks it verified. Only verified LIAs
// become eligible for auto-assign + contract-send (gate added in a later step).
//
// Every field nullable because a row may exist BEFORE the LIA submits anything.
// Service layer enforces "verified" = all of iaaLicenceNumber, iaaLicenceFileUrl,
// iaaLicenceVerifiedAt are non-null.
//
// Forward-compat: iaaLicenceExpiryDate, iaaLicenceClass, and similar columns
// land via additive migrations later. All would be nullable, no backfill needed.
model LiaProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Credential — populated when the LIA submits their profile.
  // @unique because IAA licence numbers are globally unique per natural
  // person in NZ. Postgres allows multiple NULLs in a unique index, so
  // "not uploaded yet" rows don't conflict.
  iaaLicenceNumber String? @unique

  // Licence cert PDF metadata. Same shape as case-documents, visa-supporting,
  // inz-receipts — filesystem path + denormalised size/mime/name so list views
  // don't need fs.stat. Stored under ./uploads/lia-licences/<userId>/<file>.pdf.
  iaaLicenceFileUrl   String?
  iaaLicenceFileName  String?
  iaaLicenceFileMime  String?
  iaaLicenceSizeBytes Int?

  // Verification trail — written together by an OWNER/ADMIN after manual
  // cross-check against the IAA register. SetNull on verifier hard-delete:
  // timestamp survives as audit evidence, attribution is lost.
  iaaLicenceVerifiedAt   DateTime?
  iaaLicenceVerifiedById String?

  // ── PR-AGENT-PORTAL phase 0 ────────────────────────────────────────────────

  /// When the IAA licence expires. Nullable because every row predates this
  /// field and because a profile exists before anything is submitted.
  ///
  /// A verified licence is not a permanent fact. Without this the platform
  /// would keep treating a lapsed adviser as current, which is the one thing
  /// licence verification exists to prevent.
  licenceExpiryDate DateTime? @db.Date

  /// Set by the daily sweep when licenceExpiryDate has passed.
  ///
  /// This flag is for LISTING — "who has lapsed", cheaply, without date
  /// arithmetic across every row. It is NOT the boundary: gates compare the
  /// date at request time as well, because a licence that expires at midnight
  /// must not stay usable until the sweep next runs, and a cron that silently
  /// stops must not leave everyone permanently valid. Flag for the queue, date
  /// for the decision.
  isLicenceExpired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation("LiaProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("LiaProfileVerifier", fields: [iaaLicenceVerifiedById], references: [id], onDelete: SetNull)

  @@map("lia_profiles")
}

// ─── VISA APPLICATION (INZ 1200) ──────────────────────────────────────────────
// One row per admission application. Grows section by section as the student
// works through the INZ 1200 form. All editable fields stay nullable so the
// student can save a partial draft; required-ness is enforced in the UI and
// at save-time. otherNames + nationalId are PII — encrypted via CryptoService
// using the same AES-256-GCM envelope as admission's PR-SEC3 columns.
model VisaApplication {
  id            String @id @default(cuid())
  applicationId String @unique

  // Section 1 — Identity Details
  hasMononym             Boolean?
  middleNames            String?
  hasUsedOtherNames      Boolean?
  otherNamesEncrypted    Bytes?
  countryWhenSubmitting  String?
  prevAppliedNzVisa      Boolean?
  prevRequestedNzeta     Boolean?
  everTravelledNz        Boolean?
  totalNzTime24Plus      Boolean?
  passportIssueDate      DateTime?
  passportExpiryDate     DateTime?
  passportCountryOfIssue String?
  passportGender         String?
  stateOfBirth           String?
  cityOfBirth            String?
  hasNationalId          Boolean?
  nationalIdEncrypted    Bytes?
  nationalIdCountry      String?

  // Section 2 — Address and contact information (PR-VISA2)
  physicalStreetEncrypted       Bytes?
  physicalSuburb                String?
  physicalCity                  String?
  physicalState                 String?
  physicalPostcode              String?
  physicalCountry               String?
  postalSameAsPhysical          Boolean?
  postalStreetEncrypted         Bytes?
  postalSuburb                  String?
  postalCity                    String?
  postalState                   String?
  postalPostcode                String?
  postalCountry                 String?
  preferredContactCountryCode   String?
  preferredContactNumber        String?
  alternativeContactCountryCode String?
  alternativeContactNumber      String?

  // Section 3 — Eligibility (PR-VISA3)
  // Study history
  holdsNzStudentVisa           Boolean?
  // Offer of Place assistance
  usedEducationAgent           Boolean?
  agentOrganisationName        String?
  agentCountry                 String?
  agentGivenName               String?
  agentSurname                 String?
  agentEmail                   String?
  // Study details
  studyingSchoolLevel          Boolean?
  studyingMastersOrPhd         String?
  educationProviderName        String?
  studyLocation                String?
  courseRequiresOtherLocation  Boolean?
  courseProgrammeName          String?
  courseStartDate              DateTime?
  courseEndDate                DateTime?
  intendedArrivalDate          DateTime?
  // PhD details — only relevant when studyingMastersOrPhd = "PHD"
  phdDiscipline                String?
  phdSubject                   String?
  phdSupervisorTitle           String?
  phdSupervisorGivenName       String?
  phdSupervisorSurname         String?
  phdSupervisorOrganisation    String?
  phdPublishedPapers           Boolean?
  phdSupervisorOutsideNz       Boolean?
  // Student identification number
  providerIssuedStudentId      Boolean?
  studentIdNumber              String?
  // Your situation and plans — six free-text fields are PII (AES-256-GCM)
  homeCommitmentsEncrypted     Bytes?
  studyRelatesToPrevious       Boolean?
  studyRelatesDetailsEncrypted Bytes?
  whyStudyNzEncrypted          Bytes?
  whyThisProviderEncrypted     Bytes?
  howCourseBenefitsEncrypted   Bytes?
  plansAfterStudyEncrypted     Bytes?
  studyingMultiYear            Boolean?

  // Section 4 — Character (PR-VISA4)
  // Character details (4 mandatory Y/N declarations)
  everConvicted            Boolean?
  underInvestigation       Boolean?
  everDeportedExcluded     Boolean?
  everRefusedVisa          Boolean?
  // Police certificate from the country of citizenship — the file itself
  // is uploaded via the admission documents pipeline with documentType =
  // VISA_POLICE_CERTIFICATE; these three columns capture the cert metadata.
  policeCertIssueDate      DateTime?
  policeCertCountryOfIssue String?
  policeCertInEnglish      Boolean?
  // Other citizenships + 5+ years branch (no further inputs in this PR)
  holdsOtherCitizenships   Boolean?
  livedOtherCountry5Years  Boolean?

  // Section 5 — Health (PR-VISA5)
  hasTuberculosis            Boolean?
  needsRenalDialysis         Boolean?
  hasMedicalCondition        Boolean?
  needsResidentialCare       Boolean?
  isPregnant                 Boolean?
  intendedLengthOfStay       String?
  hadMedicalExam             Boolean?
  medicalRefNumber           String?
  tbCountriesNoMore          Boolean?
  insuranceDeclarationAgreed Boolean?
  publicHealthAckAgreed      Boolean?

  // Section 7 — Employment history (PR-VISA7)
  everGovernmentEmployed Boolean?
  everPrisonGuard        Boolean?
  currentlyWorking       Boolean?
  hadPreviousEmployment  Boolean?
  everUnemployed         Boolean?

  // Section 8 — Relationships (PR-VISA8)
  // Note: relationshipStatus + hasChildren are sourced read-only from
  // admission.maritalStatus + admission.hasChildren (see PR-VISA8 reuse
  // notes). Only the three Y/N gates that have no admission equivalent
  // live here.
  hasFormerPartners Boolean?
  hasSiblings       Boolean?
  hasNzContacts     Boolean?

  // Section 9 — Background details (PR-VISA9). Flat set of Y/N
  // declarations; all nullable so partial drafts can save.
  heldReligiousCulturalPosition Boolean?
  heldPoliticalAppointment      Boolean?
  hadPoliticalAssociation       Boolean?
  associatedIntelligenceAgency  Boolean?
  witnessedIllTreatment         Boolean?
  involvedArmedConflict         Boolean?
  associatedViolentGroup        Boolean?
  involvedWarCrimes             Boolean?
  memberLiberationMilitia       Boolean?
  everDetainedImprisoned        Boolean?

  // Section 10 — Military service (PR-VISA10). Three gating Y/Ns plus
  // a conditional explanation (only when D3 = true). exemptExplanation
  // is PII (free-text reason) and stored encrypted via CryptoService.
  militaryServiceCompulsoryHome Boolean?
  everUndertakenMilitaryService Boolean?
  wasExemptFromMilitaryService  Boolean?
  exemptExplanationEncrypted    Bytes?

  // Section 11 — Travel history (PR-VISA11). Single gate Y/N; when Yes
  // the repeating visa_travel_history_entries rows hold each trip
  // (destination / pointOfEntry / otherPurpose are free-text PII and
  // stored encrypted via CryptoService, same envelope as Section 10).
  hasTravelledInternationally Boolean?

  // Section 12 — Immigration assistance (PR-VISA12). Single-instance
  // (no child table). Gate Y/N + capacity enum + a five-field adviser
  // block that only applies when capacity ∈ {LICENSED_IMMIGRATION_
  // ADVISER, EXEMPT_PERSON}. adviserNumber / adviserFullName /
  // adviserEmail / adviserContactNumber are all third-party PII and
  // stored encrypted via CryptoService (AES-256-GCM, same envelope as
  // Section 10 / 11). Server-side clearing: completingOnBehalf = false
  // OR capacity ∉ {ADVISER set} nulls every downstream field on save.
  completingOnBehalf            Boolean?
  immigrationAssistanceCapacity ImmigrationAssistanceCapacity?
  adviserNumberEncrypted        Bytes?
  adviserFullNameEncrypted      Bytes?
  adviserEmailEncrypted         Bytes?
  adviserContactNumberEncrypted Bytes?
  adviserIsPrimaryContact       Boolean?

  // Section 13 — Supporting documents page 1 (PR-VISA13). Three
  // parent-row fields plus a repeating visa_supporting_documents
  // child table (one row per documentType per application). The
  // actual file bytes are NEVER sent to or stored by the backend;
  // file storage is deferred to a later PR — we record only
  // originalFilename / mimeType / sizeBytes / uploadedAt as metadata.
  // countryOfResidence is free-text PII (identifying location) and
  // encrypted via CryptoService, same envelope as the Section 12
  // adviser fields. areAllDocsInEnglish is the "are all the documents
  // you intend to upload in English?" gate from the page-1 guidance
  // block.
  livingInDifferentCountry    Boolean?
  countryOfResidenceEncrypted Bytes?
  areAllDocsInEnglish         Boolean?

  // Section 14 — Supporting documents page 2 (PR-VISA14). 28 parent
  // flags driving a tree of conditional sections plus three encrypted
  // free-text fields. The repeating "Other evidence" block lives in
  // its own child table (VisaOtherEvidenceEntry). All conditional
  // children are reconciled server-side on save — see
  // visa.service.saveSupportingDocuments2 for the cascade-clear
  // rules. File storage is still deferred; only metadata flows.
  tuitionFeesPaid                  Boolean?
  tuitionPaymentMethod             TuitionPaymentMethod?
  fundsSourceSavings               Boolean?
  fundsSourceNZSponsor             Boolean?
  fundsSourceInz1014               Boolean?
  fundsSourcePrepaidAccom          Boolean?
  fundsSourceScholarship           Boolean?
  outwardSourceSufficientFunds     Boolean?
  outwardSourceInz1014             Boolean?
  outwardSourcePrepaidBooking      Boolean?
  outwardSourceScholarship         Boolean?
  fundsFormatBankAccount           Boolean?
  fundsFormatProvidentFund         Boolean?
  fundsFormatEducationLoan         Boolean?
  fundsFormatFixedTermDeposit      Boolean?
  fundsFormatOther                 Boolean?
  savingsSourceWages               Boolean?
  savingsSourceSelfEmployment      Boolean?
  savingsSourceRentalIncome        Boolean?
  savingsSourceOther               Boolean?
  depositExplanationEncrypted      Bytes?
  scholarshipNameEncrypted         Bytes?
  scholarshipOrganisationEncrypted Bytes?
  studyIs120CreditsOrMore          Boolean?
  courseRequiresPracticalWork      Boolean?
  tookEnglishTest                  Boolean?
  declarationChecked               Boolean?

  currentStep Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admissionApplication AdmissionApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  otherCitizenships    VisaOtherCitizenship[]
  tbRiskCountries      VisaTbRiskCountry[]
  educationSupplements VisaEducationSupplement[]
  employmentEntries    VisaEmploymentEntry[]
  unemploymentEntries  VisaUnemploymentEntry[]
  partner              VisaPartner?
  formerPartners       VisaFormerPartner[]
  children             VisaChild[]
  parents              VisaParent[]
  siblings             VisaSibling[]
  nzContacts           VisaNzContact[]
  militaryServices     VisaMilitaryService[]
  travelHistoryEntries VisaTravelHistoryEntry[]
  supportingDocuments  VisaSupportingDocument[]
  otherEvidenceEntries VisaOtherEvidenceEntry[]
  visaCase             VisaCase?

  @@map("visa_applications")
}

// Step 8 (PR-VISA8) — Relationships. Six new tables; all third-party
// name fields and passport numbers / phone numbers / street addresses
// are PII and stored encrypted (AES-256-GCM via CryptoService, same
// envelope as the earlier Visa Section PII columns).
//
// visa_partner is singleton (UNIQUE on visaApplicationId) — at most one
// current partner per visa application. Everything else is a repeating
// child table with sortOrder for stable render order. Cascade on the
// parent FK so the visa_application's delete tears everything down.

model VisaPartner {
  id                      String    @id @default(cuid())
  visaApplicationId       String    @unique
  relationshipToApplicant String?
  givenNameEncrypted      Bytes?
  middleNamesEncrypted    Bytes?
  surnameEncrypted        Bytes?
  gender                  String?
  dateOfBirth             DateTime?
  relationshipStatus      String?
  countryOfBirth          String?
  stateOfBirth            String?
  cityOfBirth             String?
  nationality             String?
  countryOfResidence      String?
  occupation              String?
  holdsPassport           Boolean?
  passportNumberEncrypted Bytes?
  passportCountryOfIssue  String?
  passportIssueDate       DateTime?
  passportExpiryDate      DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@map("visa_partner")
}

model VisaFormerPartner {
  id                   String    @id @default(cuid())
  visaApplicationId    String
  givenNameEncrypted   Bytes?
  middleNamesEncrypted Bytes?
  surnameEncrypted     Bytes?
  gender               String?
  dateOfBirth          DateTime?
  relationshipStatus   String?
  countryOfBirth       String?
  nationality          String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_former_partners")
}

model VisaChild {
  id                      String    @id @default(cuid())
  visaApplicationId       String
  givenNameEncrypted      Bytes?
  middleNamesEncrypted    Bytes?
  surnameEncrypted        Bytes?
  gender                  String?
  dateOfBirth             DateTime?
  countryOfBirth          String?
  nationality             String?
  relationshipToApplicant String?
  livesWithApplicant      Boolean?
  sortOrder               Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_children")
}

model VisaParent {
  id                      String    @id @default(cuid())
  visaApplicationId       String
  givenNameEncrypted      Bytes?
  middleNamesEncrypted    Bytes?
  surnameEncrypted        Bytes?
  relationshipToApplicant String?
  isDeceased              Boolean?
  gender                  String?
  dateOfBirth             DateTime?
  dateOfBirthUnknown      Boolean?
  relationshipStatus      String?
  countryOfBirth          String?
  citizenship             String?
  countryOfResidence      String?
  occupation              String?
  sortOrder               Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_parents")
}

model VisaSibling {
  id                      String    @id @default(cuid())
  visaApplicationId       String
  givenNameEncrypted      Bytes?
  middleNamesEncrypted    Bytes?
  surnameEncrypted        Bytes?
  relationshipToApplicant String?
  gender                  String?
  dateOfBirth             DateTime?
  dateOfBirthUnknown      Boolean?
  relationshipStatus      String?
  countryOfBirth          String?
  citizenship             String?
  countryOfResidence      String?
  occupation              String?
  sortOrder               Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_siblings")
}

model VisaNzContact {
  id                      String   @id @default(cuid())
  visaApplicationId       String
  givenNameEncrypted      Bytes?
  middleNamesEncrypted    Bytes?
  surnameEncrypted        Bytes?
  relationshipToApplicant String?
  phoneEncrypted          Bytes?
  email                   String?
  streetEncrypted         Bytes?
  suburb                  String?
  townCity                String?
  region                  String?
  postcode                String?
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_nz_contacts")
}

// Step 7 employment history (PR-VISA7). One table covers both the
// single CURRENT job and any number of PREVIOUS jobs — distinguished by
// entryKind. duties is PII (free-text role description) and stored
// encrypted via CryptoService using the standard AES-256-GCM envelope.
// startDate carries month-precision (we store the 1st of the month);
// endDate is null on the CURRENT row.
model VisaEmploymentEntry {
  id                  String    @id @default(cuid())
  visaApplicationId   String
  entryKind           String
  startDate           DateTime?
  endDate             DateTime?
  roleTitle           String?
  dutiesEncrypted     Bytes?
  countryOfWork       String?
  stateOfWork         String?
  supervisorName      String?
  organisationField   String?
  organisationCountry String?
  organisationState   String?
  employerName        String?
  employerStreet      String?
  employerSuburb      String?
  employerTownCity    String?
  employerSubregion   String?
  employerRegion      String?
  employerPostcode    String?
  employerPhone       String?
  employerEmail       String?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_employment_entries")
}

// Step 7 unemployment / unpaid-service periods (PR-VISA7). Both
// free-text descriptions are PII and stored encrypted.
model VisaUnemploymentEntry {
  id                        String    @id @default(cuid())
  visaApplicationId         String
  startDate                 DateTime?
  endDate                   DateTime?
  activityEncrypted         Bytes?
  financialSupportEncrypted Bytes?
  sortOrder                 Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_unemployment_entries")
}

// Visa-side extras for an admission education entry (PR-VISA6). One row
// per admission_education_entry — the admission row holds the data INZ
// already collects via the admission form (qualification level, field of
// study, institution name, country, start/end YEAR, completed/awarded
// status). This supplement holds only what INZ Section 6 needs on top:
//   * startMonth / endMonth — admission stores year-only
//   * institutionState / institutionTown — admission has no address fields
//   * qualificationAwarded — distinct semantic from admission's
//     `completed` (student-finished) vs `certificateNotReceived` (cert in
//     transit). INZ asks specifically whether the institution conferred
//     the qualification.
// Cascade-deletes with either parent so a deleted admission entry never
// strands an orphan supplement.
model VisaEducationSupplement {
  id                   String   @id @default(cuid())
  visaApplicationId    String
  educationEntryId     String   @unique
  startMonth           Int?
  endMonth             Int?
  institutionState     String?
  institutionTown      String?
  qualificationAwarded Boolean?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  visaApplication VisaApplication         @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  educationEntry  AdmissionEducationEntry @relation(fields: [educationEntryId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_education_supplements")
}

// Repeating rows for the TB-risk countries block (PR-VISA5). One row per
// country the student has visited or lived in over the last 5 years.
// Same shape as VisaOtherCitizenship — live-API per row (POST/PATCH/DELETE
// endpoints), cascade-deleted with the parent visa application.
model VisaTbRiskCountry {
  id                String   @id @default(cuid())
  visaApplicationId String
  country           String
  totalDurationDays Int
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_tb_risk_countries")
}

// Step 10 military service declarations (PR-VISA10). One row per
// service period — INZ Section D's D4 repeating block. duties is PII
// (free-text role description) and stored encrypted via CryptoService.
// dateStarted/dateFinished carry day precision (INZ wants full dates,
// not month-year). Replace-on-save: visa.service.ts wipes the array
// with deleteMany before reinserting on every Step 10 PATCH.
model VisaMilitaryService {
  id                String    @id @default(cuid())
  visaApplicationId String
  dateStarted       DateTime?
  dateFinished      DateTime?
  location          String?
  corps             String?
  division          String?
  brigade           String?
  battalion         String?
  unit              String?
  rank              String?
  dutiesEncrypted   Bytes?
  commandingOfficer String?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_military_services")
}

// Mode of arrival for a Section 11 travel-history entry (PR-VISA11).
// INZ 1200 lists Air / Sea / Land — encoded directly to avoid any
// free-text drift on this dropdown.
enum VisaArrivalMode {
  AIR
  SEA
  LAND
}

// Purpose of the trip for a Section 11 entry (PR-VISA11). Same INZ
// dropdown; OTHER unlocks the free-text otherPurpose column on the row.
enum VisaPurposeOfTravel {
  EDUCATION
  TOURISM
  BUSINESS
  FAMILY
  MEDICAL
  TRANSIT
  WORK
  OTHER
}

// Capacity in which a third party is completing the visa form on
// behalf of the applicant (PR-VISA12). Only LICENSED_IMMIGRATION_
// ADVISER and EXEMPT_PERSON unlock the five-field adviser block —
// the other three capacities (FAMILY_MEMBER, FRIEND, OTHER) only
// need the gate flag + capacity selection.
enum ImmigrationAssistanceCapacity {
  LICENSED_IMMIGRATION_ADVISER
  EXEMPT_PERSON
  FAMILY_MEMBER
  FRIEND
  OTHER
}

// Supporting document types (PR-VISA13). Page 1 of INZ's "Supporting
// documents" introduces the first six values; PR-VISA14 (page 2)
// will reuse this same enum and add more values for the page-2
// document categories. The UNIQUE constraint on
// (visaApplicationId, documentType) in VisaSupportingDocument means
// each application can only have one metadata row per type at a
// time — re-uploading replaces the existing row in a single
// transaction.
enum VisaSupportingDocumentType {
  PASSPORT
  NATIONAL_ID
  RESIDENCE_VISA
  MILITARY_RECORD
  TRAVEL_HISTORY
  AUTHORITY_DOC
  // PR-VISA14 (page 2) additions. The enum is shared between page 1
  // and page 2 because the metadata table is keyed on
  // (visaApplicationId, documentType) and one unique constraint
  // covers both pages cleanly.
  OFFER_OF_PLACE
  PHD_RESEARCH_PROPOSAL
  PUBLICATIONS_LIST
  PERSONAL_CIRCUMSTANCES_EVIDENCE
  PREVIOUS_TERTIARY_EVIDENCE
  CURRENT_EMPLOYMENT_EVIDENCE
  PREVIOUS_EMPLOYMENT_EVIDENCE
  ENGLISH_TEST_RESULTS
  TUITION_PAYMENT_CONFIRMATION
  INZ1014_FINANCIAL_UNDERTAKING
  PREPAID_ACCOMMODATION_EVIDENCE
  SCHOLARSHIP_EVIDENCE
  OUTWARD_TRAVEL_EVIDENCE
  BANK_STATEMENTS
  EMPLOYMENT_INCOME_EVIDENCE
  SCHEDULED_HOLIDAY_EVIDENCE
  OTHER_EVIDENCE
}

// PR-VISA14 (page 2 — Tuition fees section). The four ways a student
// can have arranged to pay tuition: self / partner-provider-or-loan /
// third-party sponsor / scholarship. Only relevant when
// tuitionFeesPaid = false; if fees are already paid we don't ask how.
enum TuitionPaymentMethod {
  SELF_PAID
  PARTNER_PROVIDER_OR_GOVT_LOAN
  THIRD_PARTY_SPONSOR
  SCHOLARSHIP
}

// PR-VISA14 (page 2 — "Other evidence" repeating block). Five
// categories the applicant can attach extra evidence rows under;
// OTHER unlocks the free-text customLabel column on the child row.
enum OtherEvidenceType {
  COVER_LETTER
  STATEMENT_OF_PURPOSE
  ADDITIONAL_FUNDS_EVIDENCE
  FAMILY_TIES_EVIDENCE
  OTHER
}

// Step 13 (PR-VISA13) — Supporting documents page 1 metadata row.
// File storage is deferred to a later PR; this table stores ONLY
// the metadata extracted from the File object in the browser
// (originalFilename / mimeType / sizeBytes). The bytes themselves
// never reach the backend.
//
// originalFilename is the user's chosen filename — not encrypted
// (it's a label, not personally identifying on its own). mimeType
// and sizeBytes are technical fields. uploadedAt records when the
// metadata row was created — distinct from createdAt because we'll
// eventually want to know "when did the user originally pick this
// file?" separately from row-creation timestamps after PR-14
// introduces actual storage.
//
// UNIQUE (visaApplicationId, documentType): enforces one row per
// type per application — replace-on-upload (service deletes the
// existing row by composite key before inserting the new one).
// PR-FILES-2 — represents a per-application requirement of this
// documentType. Files live in the visa_supporting_document_files
// child. The UNIQUE(visaApplicationId, documentType) survives — still
// one requirement per type per application. fulfilmentMessages
// continues to point at the parent (fulfilling a doc request means
// "you've provided >=1 file for this type", not "you provided THIS
// specific file"), so pre-existing CaseMessage FKs keep working.
model VisaSupportingDocument {
  id                String                     @id @default(cuid())
  visaApplicationId String
  documentType      VisaSupportingDocumentType
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  visaApplication    VisaApplication              @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  files              VisaSupportingDocumentFile[]
  // PR-LIA-4: CaseMessage DOCUMENT_REQUEST rows that the client
  // fulfilled by linking THIS supporting-document row.
  fulfilmentMessages CaseMessage[]                @relation("CaseMessageFulfilment")

  @@unique([visaApplicationId, documentType])
  @@index([visaApplicationId])
  @@map("visa_supporting_documents")
}

// PR-FILES-2 — per-entry classification (evidenceType + optional
// encrypted label). Files move to visa_other_evidence_entry_files.
model VisaOtherEvidenceEntry {
  id                   String            @id @default(cuid())
  visaApplicationId    String
  evidenceType         OtherEvidenceType
  customLabelEncrypted Bytes?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  visaApplication VisaApplication         @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  files           VisaOtherEvidenceFile[]

  @@index([visaApplicationId])
  @@map("visa_other_evidence_entries")
}

// PR-FILES-2 — one row per uploaded file under a parent requirement.
// fileUrl is NOT NULL: a row in this table only exists when the bytes
// are on disk. createdAt is identical to uploadedAt for any row this
// service produces, but kept separate so a future audit/restore flow
// can distinguish "when did the file land in storage" from "when was
// this row written".
model VisaSupportingDocumentFile {
  id                       String   @id @default(cuid())
  visaSupportingDocumentId String
  originalFilename         String
  mimeType                 String
  sizeBytes                Int
  fileUrl                  String
  uploadedAt               DateTime @default(now())
  createdAt                DateTime @default(now())

  document VisaSupportingDocument @relation(fields: [visaSupportingDocumentId], references: [id], onDelete: Cascade)

  @@index([visaSupportingDocumentId])
  @@map("visa_supporting_document_files")
}

// PR-FILES-2 — one row per uploaded file under an other-evidence
// entry. Same shape as VisaSupportingDocumentFile.
model VisaOtherEvidenceFile {
  id                       String   @id @default(cuid())
  visaOtherEvidenceEntryId String
  originalFilename         String
  mimeType                 String
  sizeBytes                Int
  fileUrl                  String
  uploadedAt               DateTime @default(now())
  createdAt                DateTime @default(now())

  entry VisaOtherEvidenceEntry @relation(fields: [visaOtherEvidenceEntryId], references: [id], onDelete: Cascade)

  @@index([visaOtherEvidenceEntryId])
  @@map("visa_other_evidence_entry_files")
}

// PR-DASH-1 — Client-dashboard workflow status.
//
// The existing `Case` model (line 639) is a CRM/sales-side artifact
// keyed to Lead, with a `CaseStage` enum (ADMISSION / VISA / etc.) and
// a free-text `status`. VisaCase is a separate, dashboard-side row
// keyed to VisaApplication 1:1, with a structured status enum the
// client UI renders. They coexist by design — the CRM Case tracks the
// consultant's pipeline; the VisaCase tracks the student-facing visa
// workflow status.
//
// Auto-created on first dashboard load alongside the VisaApplication
// and AssessmentReport rows (single transaction, idempotent upsert by
// clientId / visaApplicationId).
enum VisaCaseStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  REVIEWED
  READY_FOR_INZ
  INZ_SUBMITTED
  APPROVED
  DECLINED
}

model VisaCase {
  id                   String         @id @default(cuid())
  visaApplicationId    String         @unique
  clientId             String
  assignedConsultantId String?
  status               VisaCaseStatus @default(DRAFT)
  statusChangedAt      DateTime       @default(now())
  // userId of whoever changed status; null when system-set on creation.
  statusChangedBy      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  visaApplication    VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  client             User            @relation("VisaCaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  assignedConsultant User?           @relation("VisaCaseConsultant", fields: [assignedConsultantId], references: [id])

  // PR-DASH-2 children
  supportTickets VisaSupportTicket[]
  fileNotes      VisaCaseFileNote[]

  // PR-CONSULT-1: per-role staff assignments. A case can have at
  // most one active assignment per VisaCaseRoleSlot at any time;
  // historical assignments stay on the row with unassignedAt set.
  assignments VisaCaseAssignment[]

  @@index([clientId])
  @@index([assignedConsultantId])
  @@index([status])
  @@map("visa_cases")
}

// PR-DASH-1 — Friday AI scoring bot writeback target. Empty (all
// fields nullable) until the Wix pipe is wired and the bot posts a
// real report. summaryNarrative is free-text PII (the model's prose
// commentary) and stored encrypted via CryptoService (AES-256-GCM,
// same envelope as the visa-section encrypted columns).
model AssessmentReport {
  id                        String   @id @default(cuid())
  clientId                  String   @unique
  score                     Int?
  band                      Int?
  route                     String?
  summaryNarrativeEncrypted Bytes?
  // Free-form JSON the AI bot returns alongside the narrative.
  aiRecommendations         Json?
  // Wix submission id once the lead-capture pipe is wired.
  sourceSubmissionId        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("assessment_reports")
}

// ─── PR-DASH-2 — Client-side support tickets + case file notes ───────
//
// Three new tables + five enums. Tickets are 1-N off the dashboard's
// VisaCase row (not the CRM-side Case at line 639 — that's the
// consultant pipeline artifact). Messages are 1-N off a ticket and
// store an encrypted free-text body. File notes are an append-only
// log of significant events that affect the case (ticket creation,
// status changes — and in later PRs, meeting transcripts and
// consultant notes).
//
// Body / subject / summary text is ALWAYS encrypted via CryptoService
// (AES-256-GCM), same envelope as every other PII column in the
// project.

// What part of Sorena the ticket is about. Drives badge colour on
// the client UI and (in a future PR) routes the inbox a staff
// member sees.
enum VisaTicketDepartment {
  ADMISSIONS
  VISA_APPLICATION
  DOCUMENTS
  PAYMENTS_FINANCE
  TECHNICAL_SUPPORT
  GENERAL_INQUIRY
}

// Workflow status. CLOSED is terminal — clients can't reopen; they
// open a new ticket if they need further help (per spec).
enum VisaTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum VisaTicketPriority {
  LOW
  NORMAL
  HIGH
}

// Who wrote a given message row. SYSTEM is reserved for the service-
// generated rows (e.g. "Status changed from OPEN to RESOLVED") so
// the UI can render them as gray italic banners rather than chat
// bubbles.
enum VisaTicketMessageAuthorRole {
  CLIENT
  STAFF
  SYSTEM
}

// Kind of event the file note records. TICKET / SYSTEM_EVENT are
// emitted by this PR; MEETING_TRANSCRIPT and CONSULTANT_NOTE are
// reserved for PR-DASH-3.
enum VisaCaseFileNoteType {
  TICKET
  MEETING_TRANSCRIPT
  CONSULTANT_NOTE
  SYSTEM_EVENT
}

// One ticket per client question. subjectEncrypted is the only PII
// column on the row; all timestamps + foreign keys are cleartext for
// indexable filtering. assignedStaffId nulls out on staff deletion
// rather than cascading the ticket itself (a deleted consultant
// shouldn't tear down the client's ticket history).
model VisaSupportTicket {
  id                  String               @id @default(uuid())
  clientId            String
  caseId              String
  assignedStaffId     String?
  department          VisaTicketDepartment
  subjectEncrypted    Bytes
  status              VisaTicketStatus     @default(OPEN)
  priority            VisaTicketPriority   @default(NORMAL)
  lastClientMessageAt DateTime?
  lastStaffMessageAt  DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  client        User                       @relation("VisaSupportTicketClient", fields: [clientId], references: [id], onDelete: Cascade)
  assignedStaff User?                      @relation("VisaSupportTicketStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  case          VisaCase                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  messages      VisaSupportTicketMessage[]

  // PR-DASH-4: chat messages that escalated INTO this ticket. One
  // ticket can have at most one origin chat message (the escalation
  // event); the relation is plural because the FK column lives on
  // the message side and Prisma needs the reverse list.
  chatEscalations VisaChatMessage[] @relation("ChatEscalations")

  @@index([clientId, status])
  @@index([assignedStaffId, status])
  @@index([caseId])
  @@map("visa_support_tickets")
}

// One row per message in a thread. isInternalNote is reserved for
// staff-side internal commentary in a future PR — this PR's client
// endpoints filter it out. The author FK uses a non-named relation
// because messages are not user-deletable.
model VisaSupportTicketMessage {
  id             String                      @id @default(uuid())
  ticketId       String
  authorId       String
  authorRole     VisaTicketMessageAuthorRole
  bodyEncrypted  Bytes
  // PR-TICKETS-RICH — true when bodyEncrypted holds server-sanitized rich-text
  // HTML (staff replies via the shared RichTextEditor). false = legacy/plain
  // text (all pre-existing rows, and client messages), rendered as escaped text.
  // Distinguishes render mode without re-processing historical encrypted rows.
  bodyIsHtml     Boolean                     @default(false)
  // PR-TICKETS-RICH — file attachments (image/PDF). Array of
  // { key, name, mime, size } objects; the R2 object key is private, reads mint
  // a short-lived signed URL. NULL/absent = no attachments.
  attachments    Json?
  isInternalNote Boolean                     @default(false)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  ticket VisaSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("visa_support_ticket_messages")
}

// Append-only log of events that affect the case. Acts as the
// consultant's "case file" — a single chronological view they can
// scroll through to catch up. summaryEncrypted holds a short
// human-readable string (e.g. "Ticket opened — DOCUMENTS: 'Scholarship
// question'"). createdById is nullable for system-emitted notes.
model VisaCaseFileNote {
  id               String               @id @default(uuid())
  caseId           String
  noteType         VisaCaseFileNoteType
  // Uuid of the source row (ticket id / meeting id / etc). Not a
  // typed FK because the source table varies by noteType.
  referenceId      String
  summaryEncrypted Bytes
  createdById      String?
  createdAt        DateTime             @default(now())

  case      VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("VisaCaseFileNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([referenceId])
  @@map("visa_case_file_notes")
}

// ─── PR-DASH-3 — Meetings + transcripts (metadata + consultant notes) ─
//
// One row per consultation between a student and a consultant. Both
// sides have their own UI surfaces — students see read-only detail
// of their own meetings; consultants create/edit/cancel/complete and
// attach transcript metadata + write transcript notes after the
// session.
//
// PII columns encrypted via CryptoService (AES-256-GCM, same envelope
// as every other free-text PII column in the project):
//   * locationOrLink   — Zoom URL / office address / etc.
//   * agenda           — consultant-authored pre-meeting agenda
//   * transcriptNotes  — consultant-authored post-meeting notes
//
// cancelledReason is stored cleartext per the spec — it's a short
// admin-facing label rather than a freely-typed PII field.
//
// wixBookingId is NOT included here — the spec intentionally keeps
// the meeting row decoupled from any external booking platform.
// Booking is handled out-of-band via the WIX_BOOKING_URL env var
// surfaced through the existing /students/me/booking-config endpoint.
enum VisaMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisaMeetingType {
  CONSULTATION
  FOLLOW_UP
  DOCUMENT_REVIEW
  ASSESSMENT
}

model VisaMeeting {
  id              String            @id @default(cuid())
  studentId       String
  consultantId    String?
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  status          VisaMeetingStatus @default(SCHEDULED)
  meetingType     VisaMeetingType   @default(CONSULTATION)
  // Encrypted free-text PII (location / Zoom URL / agenda / post-meeting notes).
  locationOrLink  String?
  agenda          String?
  transcriptNotes String?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student        User                   @relation("StudentMeetings", fields: [studentId], references: [id])
  consultant     User?                  @relation("ConsultantMeetings", fields: [consultantId], references: [id])
  transcriptFile VisaMeetingTranscript?

  @@index([studentId, scheduledAt])
  @@index([consultantId, scheduledAt])
  @@index([status])
  @@map("visa_meetings")
}

// Transcript metadata. 1:1 with VisaMeeting (UNIQUE on meetingId).
// File bytes never reach the backend — see PR-13/PR-14 metadata-only
// pattern. PR-15 will attach the storage layer; this row stays the
// stable anchor.
model VisaMeetingTranscript {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  uploadedAt       DateTime @default(now())

  meeting    VisaMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@map("visa_meeting_transcripts")
}

// ─── PR-DASH-4 — In-platform AI chatbot (student-side, Pattern 1) ─────
//
// One conversation per student "thread". Messages are 1-N off the
// conversation. The chatbot is powered by Anthropic Claude Haiku;
// when the assistant detects it can't safely answer (sentinel token
// in its reply), the message is flagged for ESCALATION — the
// student then explicitly accepts or declines, and on accept a real
// VisaSupportTicket (PR-DASH-2) is created and linked back to the
// originating assistant message via escalatedTicketId.
//
// PII handling:
//   * VisaChatConversation.title  — encrypted (first user message,
//     truncated to 80 chars).
//   * VisaChatMessage.content     — encrypted, both user and assistant
//     messages. Cleartext is only held in memory long enough to send
//     to / receive from Anthropic, never logged.
//
// We don't store any of Anthropic's response metadata (request_id,
// stop_reason, etc.) other than the model name + token counts, to
// keep our row narrow and the audit trail clean.

enum VisaChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model VisaChatConversation {
  id         String    @id @default(cuid())
  studentId  String
  // Encrypted base64 (CryptoService). First user message truncated
  // to 80 chars after trim — only used as a list-row label.
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  student  User              @relation("StudentChatConversations", fields: [studentId], references: [id])
  messages VisaChatMessage[]

  @@index([studentId, updatedAt])
  @@map("visa_chat_conversations")
}

model VisaChatMessage {
  id                String              @id @default(cuid())
  conversationId    String
  role              VisaChatMessageRole
  // Encrypted base64 (CryptoService). Cleartext only ever passes
  // through the service layer to the model and back.
  content           String
  tokensIn          Int?
  tokensOut         Int?
  // Model identifier string (e.g. "claude-haiku-4-5-20251001").
  // Stored so future migrations across model versions can be audited.
  modelUsed         String?
  escalationOffered Boolean             @default(false)
  // Set when the student accepted escalation; FK to the resulting
  // support ticket so we can render a "Linked to ticket #..." badge
  // in the chat thread.
  escalatedTicketId String?
  createdAt         DateTime            @default(now())

  conversation    VisaChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  escalatedTicket VisaSupportTicket?   @relation("ChatEscalations", fields: [escalatedTicketId], references: [id])

  @@index([conversationId, createdAt])
  @@map("visa_chat_messages")
}

// Step 11 (PR-VISA11) — Travel history child row. The gate flag
// hasTravelledInternationally lives on the parent visa_application;
// when Yes the student adds one entry per trip taken in the last 5
// years (excluding NZ). Month + year are stored as Ints rather than
// a DateTime because INZ collects month-precision and a synthetic
// day-1 timestamp would be a footgun for downstream date math.
//
// destinationEncrypted / pointOfEntryEncrypted / otherPurposeEncrypted
// are the only PII columns — country names + ports of entry can
// re-identify a student against open border crossing records, and
// otherPurpose is free-text. Same AES-256-GCM envelope as Section 10.
//
// Replace-on-save: visa.service.saveTravelHistory wipes the array
// with deleteMany before reinserting on every Step 11 PATCH, matching
// the Step 10 transactional pattern.
model VisaTravelHistoryEntry {
  id                    String               @id @default(cuid())
  visaApplicationId     String
  destinationEncrypted  Bytes?
  dateEnteredMonth      Int?
  dateEnteredYear       Int?
  dateExitedMonth       Int?
  dateExitedYear        Int?
  arrivalMode           VisaArrivalMode?
  pointOfEntryEncrypted Bytes?
  purposeOfTravel       VisaPurposeOfTravel?
  otherPurposeEncrypted Bytes?
  sortOrder             Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_travel_history_entries")
}

// Repeating rows for "Do you hold any other citizenships?" = Yes
// (PR-VISA4 fix). Mirrors the admission_education_entries pattern: each
// row is mutated via its own POST/PATCH/DELETE endpoint, the rows are
// returned alongside the parent application on GET, and they cascade
// delete when the parent visa_application is removed. When the student
// toggles holdsOtherCitizenships back to false on save, the service
// deletes every row atomically — no orphans.
model VisaOtherCitizenship {
  id                String   @id @default(cuid())
  visaApplicationId String
  country           String
  holdsPassport     Boolean
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visaApplication VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)

  @@index([visaApplicationId])
  @@map("visa_other_citizenships")
}

// ─── PR-CONSULT-1 — Staff roles + assignments + owner approval ────────
//
// Foundation for the consultant-side platform. No consultant UI yet
// (lands in PR-CONSULT-2); this PR introduces the schema, services,
// guards, and approval queue that the UI will plug into.
//
// Encryption: OwnerApprovalRequest.payload / reason / decisionNote
// and PlatformSetting.value are stored as base64-encoded AES-256-GCM
// ciphertext in TEXT columns (CryptoService at the boundary — same
// envelope as PR-DASH-3/PR-DASH-4 free-text PII).

// Functional staff slot on a VisaCase. A case can have at most one
// active assignment per slot at any time; reassigning closes the
// prior row (sets unassignedAt) and inserts a new row.
enum VisaCaseRoleSlot {
  LIA
  CONSULTANT
  SUPPORT
  FINANCE
}

// Lifecycle for an owner-approval request. EXPIRED is set lazily on
// read (on-read sweep — no scheduler needed for launch). EXECUTED /
// EXECUTION_FAILED record whether the underlying action actually ran
// after OWNER approval.
enum OwnerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  EXECUTION_FAILED
}

// Set of destructive / sensitive actions that SUPER_ADMIN cannot
// execute directly — they enqueue an OwnerApprovalRequest instead.
// ADMIN cannot perform these actions at all (rejected with 403 at
// the controller).
enum OwnerApprovalActionType {
  CREATE_STAFF_USER
  CHANGE_STAFF_ROLE
  DEACTIVATE_STAFF
  DELETE_CASE
  DELETE_STUDENT
  ISSUE_REFUND
  CHANGE_PLATFORM_SETTING
  // PR-CONSULT-4: permanent staff user deletion. OWNER inline,
  // SUPER_ADMIN routes through this approval queue.
  HARD_DELETE_STAFF
}

model VisaCaseAssignment {
  id             String           @id @default(cuid())
  caseId         String
  staffId        String
  roleSlot       VisaCaseRoleSlot
  assignedAt     DateTime         @default(now())
  assignedById   String
  // unassignedAt IS NULL means the row is the currently-active
  // assignment for (caseId, roleSlot). Filtering on this is the
  // primary index access pattern; the composite index below
  // optimises for it.
  unassignedAt   DateTime?
  unassignedById String?

  case       VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staff      User     @relation("StaffAssignments", fields: [staffId], references: [id])
  assignedBy User     @relation("AssignmentsMade", fields: [assignedById], references: [id])

  @@index([caseId, roleSlot, unassignedAt])
  @@index([staffId, unassignedAt])
  @@map("visa_case_assignments")
}

model OwnerApprovalRequest {
  id             String                  @id @default(cuid())
  requestedById  String
  actionType     OwnerApprovalActionType
  // Encrypted JSON payload describing the action precisely (e.g.
  // { userId, newRole } for CHANGE_STAFF_ROLE). Stored as base64
  // ciphertext in a TEXT column.
  payload        String
  reason         String?
  status         OwnerApprovalStatus     @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  // 7 days from creation; expires lazily on read.
  expiresAt      DateTime
  executedAt     DateTime?
  executionError String?

  requestedBy User  @relation("OwnerApprovalRequester", fields: [requestedById], references: [id])
  decidedBy   User? @relation("OwnerApprovalDecider", fields: [decidedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([requestedById, createdAt])
  @@map("owner_approval_requests")
}

// Soft-disable flag for staff users — avoids deleting historical
// data. 1:1 with User (UNIQUE userId via @id).
model StaffActiveStatus {
  userId          String    @id
  isActive        Boolean   @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?

  user User @relation("StaffActive", fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_active_status")
}

// Stripe-issued card refunds (real money out). PR-CARD-REFUND wires
// stripe.refunds.create against the original PaymentIntent for the
// exceptional cash-out cases (legal / service-not-provided).
//   status: PENDING (Stripe accepted, async) → COMPLETED (succeeded) /
//   FAILED. The legacy PENDING_STRIPE_INTEGRATION value predates the
//   wiring (dormant owner-approval executor) and is excluded from the
//   "one live refund per payment" guard.
//   paymentId references Payment.id; consultationId links the booking
//   for the wallet-exclusivity check + staff UI.
model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  consultationId String?
  amountCents    Int
  reason         String?
  status         String   @default("PENDING_STRIPE_INTEGRATION")
  stripeRefundId String?  @unique
  createdAt      DateTime @default(now())
  createdById    String

  @@index([paymentId])
  @@map("refunds")
}

// PR-SCORECARD-4 — Generic key-value store for platform-wide settings.
//
// Two coexisting conventions live in this table:
//
//   * Legacy (owner-approval queue): `value` is AES-256-GCM ciphertext
//     via CryptoService.enc(). Reads must decrypt. Keys are arbitrary
//     OWNER-approved settings (CHANGE_PLATFORM_SETTING executor).
//   * PR-SCORECARD-4 (booking_urls + wix_integration categories):
//     `value` is plaintext. `category` is `booking_urls` |
//     `wix_integration` | `general`. PlatformSettingsService writes
//     these. The WIX_WEBHOOK_SECRET value is never returned plaintext
//     by the API except at regeneration time (masked as ●●●●●●●● in
//     every other response and in audit rows).
//
// `id` is the PK so each setting has a stable identifier; `key` is
// the unique business identifier used by callers (BOOKING_URL_FREE_15MIN,
// WIX_WEBHOOK_SECRET, etc.).
model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  category    String   @default("general") @db.VarChar(50)
  updatedById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User @relation("PlatformSettingUpdater", fields: [updatedById], references: [id])

  @@index([category])
  @@map("platform_settings")
}

// ─── SCORECARD (PR-SCORECARD-1) ──────────────────────────────────────
//
// One row per submission of the 100-point Readiness Assessment. A
// user can submit multiple times — every row is preserved so we can
// see how they improved (e.g. retook after an IELTS upgrade).
//
// `answersEncrypted` carries the raw answers JSON via the
// CryptoService AES-256-GCM envelope. Answers contain DOB, financial
// info, refusal history — everything that lands on a row here is PII.
//
// Computed columns (totalScore, category*Score, band, hardStops,
// riskFlags, gateResults, executionEligible, nextAction) are derived
// from `answers` by the TypeScript port of sorena_scoring.py. Storing
// them denormalised here is the deliberate choice — the engine is
// the source of truth at submit time; re-running it later on a stored
// answers payload should reproduce the same numbers, but we don't
// want to re-decrypt + re-score on every staff view.
//
// `leadId` is set after the canonical Lead row is created or reused in the
// same transaction as the submission. Multiple completed submissions may
// reference the same Lead so returning applicants retain one CRM identity
// while each assessment attempt remains independently auditable.
enum ScorecardBand {
  BAND_1
  BAND_2
  BAND_3
  BAND_4
  BAND_5
  BAND_6
}

enum ScorecardNextAction {
  NURTURE_ONLY
  PAY_GAP_CLOSING_SESSION
  BOOK_FREE_15MIN_SESSION
  BLOCKED_HARD_STOP
}

model ScorecardSubmission {
  id                   String              @id @default(uuid())
  userId               String
  answersEncrypted     Bytes
  // Computed scores. All Int-typed scoring columns become nullable
  // in PR-SCORECARD-2 because draft rows exist before scoring runs
  // — but at the Prisma level we keep them NOT NULL with sentinel
  // 0 defaults for drafts (set in saveDraft). Reasoning: changing
  // their nullability now would force a backfill on every legacy
  // submitted row, and the engine output is always populated when
  // isDraft=false. The frontend never reads scores while isDraft=true.
  totalScore           Int
  category1Score       Int
  category2Score       Int
  category3Score       Int
  category4Score       Int
  band                 ScorecardBand
  // Hard stops (structured JSON, plaintext — these are categorical,
  // not PII). riskFlags is a string[] for the same reason.
  hardStops            Json
  riskFlags            String[]            @default([])
  // 5-gate execution check
  executionEligible    Boolean
  gateResults          Json
  // Routing
  nextAction           ScorecardNextAction
  nextActionTextEn     String              @db.Text
  nextActionTextFa     String              @db.Text
  // Polish PR (post-e57a769): structured next-action payload
  // (heading + bullets + optional leadIn). Nullable so legacy rows
  // submitted before this column existed still load; the frontend
  // falls back to nextActionTextEn when this is null.
  nextActionContent    Json?
  // PR-SCORECARD-2: autosave / draft state.
  //   * `isDraft=true`  — row is the user's in-progress questionnaire.
  //                       Scoring columns hold sentinel zeros / BAND_1
  //                       / NURTURE_ONLY; never trust them. submittedAt
  //                       is also unreliable in draft state (re-used as
  //                       a "created at" timestamp).
  //   * `isDraft=false` — row is a real submission. Scoring columns
  //                       are populated, leadId is set, audit rows
  //                       fired. Legacy rows from PR-SCORECARD-1 are
  //                       backfilled `isDraft=false` by the migration.
  // `draftLastSavedAt` tracks the last autosave so the form can
  // render "Last saved 2 minutes ago" if we choose to surface it.
  isDraft              Boolean             @default(false)
  draftLastSavedAt     DateTime?
  // Lifecycle
  submittedAt          DateTime            @default(now())
  leadId               String?
  consultationBookedAt DateTime?
  // Audit (request-side context; the user-side audit row is in audit_logs)
  ipAddress            String?             @db.VarChar(64)
  userAgent            String?             @db.Text
  // PR-SCORECARD-ATTR-1: raw marketing-campaign attribution (Google/Meta Ads
  // style — utm_source=google&utm_medium=cpc&...), captured from the website
  // separately from the agent/affiliate sv_attribution mechanism above
  // (trackingLinkId resolves through the TrackingLink table to an
  // AffiliateAgent; these four columns do not). Set on both draft rows (as
  // captured at draft-save time) and the final submission (as sent with the
  // submit request) — nullable throughout, since direct traffic and deep
  // links to the assessment carry none of it.
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  landingPage          String?

  user User  @relation("ScorecardUser", fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation("ScorecardLead", fields: [leadId], references: [id])

  @@index([userId, submittedAt])
  @@index([band, submittedAt])
  @@index([executionEligible])
  @@index([leadId])
  // PR-SCORECARD-2: fast "get my open draft" lookup. Composite
  // (userId, isDraft) keeps the index narrow — most rows are
  // submitted (false), only the in-flight draft per user is true.
  @@index([userId, isDraft])
  @@map("scorecard_submissions")
}

// ─── MARKETING / AFFILIATE LINK TRACKING (PR-SCORECARD-2) ────────────
//
// Three-table cluster for attribution of leads to marketing channels
// and (optionally) named affiliate agents. Commission percentages and
// payout workflow are deliberately deferred to PR-AFFILIATE-1 — this
// PR's job is to capture WHO brought the lead in, not how much they
// get paid.
//
// `AffiliateAgent`        — a named human/partner who refers leads.
//                           Email/phone optional (some referrers are
//                           influencer accounts, not contactable people).
// `TrackingLink`          — one short URL per (channel, agent?, campaign?)
//                           combo. Each click increments `clickCount`
//                           AND writes a `TrackingLinkClick` row for
//                           per-click forensics. `agentId` is NULL for
//                           pure marketing-channel links (no affiliate).
// `TrackingLinkClick`     — one row per click. Captures ip / ua / referer
//                           so we can spot bot floods or audit
//                           inflated conversion counts.
//
// First-attribution-wins is enforced in code (Lead row's tracking columns
// are set only when null), not at the DB level — the spec is explicit
// that the channel that brought a lead in keeps the credit.
enum MarketingChannelType {
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  TWITTER
  WHATSAPP
  EMAIL
  WIX_HOMEPAGE
  TELEGRAM
  TIKTOK
  FACEBOOK
  DIRECT
  OTHER
}

enum AffiliateAgentStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum TrackingLinkStatus {
  ACTIVE
  ARCHIVED
}

model AffiliateAgent {
  id          String               @id @default(uuid())
  fullName    String               @db.VarChar(200)
  email       String?              @db.VarChar(200)
  phone       String?              @db.VarChar(64)
  status      AffiliateAgentStatus @default(ACTIVE)
  notes       String?              @db.Text
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // ── PR-AGENT-PORTAL phase 0 ────────────────────────────────────────────────

  /// The login this agent signs in with, once they have one.
  ///
  /// Nullable and added late on purpose: agents existed as attribution records
  /// long before they could log in, and an agent the Owner is still onboarding
  /// has no account yet. One User to one AffiliateAgent — an account cannot
  /// stand for two agents, which would make attribution ambiguous.
  userId String? @unique
  user   User?   @relation("AffiliateAgentLogin", fields: [userId], references: [id], onDelete: SetNull)

  /// True when this agent is themselves a licensed immigration adviser handling
  /// their own clients' visa work, rather than only introducing clients.
  ///
  /// One model with a flag, not two models: everything about attribution,
  /// commission and payables is identical for both, and only the extra
  /// obligations differ. An LIA-type agent's User carries role LIA, so every
  /// existing case gate applies to them unchanged — including that, once
  /// assigned as case.liaId, they see that case exactly as any staff LIA does.
  /// That is intended, not an oversight.
  isLiaType Boolean @default(false)

  /// This agent's share of a provider commission, as a percentage.
  ///
  /// Null means "use the company default" (AGENT_COMMISSION_RATE_PERCENT). The
  /// rate is still snapshotted onto every AgentPayable at derivation, so
  /// changing it here can never restate what an agent has already been told
  /// they are owed.
  commissionRatePercent Float?

  // ── Verification: who this agent actually is ───────────────────────────────
  // Standard agents prove identity and that they are a real operating referral
  // business. LIA-type agents additionally hold an IAA licence, which lives on
  // LiaProfile against their User rather than being duplicated here.
  //
  // Documents follow the case-document pattern: the bytes live in R2 and only
  // the key plus display metadata are stored. Nothing is served from disk.

  /// Passport or national ID.
  idDocumentR2Key      String?
  idDocumentName       String?
  idDocumentMime       String?
  idDocumentSizeBytes  Int?
  idDocumentUploadedAt DateTime?

  /// Evidence of a real operating business — company registration, tax
  /// registration, a bank statement header, letterhead. Free text rather than
  /// an enum because the acceptable set will change with each country the
  /// company recruits from, and a human is reading it either way.
  businessDocumentR2Key      String?
  businessDocumentName       String?
  businessDocumentMime       String?
  businessDocumentSizeBytes  Int?
  businessDocumentType       String?   @db.VarChar(120)
  businessDocumentUploadedAt DateTime?

  /// The Owner's decision on the documents above. Verified means the documents
  /// were reviewed and accepted — it says nothing about the contract, which is
  /// the separate half of the gate.
  verifiedAt                  DateTime?
  verifiedById                String?
  verifiedBy                  User?     @relation("AffiliateAgentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  /// Why verification was refused. Kept so a resubmission can answer it.
  verificationRejectedAt      DateTime?
  verificationRejectionReason String?   @db.Text

  // ── PR-AGENT-PORTAL phase 1: the contract half of the gate ─────────────────
  // An agent may do nothing in the portal until they are BOTH verified and
  // under contract. Verification is above; this is the other half.

  /// When the agent came under contract. Set by the DocuSeal flow in phase 3,
  /// or by an Owner override until that exists.
  contractSignedAt DateTime?

  /// TRUE when a human cleared this rather than the agent signing anything.
  ///
  /// The distinction has to survive phase 3, when real signatures start
  /// arriving in the same column. Without it, an override recorded today
  /// becomes indistinguishable from a signed agreement later, and nobody can
  /// tell which agents actually have one on file. The UI reads this flag and
  /// says "manually cleared", never "signed".
  contractIsManualOverride Boolean @default(false)

  /// Who cleared it, and why. The name is snapshotted because the JWT carries
  /// none and because an audit trail that turns into a bare id is not a trail.
  /// The reason is required at the service boundary: "why is this agent live
  /// without a contract" is exactly the question asked months later.
  contractClearedById   String?
  contractClearedByName String?
  contractClearedReason String? @db.Text

  createdBy       User           @relation("AffiliateAgentCreator", fields: [createdById], references: [id])
  trackingLinks   TrackingLink[]
  attributedLeads Lead[]         @relation("LeadAttributedAgent")
  payables        AgentPayable[]

  @@index([status, fullName])
  @@index([isLiaType])
  @@map("affiliate_agents")
}

model TrackingLink {
  id            String               @id @default(uuid())
  shortCode     String               @unique @db.VarChar(16)
  channel       MarketingChannelType
  agentId       String?
  campaignLabel String?              @db.VarChar(200)
  destination   String               @db.Text
  status        TrackingLinkStatus   @default(ACTIVE)
  // Aggregated counter — incremented on /s/:shortCode redirect.
  // We keep this denormalised so the index page can show click totals
  // without scanning the click table; `TrackingLinkClick` is the
  // source of truth for forensics.
  clickCount    Int                  @default(0)
  createdById   String
  createdAt     DateTime             @default(now())
  archivedAt    DateTime?

  createdBy       User                @relation("TrackingLinkCreator", fields: [createdById], references: [id])
  agent           AffiliateAgent?     @relation(fields: [agentId], references: [id])
  clicks          TrackingLinkClick[]
  attributedLeads Lead[]              @relation("LeadAttributedLink")

  @@index([channel, createdAt])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
  @@map("tracking_links")
}

model TrackingLinkClick {
  id        String   @id @default(uuid())
  linkId    String
  clickedAt DateTime @default(now())
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  referer   String?  @db.Text

  link TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
  @@map("tracking_link_clicks")
}

// ─── PR-SCORECARD-4 ─ Wix payment integration ────────────────────────────────

enum WixPaymentType {
  FREE_15MIN
  GAP_CLOSING
  LIA_CONSULTATION
  OTHER
}

enum WixPaymentStatus {
  RECEIVED
  REFUNDED
  DISPUTED
}

// One Wix payment / booking event. Created by the public webhook
// `POST /webhooks/wix/payment` (shared-secret authenticated).
// `wixPaymentId` is unique so retries from the Wix Automation are
// idempotent. `matchedLeadId` / `matchedUserId` are best-effort
// email matches captured at write time; the link is informational
// only — we do NOT auto-update lead status from this row (per
// strategic decision: payments are recorded, never actioned).
model WixPayment {
  id              String           @id @default(uuid())
  wixPaymentId    String           @unique @db.VarChar(200)
  wixBookingId    String?          @db.VarChar(200)
  paymentType     WixPaymentType
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @db.VarChar(3)
  status          WixPaymentStatus @default(RECEIVED)
  customerEmail   String           @db.VarChar(200)
  customerName    String?          @db.VarChar(200)
  customerPhone   String?          @db.VarChar(64)
  bookingStart    DateTime?
  bookingEnd      DateTime?
  bookingLocation String?          @db.VarChar(200)
  matchedLeadId   String?
  matchedUserId   String?
  rawPayload      Json
  receivedAt      DateTime         @default(now())

  matchedLead Lead? @relation("WixPaymentLead", fields: [matchedLeadId], references: [id])
  matchedUser User? @relation("WixPaymentUser", fields: [matchedUserId], references: [id])

  @@index([customerEmail, receivedAt])
  @@index([matchedLeadId])
  @@index([paymentType, receivedAt])
  @@index([status])
  @@map("wix_payments")
}

// ─── DOCUMENTS (R2-backed case attachments) ───────────────────────────
//
// Documents step 2 — sibling to the existing PR-LIA-5 review surface
// (AdmissionDocument / ApplicationDocument / VisaSupportingDocument +
// CaseDocumentReview), NOT a replacement. The bytes live in Cloudflare
// R2; this row holds the metadata + the opaque object key.
//
// Lifecycle: row is created PENDING when the backend issues a
// presigned upload URL; the browser flips it to UPLOADED on the
// confirm-upload callback, or to FAILED on abandon. The unique r2Key
// prevents two rows pointing at the same object.
//
// Enum name note: the obvious `DocumentStatus` was already taken by
// the legacy ApplicationDocument lifecycle (MISSING/UPLOADED/VERIFIED/
// REJECTED) at line ~277. Renamed here to `DocumentUploadStatus` so
// the two coexist without altering the legacy enum.

enum DocumentUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

// PR-AV slice 3 — malware scan state for case documents.
//
// These are the ONE upload path where the bytes reach storage before we can
// look at them: the browser PUTs straight to R2 with a presigned URL, so the
// backend never holds the file and there is no handler in which to refuse it.
// Scanning therefore happens after the fact, on a poll, and the download gate
// is what keeps an unscanned document unreachable in the meantime.
enum DocumentScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
  SCAN_ERROR
}

model Document {
  id            String               @id @default(cuid())
  caseId        String
  uploaderId    String
  r2Key         String               @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  status        DocumentUploadStatus @default(PENDING)
  // PR-AV slice 3. Existing rows land on PENDING_SCAN by the migration default,
  // which IS the backfill — the poll job picks them up like any new upload.
  scanStatus    DocumentScanStatus   @default(PENDING_SCAN)
  scanSignature String? // signature name when INFECTED
  scanCheckedAt DateTime? // last time the poll job looked at this row
  scanAttempts  Int                  @default(0)
  category      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  case     Case @relation("CaseDocuments", fields: [caseId], references: [id], onDelete: Cascade)
  uploader User @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([uploaderId])
  @@index([status])
  // The poll job's only query: rows awaiting a verdict, oldest first.
  @@index([scanStatus])
  @@map("documents")
}

// ─── DOMAIN 16 — COUNTRY INTELLIGENCE & MONETISATION CONFIG (partial) ──────────
// PR-OWNER-1 (slice a) — Owner-editable, PER-COUNTRY config that this phase
// scopes down to exactly two of RPD_16's nine sections:
//   • CountryExecutionConfig — the slot/ratio fields (§ Execution mode).
//   • CountryAIConfig + AIAgentConfig — the per-agent settings (§ AI config).
// The full 9-section CountryConfig validation gate (pricing, legal, visa, scoring,
// activation) is OUT OF SCOPE. There is intentionally NO Country model — country
// is keyed by ISO 3166-1 alpha-2 `countryCode` string, matching every existing
// convention (User.countryOfResidence, EducationProvider.country, …).
//
// Actor attribution follows the SlaConfig convention: `updatedById` is a bare
// column (NOT a Prisma relation) so this whole block is purely additive — it adds
// only new tables + enums and never ALTERs `users`. Who-did-what is captured in
// the audit_logs row (actorNameSnapshot / actorRoleSnapshot) on every mutation.

// Per-country execution config. 1:1 with a country (unique countryCode).
model CountryExecutionConfig {
  id          String @id @default(cuid())
  countryCode String @unique // ISO 3166-1 alpha-2 (e.g. "NZ")

  // Total priority slots offered to a student over the whole journey (PRD_4 §8).
  slotCount Int @default(5)

  // PR-INTAKE-1 — intake-timing rules (Owner-editable, genuinely per-country: they
  // encode this destination's visa-processing SLA + LIA lead time).
  //   intakeMinLeadMonths  — earliest intake OFFERED to a student = at least this
  //                          many months out (the "5-month rule" floor).
  //   intakeMaxWindowMonths — offer/eligibility ceiling (display window cap).
  //   liaLeadMonths        — a completed application must be SUBMITTED at least this
  //                          many months before the assigned intake's start (LIA
  //                          needs the file this early; the "4-month rule").
  intakeMinLeadMonths   Int @default(5)
  intakeMaxWindowMonths Int @default(12)
  liaLeadMonths         Int @default(4)

  // PR-SLOTRULES — Owner-configurable mandatory institution-type rule. JSON object:
  //   { enabled: Bool, mandatorySlots: [{ position: Int, institutionType: InstitutionType }] }
  // Each mandatory position requires exactly that type at that priority; every other
  // position is unconstrained. enabled:false or empty mandatorySlots => rule off. All three
  // institution types are equal, symmetric entries. e.g. NZ default: pos 4 = ITP, pos 5 = PTE.
  slotRules Json

  // Default recommendation sort weighting by institution type. JSON object keyed
  // by InstitutionType, higher = ranked earlier. Replaces the (never-implemented)
  // hardcoded "College > Polytechnic > University" default. NZ default encodes
  // PTE > ITP > UNIVERSITY (College > Polytechnic > University in InstitutionType
  // vocabulary — see the seed for the mapping, which is editable via this table).
  institutionTypeWeighting Json

  // Bare actor column — NOT a User relation (SlaConfig convention). Nullable so a
  // seed/migration row can exist before any human edit.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("country_execution_configs")
}

// AI guidance strictness (PRD_13 §7 — NZ vs non-NZ posture).
enum AIGuidanceLevel {
  STRICT
  MODERATE
  LOW
}

// The 9 AI agents (PRD_13). Names checked against the existing referral-agency
// models (AffiliateAgent) — no collision; these are AI agents.
enum AIAgentType {
  USER_GUIDANCE
  COUNTRY_COMPARE
  QUALIFICATION_SUPPORT
  RECOMMENDATION_EXPLAIN
  CASE_ASSISTANT
  SOP_GENERATION
  CV_GENERATION
  AI_COMPANION
  AUTOMATION_TRIGGER
}

// Prompt governance lifecycle (PRD_13 §8). This phase ships the MODEL as a stub
// (versioned storage) — the Draft→Review→Approve→Deploy review-workflow UI is
// deferred; if a review/approval step is wanted later it reuses the existing
// OwnerApprovalRequest pattern (SUPER_ADMIN proposes → OWNER approves), NOT a new
// role. No "Compliance Admin" role exists in this system.
enum PromptVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  DEPLOYED
  RETIRED
}

enum PromptType {
  SYSTEM
  COUNTRY
  DOMAIN
  TASK
  ESCALATION
}

// Per-country AI config (1:1 with a country). Parent of the per-agent rows.
model CountryAIConfig {
  id          String @id @default(cuid())
  countryCode String @unique // ISO 3166-1 alpha-2

  guidanceLevel      AIGuidanceLevel @default(MODERATE)
  sopGateEnforcement Boolean         @default(true) // are the 3 SOP quality gates enforced

  // Country-level active prompt (an agent row may override with its own).
  activePromptVersionId String?
  activePromptVersion   PromptVersion? @relation("CountryAIActivePrompt", fields: [activePromptVersionId], references: [id])

  agents AIAgentConfig[]

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("country_ai_configs")
}

// Per-agent settings within a country's AI config. One row per (country, agent).
model AIAgentConfig {
  id                String @id @default(cuid())
  countryAIConfigId String

  agentType AIAgentType
  enabled   Boolean     @default(true)

  // How many options this agent surfaces to a student in one interaction. Only
  // meaningful for surfacing agents (e.g. RECOMMENDATION_EXPLAIN); null = n/a.
  // NOTE: distinct from CountryExecutionConfig.slotCount (the committed 1..N
  // priority list) — see the handover for the slotCount-vs-maxOptionsShown note.
  maxOptionsShown Int?

  // Agent-specific prompt override (falls back to the country active prompt).
  promptVersionId String?
  promptVersion   PromptVersion? @relation("AIAgentPrompt", fields: [promptVersionId], references: [id])

  // Catch-all for agent-specific knobs not worth a dedicated column yet.
  settingsJson Json?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  countryAIConfig CountryAIConfig @relation(fields: [countryAIConfigId], references: [id], onDelete: Cascade)

  @@unique([countryAIConfigId, agentType])
  @@index([countryAIConfigId])
  @@map("ai_agent_configs")
}

// Versioned prompt (governance stub this phase — see PromptVersionStatus note).
// createdById/reviewedById/approvedById are bare columns (no User relation),
// consistent with the rest of this block.
model PromptVersion {
  id         String              @id @default(cuid())
  promptType PromptType
  label      String
  content    String              @db.Text
  version    Int                 @default(1)
  status     PromptVersionStatus @default(DRAFT)

  createdById  String?
  reviewedById String?
  approvedById String?
  deployedAt   DateTime?
  retiredAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Back-relations (both sides are new tables — no existing model touched).
  activeForCountries CountryAIConfig[] @relation("CountryAIActivePrompt")
  agentConfigs       AIAgentConfig[]   @relation("AIAgentPrompt")

  @@index([promptType, status])
  @@map("prompt_versions")
}

// ─── RECOMMENDATION LISTS (PR-RECS-1, slice 1) ────────────────────────────────
// A persisted, client-viewable ranked recommendation list per Case (PRD_4 §8 +
// Recommendation_Domain §8). Generated from a resolved MatchCriteria (via the
// resolveMatchCriteria seam — Impl A reverse-maps the live /scorecard submission
// today; Impl B swaps in the full-fidelity v2 /assessment later without touching
// this schema). 1:many per case — regeneration writes a NEW list and marks the
// prior one SUPERSEDED. Hung off Case so the Admission Specialist (Case.ownerId)
// sees it via the existing case-access pattern. Slot selection (slice 2) will
// reference a CONFIRMED list. Purely additive: new tables only.

enum RecommendationListStatus {
  GENERATED // freshly produced, not yet reviewed
  VIEWED // client opened it
  CONFIRMED // slice 2 — priority slots locked (reserved)
  SUPERSEDED // a newer regeneration replaced it
}

enum RecommendationCriteriaSource {
  SCORECARD // Impl A — reverse-mapped from the live /scorecard submission
  ASSESSMENT // Impl B — full-fidelity v2 /assessment (future drop-in)
}

model RecommendationList {
  id             String                       @id @default(cuid())
  caseId         String
  status         RecommendationListStatus     @default(GENERATED)
  criteriaSource RecommendationCriteriaSource
  // Snapshot of the resolved MatchCriteria used to generate this list — for
  // reproducibility/audit + a "based on X" summary. No PII (StudyField ids,
  // levels, bands; nationality is an ISO code).
  criteriaJson   Json
  generatedAt    DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  case  Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  items RecommendationItem[]

  @@index([caseId])
  @@index([caseId, status])
  @@map("recommendation_lists")
}

model RecommendationItem {
  id                   String           @id @default(cuid())
  recommendationListId String
  programmeId          String
  rank                 Int // 1-based ranked position at generation
  fitScore             Float // FROZEN snapshot — depends on Owner-editable config
  institutionType      InstitutionType? // snapshot — drives slice-2 slot rules + display
  whyJson              Json? // whyThisFits dimensions snapshot
  createdAt            DateTime         @default(now())

  recommendationList RecommendationList @relation(fields: [recommendationListId], references: [id], onDelete: Cascade)
  programme          EducationProgramme @relation(fields: [programmeId], references: [id])

  @@unique([recommendationListId, programmeId])
  @@index([recommendationListId])
  @@map("recommendation_items")
}

// ─── ADMISSION OFFICER TASKS (PR-INTAKE-1, Slice 3) ───────────────────────────
// A minimal, focused to-do surface for the Admission Officer, created by the
// submit-time intake-reassignment flow. INTAKE_REASSIGNED = the system moved the
// student to a new term (routine follow-up: re-apply for it). INTAKE_REASSIGN_FAILED
// = no valid next term found (urgent: manual review). Assigned to the case's
// Admission Specialist (Case.consultantId); null → unassigned queue. Deliberately
// NOT overloading NurtureCallTask (nurture-call-specific). Actor columns are bare
// (no User relation) to keep the migration additive.
enum AdmissionTaskType {
  INTAKE_REASSIGNED
  INTAKE_REASSIGN_FAILED
  // PR-ADMISSION-FOLLOWUP (step 5) — raised by the daily sweep when a submission is still PENDING
  // 5 working days after submittedAt; referenceId = the SubmissionRecord id.
  SUBMISSION_FOLLOW_UP
}

enum AdmissionTaskStatus {
  OPEN
  DONE
}

model AdmissionTask {
  id           String              @id @default(cuid())
  caseId       String
  assignedToId String? // = Case.consultantId at creation; null → unassigned queue
  type         AdmissionTaskType
  status       AdmissionTaskStatus @default(OPEN)
  urgent       Boolean             @default(false) // true for INTAKE_REASSIGN_FAILED
  title        String // human, e.g. "Re-apply Maryam for Feb 2027 (Bachelor of IT)"
  referenceId  String? // the AdmissionProgrammeChoice id, when applicable
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([assignedToId, status])
  @@index([caseId])
  @@map("admission_tasks")
}

// ─── PROGRAMME CATALOG PROVENANCE + CHANGE REVIEW (PR-CATALOG-1) ───────────────
// Every programme change — new or updated, manual or automated — enters one review
// queue as PENDING, tagged by source; nothing is auto-approved. Piece 1 uses the
// `source`/`sourceRef` fields on EducationProgramme (new programmes). The
// ProgrammeChangeProposal model is created NOW but its producer (the monthly web
// check) is Piece 2 — designing the shape now means Piece 2 needs no migration.
enum ProgrammeSource {
  MANUAL_EXCEL
  MANUAL_ENTRY
  AUTOMATED_WEB_CHECK
}

enum ChangeProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A proposed change to an already-APPROVED programme (e.g. a fee/intake update
// detected by the Piece-2 web check). Held for per-programme Owner review — never
// overwrites the live programme before approval. Empty until Piece 2.
model ProgrammeChangeProposal {
  id            String               @id @default(cuid())
  programmeId   String
  source        ProgrammeSource
  changedFields Json // { tuitionFeeNZD: {from, to}, intakeMonths: {from, to}, … }
  sourceUrl     String?
  detectedAt    DateTime             @default(now())
  status        ChangeProposalStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?

  programme EducationProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([programmeId])
  @@map("programme_change_proposals")
}

// PR-CATALOG-2 — a NEW-programme candidate discovered by the monthly catalogue crawl
// (Pass B). Unlike ProgrammeChangeProposal (a diff to an EXISTING programme), a
// candidate has no programme yet — it belongs to a provider and carries a full
// extracted record in proposedData. Held for per-programme Owner review in the same
// queue; on approval it materialises a real EducationProgramme via the shared importer
// path. Never auto-published, regardless of confidence. Empty until the crawl runs.
model ProgrammeCandidate {
  id             String               @id @default(cuid())
  providerId     String
  source         ProgrammeSource // AUTOMATED_WEB_CHECK (reuses the Piece-1 enum)
  sourceUrl      String // the programme page it was extracted from
  proposedData   Json // full extracted record, shaped for rowToProgrammeData → upsert
  confidence     Float? // extractor self-assessed 0..1 (drives the review bucket, never publish)
  detectedFields String[] // which required fields were actually found on the page
  // Dedupe natural key — also blocks a REJECTED candidate from resurfacing next sweep.
  nameNormalized String
  nzqfLevel      String?
  campusCity     String?
  status         ChangeProposalStatus @default(PENDING) // reuses the Piece-1 enum
  reviewedById   String?
  reviewedAt     DateTime?
  detectedAt     DateTime             @default(now())

  provider EducationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerId])
  @@index([providerId, nameNormalized, nzqfLevel, campusCity])
  @@map("programme_candidates")
}


// PR-WEBINAR-1 — website (sorenavisa.com) → Sorena Study webinar integration.
//
// The website's existing `/api/webinar-registration` server route calls this
// platform server-to-server (SORENA_STUDY_WEBINAR_API_URL + _API_KEY on the
// website side); today that call 503s because no receiving endpoint exists.
// This is that endpoint's schema.
//
// `slug` is the externally-addressable identifier — the website never sees or
// stores our internal cuid, only the slug, so webinars can be created/rotated
// here without coordinating a deploy on the website side. The live site sends
// `eventSlug: "study-in-new-zealand-weekly"` (hardcoded in its registration
// component), so a Webinar row must carry exactly that slug or every real
// registration 404s.
//
// PR-WEBINAR-2 — `slug` is deliberately NOT unique. "study-in-new-zealand-weekly"
// is a genuinely recurring weekly series under one static slug, and the same
// person legitimately registers again for a later week — that must succeed, not
// bounce as a duplicate. So each week's session is its own Webinar ROW (its own
// id, its own startsAt) sharing the slug; `register()` resolves a slug to the
// next upcoming occurrence, and the existing `@@unique([webinarId, email])`
// dedupe now scopes to ONE week's session rather than the whole series.
//
// `recurrenceDays` (set once on the first row, e.g. 7) drives the automatic
// clone in WebinarsRecurrenceCron, so nobody has to remember to create next
// week's row. Leave it null for a genuine one-off event.
model Webinar {
  id             String        @id @default(cuid())
  slug           String
  title          String
  description    String?
  startsAt       DateTime
  durationMin    Int
  speaker        String?
  topic          String?
  joinUrl        String?
  status         WebinarStatus @default(SCHEDULED)
  recurrenceDays Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  registrations WebinarRegistration[]

  @@index([startsAt])
  @@index([slug])
  @@map("webinars")
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

// One row per (webinar, email) — deliberately linked to the existing `Lead`
// (via Lead.clientId as the authoritative shared reference) rather than a new
// lead-like entity, per the schema's "reuse before you add" review.
model WebinarRegistration {
  id                  String   @id @default(cuid())
  webinarId           String
  leadId              String
  email               String
  fullName            String
  phone               String?
  countryOfResidence  String?
  intendedStudyLevel  String?
  intake              String?
  // "What would you most like us to explain?" — free-text from the
  // website's own registration form; the site's copy promises it reaches
  // Sorena Study, so it's captured for staff review even though no
  // automation reads it yet.
  question            String?  @db.Text
  operationalConsent  Boolean  @default(true)
  marketingConsent    Boolean?
  attended            Boolean  @default(false)
  attendedDurationMin Int?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  landingPage         String?
  createdAt           DateTime @default(now())

  webinar        Webinar               @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  lead           Lead                  @relation(fields: [leadId], references: [id])
  emailDeliveries WebinarEmailDelivery[]

  @@unique([webinarId, email])
  @@index([leadId])
  @@map("webinar_registrations")
}

// Durable, idempotent lifecycle queue for operational webinar emails.
// One row per registration + lifecycle message prevents duplicate sends,
// records delivery attempts, and lets the cron safely retry transient failures.
model WebinarEmailDelivery {
  id                String             @id @default(cuid())
  registrationId    String
  kind              WebinarEmailKind
  status            WebinarEmailStatus @default(PENDING)
  scheduledFor      DateTime
  nextAttemptAt     DateTime?
  attempts          Int                @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  registration WebinarRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, kind])
  @@index([status, nextAttemptAt])
  @@index([scheduledFor])
  @@map("webinar_email_deliveries")
}

enum WebinarEmailKind {
  CONFIRMATION
  REMINDER_24H
  REMINDER_1H
  REMINDER_10M
  SCORECARD_FOLLOWUP
}

enum WebinarEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  // Pre-existing values — kept verbatim to avoid breaking any row
  // already populated with them (per PR-CONSULT-1's "no auto-migration
  // of role values" rule). Existing staff users keep their current role.
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  LIA
  SUPPORT
  // PR-SCORECARD-1: leads who have submitted the Readiness
  // Assessment but haven't paid for an account yet. Sits between
  // "anonymous visitor" and "STUDENT" in the funnel.
  LEAD
  STUDENT
  AGENT
  // PR-CONSULT-1 additions for the staff-roles foundation.
  // OWNER is the only role that can approve owner-approval requests
  // (destructive / sensitive actions enqueued by SUPER_ADMIN).
  // CONSULTANT and FINANCE are new functional staff slots on VisaCase.
  OWNER
  CONSULTANT
  FINANCE
  // Phase 1 (auto-assignment): the real client Consultant (owns the client from
  // eligibility to visa result). DISTINCT from CONSULTANT, which is the
  // "Admission Specialist" slot (Case.ownerId). Held in Case.consultantId.
  CLIENT_CONSULTANT
  // PR-PROVIDER-PORTAL slice A — an education institution logging in to manage
  // its OWN catalogue. Additive per the no-auto-migration rule above: no
  // existing row changes, and nothing reads this value until slice B.
  PROVIDER
}

// PR-STAFF-RENAME — the staff-portal role taxonomy. "Staff" is the umbrella
// for everyone who logs into the staff portal; each has exactly one of these.
// ADVISER = LIA advisers only (no longer the umbrella). Distinct from the
// legacy `UserRole` (kept for auth guards + booking) and from the guard
// allow-list type `StaffAccessRole`.
enum StaffRole {
  ADMIN
  ADVISER
  SUPPORT_CONSULTANT
  ADMISSION_CONSULTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTAKE_STARTED
  INTAKE_COMPLETED
  SCORING_DONE
  QUALIFIED
  NURTURE
  EXECUTING
  CLOSED_WON
  CLOSED_LOST
  DISQUALIFIED
}

enum ScoreBand {
  LOW
  MID
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

// PR-LIA-1: formal outcomes the LIA can record on a Case. Set on a
// LegalNote row when the LIA records a decision; null when the row
// is just a free-form note (or a system-generated audit-paired note).
enum LegalDecision {
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
  WITHDRAWN
}

// PR-LIA-4: direct messaging between the LIA and the client on a CRM
// Case. Two author roles only — system events go through AuditLog.
enum CaseMessageAuthorRole {
  LIA
  CLIENT
}

// PR-LIA-4: thread-row kind. MESSAGE is a free-form message either
// way. DOCUMENT_REQUEST is an LIA → client ask for a specific document
// (the client links one of their existing VisaSupportingDocument rows
// to fulfil it). PROGRESS_UPDATE is an LIA-authored status broadcast
// (rendered full-width on the client side).
enum CaseMessageKind {
  MESSAGE
  DOCUMENT_REQUEST
  PROGRESS_UPDATE
}

// PR-LIA-5: which source table a CaseDocumentReview points at. The
// review row lives in its own table — we never modify the source
// models. The original document is keyed by the matching (source,
// sourceRowId) pair. The user's spec named a fourth source
// (CASE_MESSAGE_FULFILMENT) which is really just a VisaSupportingDocument
// linked through a CaseMessage; the canonical row lives in
// visa_supporting_documents either way, so VISA_SUPPORTING covers it.
enum CaseDocumentReviewSource {
  ADMISSION
  APPLICATION
  VISA_SUPPORTING
}

// PR-LIA-5: the LIA's verdict on a single document. UNREVIEWED is
// the implicit default (no row exists); only APPROVED / REJECTED
// rows are stored. Re-reviewing upserts the existing row.
enum CaseDocumentReviewStatus {
  APPROVED
  REJECTED
}

enum RecommendedRoute {
  CONTENT_NURTURE
  WEBINAR
  ROADMAP
  ADMISSION_CONSULTATION
  SPECIALIST_CONSULTATION
  LIA_CONSULTATION
  EXECUTION_QUEUE
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  PREMIUM
  CONTINUITY
}

enum SubscriptionStage {
  STAGE_1
  STAGE_2
  STAGE_3
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum ConsultationType {
  ADMISSION
  LIA
  // PR-BOOKING-1: native in-portal session types. FREE_15 (15min, free)
  // and GAP_CLOSING (30min, NZD 30) join the existing ADMISSION/LIA.
  // LIA (45min, NZD 150) is reused as-is. Durations/prices live in the
  // code config map (session-config.ts), not here.
  FREE_15
  GAP_CLOSING
}

enum ConsultationStatus {
  PENDING
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// PR-WALLET slice 3: how a paid booking was settled. NULL for legacy rows and
// FREE_15 (nothing collected). CARD = Stripe PaymentIntent; WALLET = store
// credit spent (SPEND_BOOKING ledger entry, no Stripe Payment row). The refund
// path reads this to know where to compute the tier base from.
enum PaymentMethod {
  CARD
  WALLET
}

// Phase 6.5 — finance staff verification state for each Payment row.
// Distinct from PaymentStatus (which tracks the Stripe/manual outcome):
// a payment can be Stripe-`succeeded` AND verification-`PENDING` until
// finance signs off. CONFIRMED = staff approved. REJECTED = staff
// flagged it (wrong amount, bad receipt, suspected duplicate).
enum PaymentVerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum TicketStatus {
  OPEN
  AWAITING_CLIENT
  AWAITING_STAFF
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

// PR-LIA-AUTO-ASSIGN Phase 6 (Option A): the PaymentMethod and
// InvoicePaymentStatus enums + the dead invoice-line `Payment` model
// were removed in favour of a Stripe-webhook-event `Payment` model
// (see the new model further down). The AR domain (invoice line-item
// payments) will be redesigned when the student invoice receipts
// page ships out of "Coming soon" — at that point the new model can
// either grow `invoiceId` or sit alongside a fresh `InvoicePayment`.

enum CaseStage {
  ADMISSION
  VISA
  // PR-LIA-7: LIA has submitted the application to Immigration NZ.
  // Captured along with INZ reference number, submitted-at timestamp,
  // payment-receipt file, and optional LIA notes. Set by
  // POST /cases/:id/inz-submission; can be reverted while the visa
  // hasn't been issued (next workflow PR).
  INZ_SUBMITTED
  COMPLETED
  WITHDRAWN
}

enum ApplicationStatus {
  PREPARATION
  SUBMITTED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  VISA_SUBMITTED
  VISA_APPROVED
  VISA_DECLINED
  WITHDRAWN
}

enum AgentPayableStatus {
  PENDING
  APPROVED
  PAID
  /// Terminal. Finance decided this share is not owed. The row is never
  /// resurrected — a fresh payable may be derived for the same commission if the
  /// situation changes, and the refusal stays on record beside it.
  REJECTED
}

enum CommissionTriggerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  ESTIMATED
  CONFIRMED
  INVOICED
  PAID
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum ProviderType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE
  SCHOOL
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum QualificationLevel {
  CERTIFICATE // PR-PHASE34 — NZ Certificate (NZQF 3–5); lowest rung of the ladder
  DIPLOMA
  GRADUATE_CERTIFICATE
  GRADUATE_DIPLOMA
  BACHELOR
  POSTGRADUATE_CERTIFICATE
  POSTGRADUATE_DIPLOMA
  MASTER
  PHD
}

// PR-PHASE34 — NZ regulatory institution type (distinct from the looser
// providerType). Authoritative for the staff approval UI + institution grouping.
enum InstitutionType {
  UNIVERSITY
  ITP // Institutes of Technology and Polytechnics
  PTE // Private Training Establishments
}

// PR-PHASE34 — data-verification state of an imported programme (distinct from
// reviewStatus, which is the staff decision to OFFER it).
enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  NEEDS_RECHECK
}

// PR-PHASE34 — intake basis, per the source Data Rules (projected 2027 dates must
// be reconfirmed before application; published dates are firm).
enum IntakeBasis {
  REMAINING // remaining intakes in the current year
  PUBLISHED // officially published future dates
  PROJECTED // projected/estimated — needs reconfirmation
}

enum NZQFLevel {
  LEVEL_3
  LEVEL_4
  LEVEL_5
  LEVEL_6
  LEVEL_7
  LEVEL_8
  LEVEL_9
  LEVEL_10
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStatus {
  MISSING
  UPLOADED
  VERIFIED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

// PR-DOCUSIGN-1 step 2: per-signer roles. CLIENT / LIA / DIRECTOR are
// wired at soft-launch (adult-student flow); GUARDIAN is wired at
// soft-launch too (under-18 student flow — guardian signs INSTEAD of
// the minor). PARTNER and FAMILY_MEMBER ship in the enum but no flow
// constructs envelopes with those roles until the post-launch
// family-visa work; values present now so that work is additive code,
// not an enum migration.
enum ContractSignerRole {
  CLIENT
  GUARDIAN
  PARTNER
  FAMILY_MEMBER
  LIA
  DIRECTOR
}

// PR-DOCUSIGN-1 step 2: per-signer state. Mirrors DocuSign recipient
// statuses (created/sent/delivered/completed/declined). PENDING is the
// default for non-first signers — they're queued behind a routing-order
// predecessor and haven't received the envelope yet.
enum ContractSignerStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
}

enum EventSource {
  AI
  OPS
  LEGAL
  SYSTEM
  USER
}

enum EventProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum ConsentType {
  PRIVACY
  MARKETING
}

enum HandoffStatus {
  PENDING
  SENT
  FAILED
}

enum WhatsAppConversationStatus {
  NEW
  ASSIGNED
  WAITING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  emailHash         String?    @unique
  // Option C step 1 — passwordHash is now optional. Users created
  // before Option C still have a bcrypt hash here. Users provisioned
  // via Google OAuth or first-time magic-link sign-in won't have one.
  // The login service must guard against null before calling
  // bcrypt.compare.
  passwordHash      String?
  // Option C step 1 — Google "sub" claim from OAuth ID-token. Null
  // until the user links Google. @unique prevents two app users from
  // binding the same Google account.
  googleId          String?    @unique
  /// No default, deliberately. It used to default to SALES, which was harmless
  /// only while SALES could reach nothing; now that the role is active, a user
  /// created without one would silently receive a working staff account. There
  /// is no "unassigned" value to fall back to, so the role is simply required —
  /// every create in the codebase already passes one explicitly, and dropping
  /// the default makes the compiler keep it that way.
  role              UserRole
  // Secondary roles WIDEN access only — they never change `role` (which still
  // drives login, routing, and the UI badge), never narrow access, and default
  // to empty so every existing row is unaffected. Permission gates (RolesGuard,
  // frontend middleware) accept `role` OR any of these.
  secondaryRoles    UserRole[] @default([])
  // PR-STAFF-RENAME: descriptive staff-portal role. Coexists with `role`
  // (which still drives auth guards + booking's LIA gate). Null for
  // non-staff users (LEAD/STUDENT/AGENT). Backfilled from `role` by
  // migration: LIA→ADVISER, ADMIN/OWNER/SUPER_ADMIN→ADMIN,
  // SUPPORT→SUPPORT_CONSULTANT, CONSULTANT→ADMISSION_CONSULTANT.
  staffRole         StaffRole?
  canEditGlobalData Boolean    @default(false)
  isActive          Boolean    @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // PR-CONSULT-4: staff profile fields. All three encrypted columns
  // store base64-encoded AES-256-GCM ciphertext via CryptoService.
  // countryOfResidence is plain text (ISO 3166-1 alpha-2 code) so
  // we can filter / aggregate without decrypting. All four nullable
  // because existing rows pre-date the migration.
  mobileNumber       String?
  countryOfResidence String?
  address            String?
  emergencyContact   String?

  // PR-LIA-2: ISO 3166-1 alpha-2 codes a User is "specialised" in
  // (LIA forward-compat; the future country-router will read this).
  // PR-LIA-2 auto-assignment ignores it — empty array means "general".
  specialisedCountries String[] @default([])

  // PR-BOOKING-ADMIN-A: staff booking configuration, set by OWNER/ADMIN
  // in the /staff/team panel. All additive + defaulted.
  //   languages            — ISO 639-1 codes the staff member speaks (future
  //                          client language filter reads these).
  //   timezone             — the staff member's canonical IANA zone (source of
  //                          truth; mirrored into StaffAvailability rows
  //                          on save so the slot engine stays correct).
  //   bookableSessionTypes — which session types this staff member handles
  //                          (reuses the ConsultationType enum). LIA still
  //                          additionally requires a verified LiaProfile.
  //   bookingActive        — quick on/off without clearing config.
  languages            String[]           @default([])
  timezone             String             @default("Pacific/Auckland")
  // PR-STAFF-PHOTOS: Cloudflare R2 object key for the staff member's profile
  // photo. Nullable (no backfill); a presigned download URL is derived at read
  // time. Additive column — safe, reversible.
  photoKey             String?
  bookableSessionTypes ConsultationType[] @default([])
  bookingActive        Boolean            @default(true)

  assignedLeads     Lead[]                 @relation("LeadOwner")
  consultations     Consultation[]         @relation("ConsultationStaff")
  cases             Case[]                 @relation("CaseOwner")
  // PR-LIA-2: cases where this user is the assigned LIA.
  liaCases          Case[]                 @relation("CaseLia")
  // Option 1 step 4: cases where this user is the assigned
  // Support or Finance staff (parallel to liaCases).
  supportCases      Case[]                 @relation("CaseSupport")
  financeCases      Case[]                 @relation("CaseFinance")
  // Phase 1 (auto-assignment): cases where this user is the assigned Consultant.
  consultantCases   Case[]                 @relation("CaseConsultant")
  // Documents step 2: case attachments this user has uploaded.
  uploadedDocuments Document[]             @relation("DocumentUploader")
  auditLogs         AuditLog[]
  notesAuditLogs    ManagerNotesLog[]
  leadStatusChanges LeadStatusHistory[]
  contact           Contact?               @relation("StudentContact")
  assignedTickets   Ticket[]               @relation("TicketAssignee")
  createdTickets    Ticket[]               @relation("TicketCreator")
  ticketMessages    TicketMessage[]        @relation("TicketMessageSender")
  agentApplications AdmissionApplication[] @relation("ApplicationAgent")

  // PR-DASH-1: client dashboard relations. `clientVisaCases` are the
  // dashboard-side visa cases this user OWNS as a student (1:1 with
  // their VisaApplication). `consultantVisaCases` are visa cases this
  // user is ASSIGNED TO as a consultant. `assessmentReport` is the
  // Friday AI scoring bot's writeback target (1:1 per student).
  clientVisaCases     VisaCase[]        @relation("VisaCaseClient")
  consultantVisaCases VisaCase[]        @relation("VisaCaseConsultant")
  assessmentReport    AssessmentReport?

  // PR-DASH-2: support-ticket relations.
  // `visaSupportTicketsAsClient`: tickets this user opened.
  // `visaSupportTicketsAsStaff`: tickets assigned to this user.
  // `visaSupportTicketMessages`: messages authored by this user
  // (CLIENT or STAFF).
  // `visaCaseFileNotesCreated`: file notes created by this user
  // (nullable on the row — system-generated notes have no author).
  visaSupportTicketsAsClient VisaSupportTicket[]        @relation("VisaSupportTicketClient")
  visaSupportTicketsAsStaff  VisaSupportTicket[]        @relation("VisaSupportTicketStaff")
  visaSupportTicketMessages  VisaSupportTicketMessage[]
  visaCaseFileNotesCreated   VisaCaseFileNote[]         @relation("VisaCaseFileNoteCreator")

  // PR-DASH-3: meetings + transcripts.
  // `studentMeetings`: meetings this user is the student (client) on.
  // `consultantMeetings`: meetings this user is consulting on.
  // `transcriptUploads`: transcript metadata rows this user uploaded.
  studentMeetings    VisaMeeting[]           @relation("StudentMeetings")
  consultantMeetings VisaMeeting[]           @relation("ConsultantMeetings")
  transcriptUploads  VisaMeetingTranscript[]

  // PR-DASH-4: in-platform AI chatbot (student-side, Pattern 1
  // escalation). Each student owns their conversations; nothing
  // crosses tenant boundaries.
  studentChatConversations VisaChatConversation[] @relation("StudentChatConversations")

  // PR-CONSULT-1: staff-roles foundation.
  // `staffAssignments`: VisaCaseAssignment rows where this user IS
  // the staff member (LIA / CONSULTANT / SUPPORT / FINANCE).
  // `assignmentsMade`: assignments this user CREATED (the actor side).
  // `ownerApprovalRequests`: requests this user (SUPER_ADMIN) raised.
  // `ownerApprovalDecisions`: requests this user (OWNER) decided.
  // `staffActiveStatus`: 1:1 soft-deactivation flag.
  staffAssignments       VisaCaseAssignment[]   @relation("StaffAssignments")
  assignmentsMade        VisaCaseAssignment[]   @relation("AssignmentsMade")
  ownerApprovalRequests  OwnerApprovalRequest[] @relation("OwnerApprovalRequester")
  ownerApprovalDecisions OwnerApprovalRequest[] @relation("OwnerApprovalDecider")
  staffActiveStatus      StaffActiveStatus?     @relation("StaffActive")

  // PR-LIA-1: LegalNote rows this user authored (notes + decisions
  // on CRM-side Cases). LIA / ADMIN / SUPER_ADMIN-gated at the
  // endpoint layer.
  legalNotes        LegalNote[]            @relation("LegalNoteAuthor")
  // PR-LIA-CONVO-NOTES: conversation notes this user (an LIA) authored.
  conversationNotes CaseConversationNote[] @relation("ConvNoteAuthor")

  // PR-NURTURE: nurture call tasks assigned to / completed by this staff member.
  nurtureCallTasksAssigned  NurtureCallTask[] @relation("NurtureCallAssignee")
  nurtureCallTasksCompleted NurtureCallTask[] @relation("NurtureCallCompleter")

  // PR-LIA-4: CaseMessage rows this user authored (either as the LIA
  // working the case, or as the case's client replying to the thread).
  caseMessages CaseMessage[] @relation("CaseMessageAuthor")

  // PR-LIA-5: CaseDocumentReview rows this user authored (LIA / OWNER
  // /  ADMIN / SUPER_ADMIN — the gate is enforced at the controller).
  documentReviews CaseDocumentReview[] @relation("CaseDocumentReviewer")

  // PR-LIA-8: Visa rows this user issued (recorded the approval or
  // decline outcome for). Same role gate as the rest of the LIA
  // surface — LIA / ADMIN / SUPER_ADMIN / OWNER.
  issuedVisas Visa[] @relation("VisaIssuer")

  // PR-LIA-10: Immigration Officer module relations.
  // `createdOfficers`     — officer profiles this user originally created.
  // `officerObservations` — observations this user authored (immutable
  //                         post-creation; only the author can delete
  //                         their own per Decision 2C).
  // `caseOfficerLinkages` — case ↔ officer links this user recorded.
  createdOfficers     ImmigrationOfficer[]            @relation("OfficerCreator")
  officerObservations ImmigrationOfficerObservation[] @relation("OfficerObservationAuthor")
  caseOfficerLinkages CaseOfficerLinkage[]            @relation("CaseOfficerLinker")

  // PR-SCORECARD-1: every scorecard submission this user has made.
  // Multiple rows per user are expected (re-assessment after English
  // improvement, etc.). History is preserved.
  scorecardSubmissions ScorecardSubmission[] @relation("ScorecardUser")

  // PR-SCORECARD-2: marketing/affiliate link tracking.
  // `createdAffiliateAgents`  — agent profiles this OWNER/ADMIN created.
  // `createdTrackingLinks`    — tracking links this OWNER/ADMIN issued.
  createdAffiliateAgents AffiliateAgent[] @relation("AffiliateAgentCreator")
  createdTrackingLinks   TrackingLink[]   @relation("TrackingLinkCreator")

  // PR-AGENT-PORTAL phase 0.
  // `affiliateAgent`         — the agent this account signs in as, if it is an
  //                            agent login rather than a staff or client one.
  // `affiliateAgentsVerified` — agents whose ID/business documents this
  //                            OWNER reviewed.
  affiliateAgent          AffiliateAgent?          @relation("AffiliateAgentLogin")
  // PR-PROVIDER-PORTAL slice A — the institution this login belongs to, if any.
  educationProvider       EducationProvider?       @relation("EducationProviderLogin")
  marketingUploads        ProviderMarketingAsset[] // PR-PROVIDER-PORTAL
  affiliateAgentsVerified AffiliateAgent[]         @relation("AffiliateAgentVerifier")

  // PR-SCORECARD-4: OWNER-editable platform settings (booking URLs +
  // Wix webhook secret) and the Wix payments matched to this user by
  // email at webhook-receive time.
  platformSettingUpdates PlatformSetting[] @relation("PlatformSettingUpdater")
  wixPayments            WixPayment[]      @relation("WixPaymentUser")

  // PR-DOCUSIGN-1: LIA credential profile (1:0..1 — only LIAs get one).
  // `liaProfile` is this user's own credential row; cascade on user delete.
  // `liaProfilesVerified` are the credential rows this user (as OWNER/ADMIN)
  // has manually verified against the IAA register; SetNull on verifier
  // delete, so the array is empty for every non-OWNER/ADMIN user.
  liaProfile          LiaProfile?  @relation("LiaProfileOwner")
  liaProfilesVerified LiaProfile[] @relation("LiaProfileVerifier")

  // PR-DOCUSIGN-1 step 2: ContractSigner rows where this user IS the
  // signer (LIA, DIRECTOR, or any client-side signer who has a User
  // account at envelope-creation time). SetNull on user hard-delete:
  // the signer row survives with its snapshotted name/email as audit
  // evidence.
  contractsSigned ContractSigner[]

  // Option C step 1 — magic-link tokens issued to this user for
  // passwordless sign-in. Cascade on user delete (orphaned tokens
  // are useless).
  magicLinkTokens MagicLinkToken[]

  // Client-onboarding step — first-time "create your password" tokens
  // issued ONLY to brand-new passwordless LEADs from the public scorecard.
  // Never a reset (the set endpoint refuses if passwordHash is already
  // set). Cascade on user delete.
  passwordSetupTokens PasswordSetupToken[]
  passwordResetTokens PasswordResetToken[]

  // PR-BOOKING-1: OWNER-set weekly working hours for this user as a
  // bookable staff member. Empty for users who aren't bookable.
  staffAvailability StaffAvailability[] @relation("StaffAvailabilityStaff")

  // PR-BOOKING-ADMIN-B: leave / time-off rows for this user as staff.
  staffLeave StaffLeave[] @relation("StaffLeaveStaff")

  // PR-STAFF-HR (Phase 3): HR self-service. Admin-set job description (plain
  // text) + who/when set it; and one current employment-contract PDF per
  // staff member (replace-on-reupload). Staff read only their own.
  jobDescription        String?
  jobDescriptionSetById String?
  jobDescriptionSetAt   DateTime?
  staffContract         StaffContract? @relation("StaffContractStaff")

  // PR-WALLET (slice 1): the client's single store-credit wallet + the
  // proof-of-acceptance rows captured before a paid booking.
  wallet            Wallet?            @relation("WalletUser")
  policyAcceptances PolicyAcceptance[] @relation("PolicyAcceptanceUser")

  // PR-HANDOFF — stage handoffs this user sent / received, and their in-app
  // notifications. All SetNull/Cascade so deleting a user never blocks.
  handoffsSent     CaseHandoff[]  @relation("HandoffFrom")
  handoffsReceived CaseHandoff[]  @relation("HandoffTo")
  notifications    Notification[]

  @@map("users")
}

// ─── OPTION C AUTH — magic-link tokens (PR-OPTION-C step 1) ──────────────────
//
// One row per issued magic-link sign-in token. The TOKEN ITSELF is never
// stored — only a server-side hash of it (SHA-256 / HMAC, picked by the
// service layer). On consumption the row is marked `consumedAt = now()`
// rather than deleted so we keep a brief audit trail of which token was
// used when. The service layer rejects rows where either:
//   - consumedAt is non-null (one-time-use enforcement), or
//   - expiresAt <= now()
//
// Cascades on User delete: tokens have no value without their owner.
// Indexed by userId for the "any active token for this user?" lookup
// the rate limiter uses.

model MagicLinkToken {
  id         String    @id @default(cuid())
  userId     String
  // Lowercased target email captured at token-create time. Verify
  // checks that the email arriving on the verify URL matches this
  // field. Stored alongside userId so a future email change on the
  // User row doesn't break in-flight tokens; the authoritative user
  // lookup at verify time still uses userId (FK).
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Primary lookup at verify time: SHA-256(rawToken) → row. UNIQUE
  // because token collisions would be a security bug, not a data
  // problem. The @@index is explicit per the build contract — the
  // unique constraint already creates a usable index, so this is
  // belt-and-braces.
  @@unique([tokenHash])
  @@index([tokenHash])
  @@index([userId])
  @@map("magic_link_tokens")
}

// Client-onboarding "create your password" token — cloned from
// MagicLinkToken. Issued ONLY to brand-new passwordless LEADs created by the
// public scorecard submit; consumed once when the client sets their password.
//
// FIRST-TIME ONLY, never a reset: the set-password endpoint re-checks
// `passwordHash IS NULL` AND `role = 'LEAD'` immediately before writing, so a
// leaked/replayed token can never overwrite an account that already has a
// password (nor touch a staff account). Single-use (consumedAt), 24h TTL
// (expiresAt), scanner-safe (validate is read-only; consume happens on the
// password POST). Raw token is never stored — only sha256(raw).
model PasswordSetupToken {
  id         String    @id @default(cuid())
  userId     String
  // Lowercased target email captured at issue time; the set endpoint
  // verifies the email on the URL matches this before consuming. Stored
  // alongside userId so a later email change doesn't break in-flight tokens
  // (authoritative user lookup still uses userId FK).
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tokenHash])
  @@index([userId])
  @@map("password_setup_tokens")
}

// Phase F — staff self-service password RESET token. Same proven shape as
// PasswordSetupToken (sha256-hashed, single-use via consumedAt, short TTL),
// but a DISTINCT table on purpose: a reset overwrites an existing password on
// ANY role, which is the exact opposite of the setup token's LEAD-only /
// passwordless-only invariant. Keeping them separate means a setup token can
// never reach the reset code path and vice-versa.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  // Lowercased target email captured at issue time; the reset endpoint verifies
  // the email on the URL matches before consuming. userId FK is authoritative.
  email      String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

